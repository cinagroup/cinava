 # VBoxAcpi.cpp needs vboxaml.hex which we generate from PC/vbox.dsl
 VBoxDD_CLEAN       += \
 	$(VBoxDD_0_OUTDIR)/vboxaml.hex \
 	$(if $(VRA_WITH_TPM),$(VBoxDD_0_OUTDIR)/vboxssdt_tpm.hex,)
 PC/ACPI/VBoxAcpi.cpp_DEPS = \
 	$(VBoxDD_0_OUTDIR)/vboxaml.hex \
 	$(if $(VRA_WITH_TPM),$(VBoxDD_0_OUTDIR)/vboxssdt_tpm.hex,)

 $$(VBoxDD_0_OUTDIR)/vboxaml.hex: $(PATH_SUB_CURRENT)/PC/vbox.dsl $(VRA_RTIASL) | $$(dir $$@)
	$(call MSG_TOOL,iasl,VBoxDD,$<,$@)
	$(QUIET)$(VRA_RTIASL) --text-c-hdr AmlCode -o $@ $<

 vboxaml.hex:: $$(VBoxDD_0_OUTDIR)/vboxaml.hex

 if defined(VRA_WITH_TPM)
  $$(VBoxDD_0_OUTDIR)/vboxssdt_tpm.hex: $(PATH_SUB_CURRENT)/PC/vbox-tpm.dsl $(VRA_RTIASL) | $$(dir $$@)
	$(call MSG_TOOL,iasl,VBoxDD,$<,$@)
	$(QUIET)$(VRA_RTIASL) --text-c-hdr AmlCodeSsdtTpm -o $@ $<

  vboxssdt_tpm.hex:: $$(VBoxDD_0_OUTDIR)/vboxssdt_tpm.hex
 endif # !VRA_WITH_TPM

 PC/ACPI/VBoxAcpi.cpp_INCS = $(VBoxDD_0_OUTDIR)

 # For finding PCIInternal.h from VBox/pci.h.
 Bus/DevPCI.cpp_INCS      = Bus
 Bus/DevPciIch9.cpp_INCS  = Bus
 Bus/MsiCommon.cpp_INCS   = Bus
 Bus/MsixCommon.cpp_INCS  = Bus
 Bus/DevPciRaw.cpp_INCS   = Bus

 # For finding and generating vbetables.h (see Graphics/BIOS/Makefile.kmk).
 Graphics/DevVGA.cpp_INCS = $(VgaBiosBin_0_OUTDIR) $(VRA_GRAPHICS_INCS)
 Graphics/DevVGA.cpp_DEPS = $(VgaBiosBin_0_OUTDIR)/vbetables.h

 $(call VRA_SET_VER_INFO_DLL,VBoxDD,VirtualAgent VMM Devices and Drivers) # (last!)


 ifdef VRA_WITH_RAW_MODE
  #
  # VBoxDDRC (sysmod)
  #
  VBoxDDRC_TEMPLATE       = VBoxRc
  ifeq ($(KBUILD_TARGET_ARCH),x86)
   VBoxDDRC_DEFS.darwin   = VRA_WITH_2X_4GB_ADDR_SPACE
  endif
  VBoxDDRC_DEFS           = \
  	$(if $(VRA_WITH_HGCM),VRA_WITH_HGCM,) \
  	$(if $(VRA_WITH_IOMMU_AMD),VRA_WITH_IOMMU_AMD,) \
  	$(if $(VRA_WITH_IOMMU_INTEL),VRA_WITH_IOMMU_INTEL,)
  VBoxDDRC_INCS           = build $(VRA_GRAPHICS_INCS)
  VBoxDDRC_SOURCES        = \
  	Bus/DevPCI.cpp \
  	Bus/DevPciIch9.cpp \
  	Bus/MsiCommon.cpp \
  	Bus/MsixCommon.cpp \
  	$(if $(VRA_WITH_IOMMU_AMD),Bus/DevIommuAmd.cpp,) \
  	$(if $(VRA_WITH_IOMMU_INTEL),Bus/DevIommuIntel.cpp,) \
  	EFI/DevSmc.cpp \
  	Graphics/DevVGA.cpp \
  	Input/DevPS2.cpp \
  	Input/DevPS2K.cpp \
  	Input/DevPS2M.cpp \
  	PC/DevACPI.cpp \
  	PC/DevIoApic.cpp \
  	PC/DevPit-i8254.cpp \
  	PC/DevPIC.cpp \
  	PC/DevRTC.cpp \
  	PC/DevDMA.cpp \
  	PC/DevHPET.cpp \
  	Storage/DevATA.cpp \
  	Network/DevPCNet.cpp \
  	Network/DevDP8390.cpp \
  	Network/Dev3C501.cpp \
  	Serial/DevSerial.cpp \
  	Serial/DevOxPcie958.cpp \
  	Serial/UartCore.cpp \
  	Parallel/DevParallel.cpp \
  	VMMDev/VMMDev.cpp \
  	VMMDev/VMMDevTesting.cpp

  VBoxDDRC_DEFS         += $(VRA_AUDIO_DEFS)
  VBoxDDRC_SOURCES      += \
  	Audio/DevHda.cpp \
  	Audio/DevIchAc97.cpp

  VBoxDDRC_DEFS         += \
  	$(if $(VRA_WITH_HP_HDA),VRA_WITH_HP_HDA,) \
  	$(if $(VRA_WITH_INTEL_HDA),VRA_WITH_INTEL_HDA,) \
  	$(if $(VRA_WITH_NVIDIA_HDA),VRA_WITH_NVIDIA_HDA,)

  ifdef VRA_WITH_E1000
   VBoxDDRC_DEFS        += VRA_WITH_E1000
   VBoxDDRC_SOURCES     += \
   	Network/DevE1000.cpp \
   	Network/DevE1000Phy.cpp
  endif

  ifdef VRA_WITH_VIRTIO
   VBoxDDRC_DEFS        += VRA_WITH_VIRTIO
   VBoxDDRC_SOURCES     += \
   	VirtIO/VirtioCore.cpp \
   	Network/DevVirtioNet.cpp
  endif

  ifdef VRA_WITH_HGSMI
   VBoxDDRC_DEFS        += VRA_WITH_HGSMI
  endif
  ifdef VRA_WITH_WDDM
   VBoxDDRC_DEFS        += VRA_WITH_WDDM
  endif
  ifdef VRA_WITH_VDMA
   VBoxDDRC_DEFS        += VRA_WITH_VDMA
  endif
  ifdef VRAWDDM_WITH_VBVA
   VBoxDDRC_DEFS        += VRAWDDM_WITH_VBVA
  endif
  ifdef VRA_WITH_VMSVGA
   VBoxDDRC_DEFS         += VRA_WITH_VMSVGA
   VBoxDDRC_SOURCES      += \
   	Graphics/DevVGA-SVGA.cpp
  endif
  ifdef VRA_WITH_VMSVGA3D
   VBoxDDRC_DEFS         += VRA_WITH_VMSVGA3D
  endif

  ifdef VRA_WITH_VUSB
   VBoxDDRC_DEFS        += VRA_WITH_VUSB
   VBoxDDRC_SOURCES     += \
   	USB/DevOHCI.cpp
  endif

  ifdef VRA_WITH_USB
   VBoxDDRC_DEFS        += VRA_WITH_USB
   if defined(VRA_WITH_EHCI_IMPL)
    VBoxDDRC_DEFS       += VRA_WITH_EHCI_IMPL
    VBoxDDRC_SOURCES    += \
    	USB/DevEHCI.cpp
   endif
   if defined(VRA_WITH_XHCI_IMPL)
    VBoxDDRC_DEFS       += VRA_WITH_XHCI_IMPL
    VBoxDDRC_SOURCES    += \
    	USB/DevXHCI.cpp
   endif
  endif

  ifdef VRA_WITH_AHCI
   VBoxDDRC_DEFS        += VRA_WITH_AHCI IN_AHCI_GC
   VBoxDDRC_SOURCES     += \
   	Storage/DevAHCI.cpp
  endif

  ifdef VRA_WITH_BUSLOGIC
   VBoxDDRC_DEFS        += VRA_WITH_BUSLOGIC
   VBoxDDRC_SOURCES     += \
   	Storage/DevBusLogic.cpp
  endif

  ifdef VRA_WITH_LSILOGIC
   VBoxDDRC_DEFS        += VRA_WITH_LSILOGIC
   VBoxDDRC_SOURCES     += \
   	Storage/DevLsiLogicSCSI.cpp
  endif

  if defined(VRA_WITH_NVME_IMPL)
   VBoxDDRC_DEFS       += VRA_WITH_NVME_IMPL
   VBoxDDRC_SOURCES    += \
   	Storage/DevNVMe.cpp
  endif

  if1of ($(VRA_LDR_FMT32), pe lx)
   VBoxDDRC_LIBS          = \
   	$(PATH_STAGE_LIB)/VMMRCBuiltin$(VRA_SUFF_LIB) \
   	$(PATH_STAGE_LIB)/VMMRCImp$(VRA_SUFF_LIB)
  endif
  $(call VRA_SET_VER_INFO_RC,VBoxDDRC,VirtualAgent VMM Devices and Drivers$(COMMA) raw-mode) # last!
 endif # VRA_WITH_RAW_MODE


 #
 # VBoxDD2 (shared object)
 #
 VBoxDD2_TEMPLATE        = VBoxR3DllWarnNoPic
 VBoxDD2_DEFS            = \
 	IN_VRADD2 \
 	$(if $(VRA_WITH_PXE_ROM),VRA_WITH_PXE_ROM,) \
 	$(if $(VRA_WITH_VIRT_ARMV8),VRA_WITH_VIRT_ARMV8,)
 VBoxDD2_INCS           := \
 	build \
 	$(PATH_SUB_CURRENT)
 VBoxDD2_SOURCES         = \
 	build/VBoxDD2.cpp
 VBoxDD2_LIBS            = \
 	$(PATH_STAGE_LIB)/PcBiosBin$(VRA_SUFF_LIB) \
 	$(PATH_STAGE_LIB)/VgaBiosBin$(VRA_SUFF_LIB) \
 	$(if $(VRA_WITH_PXE_ROM), \
 		$(if $(VRA_WITH_INTEL_PXE), \
 			$(PATH_STAGE_LIB)/NetBiosBin$(VRA_SUFF_LIB), \
 			$(PATH_STAGE_LIB)/iPxeBiosBin$(VRA_SUFF_LIB)),) \
 	$(LIB_RUNTIME)
 VBoxDD2_LDFLAGS.darwin  = -install_name $(VRA_DYLD_EXECUTABLE_PATH)/VBoxDD2.dylib
 VBoxDD2_LDFLAGS.linux   = $(VRA_GCC_NO_UNDEFINED)
 if defined(VRA_WITH_EFI) && !defined(VRA_WITH_EFIFW_PACKING)
  VBoxDD_DEFS           += VRA_WITH_EFI_IN_DD2
  VBoxDD2_DEFS          += VRA_WITH_EFI
  VBoxDD2_SOURCES.x86   += EFI/DevEFI-binaries.asm
  VBoxDD2_SOURCES.amd64 += EFI/DevEFI-binaries.asm
  EFI/DevEFI-binaries.asm_ASINCS = $(PATH_STAGE)/$(INST_BIN)
  EFI/DevEFI-binaries.asm_DEPS   = \
  	$(PATH_STAGE)/$(INST_BIN)VBoxEFI-x86.fd \
  	$(PATH_STAGE)/$(INST_BIN)VBoxEFI-amd64.fd
  ifdef VRA_WITH_VIRT_ARMV8
   EFI/DevEFI-binaries.asm_DEPS   += \
   	$(PATH_STAGE)/$(INST_BIN)VBoxEFI-arm32.fd \
   	$(PATH_STAGE)/$(INST_BIN)VBoxEFI-arm64.fd
  endif

  VBoxDD2_SOURCES.arm64 += EFI/DevEFI-binaries.S
  EFI/DevEFI-binaries.S_ASINCS = $(PATH_STAGE)/$(INST_BIN)
  EFI/DevEFI-binaries.S_DEPS   = \
  	$(PATH_STAGE)/$(INST_BIN)VBoxEFI-x86.fd \
  	$(PATH_STAGE)/$(INST_BIN)VBoxEFI-amd64.fd
  ifdef VRA_WITH_VIRT_ARMV8
   EFI/DevEFI-binaries.S_DEPS   += \
   	$(PATH_STAGE)/$(INST_BIN)VBoxEFI-arm32.fd \
   	$(PATH_STAGE)/$(INST_BIN)VBoxEFI-arm64.fd
  endif
 endif

 $(call VRA_SET_VER_INFO_DLL,VBoxDD2,VirtualAgent VMM Devices and Drivers 2) # (last!)

 #
 # VBoxDDR0 (sysmod)
 #
 if "$(KBUILD_TARGET)" != "win" && $(VRA_GCC_VERSION_CXX) < 40600
  #
  # Disable "ISO C++ prohibits anonymous structs [-Werror=pedantic]" caused by Mesa VMSVGA driver headers
  # For GCC >= 4.6.0 the warning is disabled in DevVGA_SVGA.h
  #
  # Template used for gcc older than 4.6.  (Strips away compiler options.)
  #
  TEMPLATE_VBoxDDR0OldGCC         := VBoxDDR0OldGCC
  TEMPLATE_VBoxDDR0OldGCC_EXTENDS := VBoxR0
  TEMPLATE_VBoxDDR0OldGCC_CXXFLAGS = $(filter-out -pedantic,$(TEMPLATE_$(TEMPLATE_VBoxDDR0OldGCC_EXTENDS)_CXXFLAGS))

  VBoxDDR0_TEMPLATE     := VBoxDDR0OldGCC
 else
  VBoxDDR0_TEMPLATE     := VBoxR0
 endif
 VBoxDDR0_DEFS           = \
 	$(if $(VRA_WITH_HGCM),VRA_WITH_HGCM,) \
 	$(if $(VRA_WITH_IOMMU_AMD),VRA_WITH_IOMMU_AMD,) \
 	$(if $(VRA_WITH_IOMMU_INTEL),VRA_WITH_IOMMU_INTEL,) \

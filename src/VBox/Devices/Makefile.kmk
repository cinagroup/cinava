SUB_DEPTH = ../../..
include $(KBUILD_PATH)/subheader.kmk

# Make sure our Config.kmk is included.
ifndef VRA_DEVICES_CONFIG_KMK_INCLUDED
 include $(PATH_SUB_CURRENT)/Config.kmk
endif

# Include sub-makefiles.
if1of ($(KBUILD_TARGET_ARCH), $(VRA_SUPPORTED_HOST_ARCHS))
 include $(PATH_SUB_CURRENT)/testcase/Makefile.kmk
 include $(PATH_SUB_CURRENT)/Audio/testcase/Makefile.kmk
 include $(PATH_SUB_CURRENT)/Input/testcase/Makefile.kmk
 ifdef VRA_WITH_TESTCASES
  include $(PATH_SUB_CURRENT)/Samples/Makefile.kmk
 endif
 if defined(VRA_WITH_INTEL_PXE) || defined(VRA_ONLY_EXTPACKS)
  include $(PATH_SUB_CURRENT)/PC/PXE/Makefile.kmk
 else if defined(VRA_WITH_PXE_ROM)
  if !defined(VRA_WITHOUT_IPXE)
   include $(PATH_SUB_CURRENT)/PC/ipxe/Makefile.kmk
  endif
 endif
endif
if !defined(VRA_ONLY_EXTPACKS)
 if1of ($(KBUILD_TARGET_ARCH), $(VRA_SUPPORTED_HOST_ARCHS))
  include $(PATH_SUB_CURRENT)/BiosCommonCode/Makefile.kmk
  include $(PATH_SUB_CURRENT)/PC/BIOS/Makefile.kmk
  include $(PATH_SUB_CURRENT)/Graphics/BIOS/Makefile.kmk
 endif

 #
 # Main targets.
 #
 if1of ($(KBUILD_TARGET_ARCH), $(VRA_SUPPORTED_HOST_ARCHS))
  DLLS       += VBoxDDU VBoxDD VBoxDD2
  ifdef VRA_WITH_R0_MODULES
   LIBRARIES += ServicesR0
   ifndef VRA_WITH_MINIMAL_R0
    ifdef VRA_WITH_VRAR0_AS_DLL
     DLLS     += VBoxDDR0
    else
     SYSMODS  += VBoxDDR0
    endif
   endif
  endif
  ifdef VRA_WITH_RAW_MODE
   SYSMODS   += VBoxDDRC
  endif
 else
  DLLS       += VBoxDDU
 endif


 #
 # VBoxDDU (shared object)
 #
 VBoxDDU_TEMPLATE         = VBoxR3DllWarnNoPic
 VBoxDDU_NAME             = $(basename $(notdir $(LIB_DDU)))
 VBoxDDU_INST.darwin      = $(INST_DLL) $(INST_TESTCASE)
 VBoxDDU_DEFS             = IN_VRADDU
 if defined(VRA_WITH_VUSB) && "$(intersects $(KBUILD_TARGET_ARCH),$(VRA_SUPPORTED_HOST_ARCHS))" != ""
  VBoxDDU_DEFS           += VRA_WITH_VUSB
 endif
 if defined(VRA_WITH_USB) && "$(intersects $(KBUILD_TARGET_ARCH),$(VRA_SUPPORTED_HOST_ARCHS))" != ""
  VBoxDDU_DEFS           += VRA_WITH_USB IN_USBLIB
  VBoxDDU_SDKS.win        = ReorderCompilerIncs $(VRA_WINPSDK) $(VRA_WINDDK)
  if defined(VRA_WITH_EHCI_IMPL) && !defined(VRA_WITH_EXTPACK_PUEL)
   VBoxDDU_DEFS          += VRA_WITH_EHCI_IMPL
  endif
  if defined(VRA_WITH_XHCI_IMPL) && !defined(VRA_WITH_EXTPACK_PUEL)
   VBoxDDU_DEFS          += VRA_WITH_XHCI_IMPL
  endif
 else
  VBoxDDU_SDKS.win        = ReorderCompilerIncs $(VRA_WINPSDK)
 endif
 VBoxDDU_SOURCES          = \
 	Storage/VSCSI/VSCSIDevice.cpp \
 	Storage/VSCSI/VSCSILun.cpp \
 	Storage/VSCSI/VSCSILunSbc.cpp \
 	Storage/VSCSI/VSCSILunMmc.cpp \
 	Storage/VSCSI/VSCSISense.cpp \
 	Storage/VSCSI/VSCSIIoReq.cpp \
 	Storage/VSCSI/VSCSIVpdPagePool.cpp \
 	Storage/Debug.cpp \
 	build/VBoxDDUDeps.cpp

 ifdef VRA_WITH_VSCSI_SSC
  VBoxDDU_SOURCES        += Storage/VSCSI/VSCSILunSsc.cpp
  VBoxDDU_DEFS            += VRA_WITH_VSCSI_SSC
 endif
 VBoxDDU_LIBS             = \
 	$(LIB_RUNTIME) \
 	$(PATH_STAGE_LIB)/StorageLib$(VRA_SUFF_LIB)
 VBoxDDU_LIBS.freebsd    += \
 	geom
 VBoxDDU_LIBS.solaris    += \
 	efi
 if defined(VRA_WITH_USB) && "$(intersects $(KBUILD_TARGET_ARCH),$(VRA_SUPPORTED_HOST_ARCHS))" != ""
  VBoxDDU_SDKS.win       += VBoxWinNewDevLib
  VBoxDDU_LIBS           += \
  	$(PATH_STAGE_LIB)/USBLib$(VRA_SUFF_LIB)
  VBoxDDU_LIBS.win       += \
  	$(PATH_STAGE_LIB)/VBoxDrvCfgDll$(VRA_SUFF_LIB)
 endif
 VBoxDDU_LDFLAGS.darwin   = -install_name $(VRA_DYLD_EXECUTABLE_PATH)/VBoxDDU.dylib
 if defined(VRA_WITH_USB) && "$(intersects $(KBUILD_TARGET_ARCH),$(VRA_SUPPORTED_HOST_ARCHS))" != ""
  VBoxDDU_LDFLAGS.darwin += -framework IOKit
 endif

 VBoxDDU_LDFLAGS.linux    = $(VRA_GCC_NO_UNDEFINED)
 $(call VRA_SET_VER_INFO_DLL,VBoxDDU,VirtualAgent VMM Devices and Drivers Utilities)


endif # VRA_ONLY_EXTPACKS
if !defined(VRA_ONLY_EXTPACKS) && "$(intersects $(KBUILD_TARGET_ARCH),$(VRA_SUPPORTED_HOST_ARCHS))" != ""  # Goes on almost to the end of the file.


 #
 # VBoxDD (shared object)
 #
 if "$(KBUILD_TARGET)" != "win" && $(VRA_GCC_VERSION_CXX) < 40600
  #
  # Disable "ISO C++ prohibits anonymous structs [-Werror=pedantic]" caused by Mesa VMSVGA driver headers
  # For GCC >= 4.6.0 the warning is disabled in DevVGA_SVGA.h
  #
  # Template used for gcc older than 4.6.  (Strips away compiler options.)
  #
  TEMPLATE_VBoxDDOldGCC         := VBoxDDOldGCC
  TEMPLATE_VBoxDDOldGCC_EXTENDS := VBoxR3DllWarnNoPic
  TEMPLATE_VBoxDDOldGCC_CXXFLAGS = $(filter-out -pedantic,$(TEMPLATE_$(TEMPLATE_VBoxDDOldGCC_EXTENDS)_CXXFLAGS))

  VBoxDD_TEMPLATE         = VBoxDDOldGCC
 else
  VBoxDD_TEMPLATE         = VBoxR3DllWarnNoPic
 endif
 VBoxDD_SDKS.win         = ReorderCompilerIncs $(VRA_WINPSDK) $(VRA_WINDDK) VBoxNtDll
 Storage/DrvHostDVD.cpp_SDKS.win = ReorderCompilerIncs $(VRA_WINDDK)
 VBoxDD_INCS             = \
 	build \
 	$(VRA_GRAPHICS_INCS)

 VBoxDD_DEFS             = \
 	VRA_HGCM_HOST_CODE \
 	$(if $(VRA_WITH_HGCM),VRA_WITH_HGCM,) \
 	$(if $(VRA_BIOS_DMI_FALLBACK),VRA_BIOS_DMI_FALLBACK,) \
 	VRA_WITH_DMI_CHASSIS \
 	VRA_WITH_DMI_OEMSTRINGS \
 	$(if $(VRA_WITH_IOMMU_AMD),VRA_WITH_IOMMU_AMD,) \
 	$(if $(VRA_WITH_IOMMU_INTEL),VRA_WITH_IOMMU_INTEL,) \
 	$(if $(VRA_WITH_INTNET_SERVICE_IN_R3),VRA_WITH_INTNET_SERVICE_IN_R3,)
 ifeq ($(KBUILD_TARGET_ARCH),x86)
  VBoxDD_DEFS.darwin     = VRA_WITH_2X_4GB_ADDR_SPACE
 endif
 VBoxDD_SOURCES          = \
 	build/VBoxDD.cpp \
 	\
 	Input/DevPS2.cpp \
 	Input/DevPS2K.cpp \
 	Input/DevPS2M.cpp \
 	Input/UsbKbd.cpp \
 	Input/UsbMouse.cpp \
 	Bus/DevPCI.cpp \
 	Bus/DevPciIch9.cpp \
 	Bus/MsiCommon.cpp \
 	Bus/MsixCommon.cpp \
 	$(if $(VRA_WITH_IOMMU_AMD),Bus/DevIommuAmd.cpp,) \
 	$(if $(VRA_WITH_IOMMU_INTEL),Bus/DevIommuIntel.cpp,) \
 	EFI/DevSmc.cpp \
 	EFI/DevFlash.cpp \
 	EFI/FlashCore.cpp \
 	Graphics/DevVGA.cpp \
 	Storage/DevATA.cpp \
 	PC/DevPit-i8254.cpp \
 	PC/DevPIC.cpp \
 	PC/DevACPI.cpp \
 	PC/ACPI/VBoxAcpi.cpp \
 	PC/DevRTC.cpp \
 	PC/DevPcBios.cpp \
 	PC/DevFwCommon.cpp \
 	PC/DevPcArch.cpp \
 	PC/DevQemuFwCfg.cpp \
 	PC/DevLpc.cpp \
 	GIMDev/GIMDev.cpp \
 	GIMDev/DrvUDP.cpp \
 	VMMDev/VMMDev.cpp \
 	$(if $(VRA_WITH_HGCM),VMMDev/VMMDevHGCM.cpp,) \
 	VMMDev/VMMDevTesting.cpp \
 	Network/DevPCNet.cpp \
 	Network/DevDP8390.cpp \
 	Network/Dev3C501.cpp \
 	Network/UsbNet.cpp \
 	PC/DevDMA.cpp \
 	PC/DevHPET.cpp \
 	PC/DevIoApic.cpp \
 	Storage/DevFdc.cpp \
 	Parallel/DevParallel.cpp \
 	\
 	Input/DrvKeyboardQueue.cpp \
 	Input/DrvMouseQueue.cpp \
 	Network/DrvIntNet.cpp \
 	Network/DrvDedicatedNic.cpp \
 	PC/DrvACPI.cpp \
 	PC/DrvAcpiCpu.cpp \
 	Serial/DevSerial.cpp \
 	Serial/DevOxPcie958.cpp \
 	Serial/UartCore.cpp \
 	Serial/DrvChar.cpp \
 	Serial/DrvHostSerial.cpp \
 	Serial/DrvNamedPipe.cpp \
 	Serial/DrvTCP.cpp \
 	Serial/DrvRawFile.cpp \
 	Storage/Debug.cpp \
 	Storage/DrvVD.cpp \
 	Storage/ATAPIPassthrough.cpp \
 	Storage/IOBufMgmt.cpp \
 	Network/DrvNetSniffer.cpp \
 	Network/Pcap.cpp \
 	Trace/DrvIfsTrace.cpp \
 	Trace/DrvIfsTrace-serial.cpp \
 	Trace/DrvIfsTrace-tpm.cpp
 ifn1of ($(KBUILD_TARGET), os2)
  VBoxDD_SOURCES += Storage/DrvHostBase.cpp
 endif
 ifn1of ($(KBUILD_TARGET), os2)
  VBoxDD_SOURCES += Storage/DrvHostDVD.cpp
 endif
 ifn1of ($(KBUILD_TARGET), darwin freebsd os2 solaris)
  VBoxDD_SOURCES += Storage/DrvHostFloppy.cpp
 endif


 ifn1of ($(KBUILD_TARGET), darwin)
  VBoxDD_SOURCES += Storage/HBDMgmt-generic.cpp
 endif

 VBoxDD_SOURCES.darwin += \
 	Storage/HBDMgmt-darwin.cpp \
 	Storage/DrvHostBase-darwin.cpp

 VBoxDD_SOURCES.freebsd += \
 	Storage/DrvHostBase-freebsd.cpp

 VBoxDD_SOURCES.linux += \
 	Storage/DrvHostBase-linux.cpp

 VBoxDD_SOURCES.solaris += \
 	Storage/DrvHostBase-solaris.cpp

 VBoxDD_SOURCES.win += \
 	Storage/DrvHostBase-win.cpp

 #VBoxDD_SOURCES.win += Storage/HBDMgmt-win.cpp #Disabled until remaining issues are sorted out

 VBoxDD_LIBS             = # more later.
 VBoxDD_LDFLAGS.darwin   = -install_name $(VRA_DYLD_EXECUTABLE_PATH)/VBoxDD.dylib \
 	-framework CoreAudio \
 	-framework AudioUnit \
 	-framework AudioToolbox \
 	-framework IOKit \
 	-framework Carbon \
 	-framework DiskArbitration \
 	-framework SystemConfiguration \
 	-framework AVFoundation \
 	-framework Foundation
 VBoxDD_LDFLAGS.linux    = $(VRA_GCC_NO_UNDEFINED)

 # --- Tracing bits. ---

 ifdef VRA_WITH_DTRACE_R3
  VBoxDD_DEFS           += VRA_WITH_DTRACE
  VBoxDD_USES           += dtrace
  VBoxDD_SOURCES        += build/VBoxDD.d
 endif

 # --- Graphics bits. ---

 ifdef VRAWDDM_TEST_UHGSMI
  VBoxDD_DEFS           += VRAWDDM_TEST_UHGSMI
 endif
 ifdef VRAWDDM_WITH_VBVA
  VBoxDD_DEFS           += VRAWDDM_WITH_VBVA
 endif

 ifdef VRA_WITH_HGSMI
  VBoxDD_DEFS           += VRA_WITH_HGSMI
  VBoxDD_SOURCES        += \
  	Graphics/DevVGA_VBVA.cpp \
  	Graphics/HGSMI/HGSMIHost.cpp
  VBoxDD_LIBS           += \
  	$(PATH_STAGE_LIB)/HGSMIHostR3Lib$(VRA_SUFF_LIB)
 endif

 # HACK ALERT! Code no longer builds without VRA_WITH_WDDM, so while it's temporairly
 # disabled on win.arm64 we keep pretending it is still enabled here. >-----vvvvvvvvv
 if defined(VRA_WITH_WDDM) || "$(KBUILD_TARGET).$(KBUILD_TARGET_ARCH)" == "win.arm64"
  VBoxDD_DEFS           += VRA_WITH_WDDM
  VBoxDD_SOURCES        += \
  	Graphics/HGSMI/SHGSMIHost.cpp
 endif

 ifdef VRA_WITH_VMSVGA
  VBoxDD_DEFS           += VRA_WITH_VMSVGA
  VBoxDD_INCS           += $(VRA_PATH_VMSVGA_DEVICE_INC)
  VBoxDD_SOURCES        += \
  	Graphics/DevVGA-SVGA.cpp \
  	Graphics/DevVGA-SVGA-cmd.cpp
 endif
 ifdef VRA_WITH_VMSVGA3D
  if1of ($(KBUILD_TARGET), linux win)
   # Dynamically load 3D library (opengl32, libGL).
   # This is a temporary solution. In future the 3D backend will be in a separate library.
   VRA_WITH_VMSVGA3D_DYNAMIC_LOAD = 1
  endif
  VBoxDD_DEFS           += VRA_WITH_VMSVGA3D
  VBoxDD_SOURCES        += \
  	Graphics/DevVGA-SVGA3d.cpp \
  	Graphics/DevVGA-SVGA3d-hlp.cpp \
  	Graphics/DevVGA-SVGA3d-info.cpp \
  	Graphics/DevVGA-SVGA3d-shared.cpp \
  	Graphics/DevVGA-SVGA3d-savedstate.cpp
  ifdef VRA_WITH_VMSVGA3D_DX
   VBoxDD_DEFS          += VMSVGA3D_DX
   VBoxDD_DEFS          += \
   	$(if $(VRA_WITH_DXVK),VRA_WITH_DXVK,) \
   	$(if $(VRA_WITH_DXMT),VRA_WITH_DXMT,)
   VBoxDD_SOURCES       += \
   	Graphics/DevVGA-SVGA3d-dx.cpp \
   	Graphics/DevVGA-SVGA3d-dx-savedstate.cpp \
   	Graphics/DevVGA-SVGA3d-dx-shader.cpp
   if "$(KBUILD_TARGET)" == "win" || defined(VRA_WITH_DXVK) || defined(VRA_WITH_DXMT)
    VBoxDD_SDKS.linux   += VBoxDxVk
    ifdef VRA_WITH_DXMT
     VBoxDD_SDKS.darwin  += VBoxDxMt
    else
     VBoxDD_SDKS.darwin  += VBoxDxVk
    endif
    # DXVK is not used on Windows however VRA_WITH_DXVK can be enabled for development purposes
    VBoxDD_SDKS.win     += $(if $(VRA_WITH_DXVK),VBoxDxVk,)
    VBoxDD_DEFS         += VMSVGA3D_DX_BACKEND
    VBoxDD_SOURCES      += \
    	Graphics/DevVGA-SVGA3d-dx-dx11.cpp
    ifdef VRA_WITH_DXVK
     # @todo This is probably not the nicest way to do this...
     VBoxDD_POST_CMDS.darwin  += \
     	$(INSTALL) -m 0644 $(lastword $(sort $(wildcard $(KBUILD_DEVTOOLS_TRG)/moltenvk/v*)))/libMoltenVK.dylib $(PATH_STAGE_BIN)/libMoltenVK.dylib
    endif

    # mac2 clang is too old to know the -Wclass-conversion switch in the ignore pragma it seems.
    Graphics/DevVGA-SVGA3d-dx-dx11.cpp_CXXFLAGS.darwin += -Wno-error
   endif
  endif
  VBoxDD_SOURCES       += \
  	Graphics/svgadump/svga_dump.c
  if "$(KBUILD_TARGET)" == "win" && !defined(VRA_WITH_VMSVGA3D_USE_OPENGL)
   VBoxDD_DEFS           += VMSVGA3D_DIRECT3D
   VBoxDD_SOURCES        += \
   	Graphics/DevVGA-SVGA3d-win.cpp \
   	Graphics/DevVGA-SVGA3d-win-d3d9.cpp
   VBoxDD_LIBS.win       += d3d9.lib $(PATH_TOOL_$(VRA_VCC_TOOL)_LIB)/delayimp.lib
   VBoxDD_LDFLAGS.win    += /DELAYLOAD:d3d9.dll
  else
   VBoxDD_DEFS          += VMSVGA3D_OPENGL
   VBoxDD_SOURCES       += \
   	Graphics/DevVGA-SVGA3d-ogl.cpp \
   	Graphics/DevVGA-SVGA3d-glHlp.cpp \
   	$(VBoxDD_0_OUTDIR)/VBoxSVGA3DLazyLoad.asm
   VBoxDD_SOURCES.darwin += \
   	$(VBoxDD_0_OUTDIR)/VBoxSVGA3DObjCLazyLoad.asm
   VBoxDD_CLEAN         += $(VBoxDD_0_OUTDIR)/VBoxSVGA3DLazyLoad.asm
   $$(VBoxDD_0_OUTDIR)/VBoxSVGA3DLazyLoad.asm: $(PATH_SUB_CURRENT)/Graphics/VBoxSVGA3D.def $(VRA_DEF_2_LAZY_LOAD) | $$(dir $$@)
	$(call MSG_TOOL,VBoxDef2LazyLoad,VBoxDD,$(filter %.def, $^),$@)
	$(QUIET)$(RM) -f -- "$@"
	$(VRA_DEF_2_LAZY_LOAD) --explicit-load-function --library VBoxSVGA3D --output "$@" $(filter %.def, $^)
   $$(VBoxDD_0_OUTDIR)/VBoxSVGA3DObjCLazyLoad.asm: $(PATH_SUB_CURRENT)/Graphics/VBoxSVGA3DObjC.def $(VRA_DEF_2_LAZY_LOAD) | $$(dir $$@)
	$(call MSG_TOOL,VBoxDef2LazyLoad,VBoxDD,$(filter %.def, $^),$@)
	$(QUIET)$(RM) -f -- "$@"
	$(VRA_DEF_2_LAZY_LOAD) --explicit-load-function --library VBoxSVGA3DObjC --output "$@" $(filter %.def, $^)

   ifdef VRA_WITH_VMSVGA3D_DYNAMIC_LOAD
    VBoxDD_DEFS         += VMSVGA3D_DYNAMIC_LOAD
    VBoxDD_SOURCES      += \
    	Graphics/DevVGA-SVGA3d-glLdr.cpp
   else
    VBoxDD_LIBS.linux   += X11 GL
    VBoxDD_LIBS.win     += $(PATH_SDK_$(VRA_WINPSDK)_LIB)/Opengl32.lib
   endif
   VBoxDD_LDFLAGS.darwin += -framework OpenGL
   VBoxDD_DEFS.darwin    += VRA_VMSVGA3D_DUAL_OPENGL_PROFILE
   if 0 # Use the OpenGL 3.2 Core profile (see also VBoxSVGA3D_DEFS.darwin and VBoxSVGA3DObjC_DEFS.darwin).
    VBoxDD_DEFS.darwin   += VRA_VMSVGA3D_DEFAULT_OGL_PROFILE=3.2 VRA_VMSVGA3D_OTHER_OGL_PROFILE=2.1
   else
    VBoxDD_DEFS.darwin   += VRA_VMSVGA3D_DEFAULT_OGL_PROFILE=2.1 VRA_VMSVGA3D_OTHER_OGL_PROFILE=3.2
   endif
  endif
  if1of ($(VRA_DEF_MACOSX_VERSION_MIN), 10.6 10.5 10.4)
   Graphics/DevVGA-SVGA3d.cpp_CXXFLAGS.darwin            = -F$(VRA_PATH_MACOSX_SDK_10_7)/System/Library/Frameworks/
   Graphics/DevVGA-SVGA3d-info.cpp_CXXFLAGS.darwin       = -F$(VRA_PATH_MACOSX_SDK_10_7)/System/Library/Frameworks/
   Graphics/DevVGA-SVGA3d-shared.cpp_CXXFLAGS.darwin     = -F$(VRA_PATH_MACOSX_SDK_10_7)/System/Library/Frameworks/
   Graphics/DevVGA-SVGA3d-savedstate.cpp_CXXFLAGS.darwin = -F$(VRA_PATH_MACOSX_SDK_10_7)/System/Library/Frameworks/
   Graphics/DevVGA-SVGA3d-ogl.cpp_CXXFLAGS.darwin        = -F$(VRA_PATH_MACOSX_SDK_10_7)/System/Library/Frameworks/
  else if1of ($(VRA_DEF_MACOSX_VERSION_MIN), 10.14 10.15 10.16 11.0)
   Graphics/DevVGA-SVGA3d-ogl.cpp_CXXFLAGS.darwin        = $(VRA_GCC_Wno-deprecated-declarations)
  endif
 endif

 # HACK ALERT! Code no longer builds without VRA_WITH_VDMA, so while it's temporairly
 # disabled on win.arm64 we keep pretending it is still enabled here. >-----vvvvvvvvv
 if defined(VRA_WITH_VDMA) || "$(KBUILD_TARGET).$(KBUILD_TARGET_ARCH)" == "win.arm64"
  VBoxDD_DEFS           += VRA_WITH_VDMA
  VBoxDD_SOURCES        += \
  	Graphics/DevVGA_VDMA.cpp
 endif

 ifdef VRA_WITH_PXE_ROM
  VBoxDD_DEFS           += VRA_WITH_PXE_ROM
 endif

 # --- USB bits. ---

 ifdef VRA_WITH_USB
  VBoxDD_DEFS           += VRA_WITH_USB
  VBoxDD_SOURCES        += \
  	USB/vrdp/USBProxyDevice-vrdp.cpp \
  	USB/usbip/USBProxyDevice-usbip.cpp

  VBoxDD_DEFS.darwin    += VUSB_HAVE_USBPROXY_DEVICE
  VBoxDD_SOURCES.darwin += \
  	USB/USBProxyDevice.cpp \
  	USB/darwin/USBProxyDevice-darwin.cpp
  #  if1of ($(VRA_DEF_MACOSX_VERSION_MIN), 10.9)	# Hack, shouldn't be needed
  #   USB/darwin/USBProxyDevice-darwin.cpp_SDKS = MACOSX1010
  #  endif

  VBoxDD_DEFS.linux     += \
  	VUSB_HAVE_USBPROXY_DEVICE \
  	$(if $(VRA_WITH_LINUX_COMPILER_H),VRA_WITH_LINUX_COMPILER_H,) \
  	$(if $(VRA_USB_WITH_SYSFS),VRA_USB_WITH_SYSFS,)
  VBoxDD_SOURCES.linux  += \
  	USB/USBProxyDevice.cpp \
  	USB/linux/USBProxyDevice-linux.cpp

  VBoxDD_DEFS.os2       += VUSB_HAVE_USBPROXY_DEVICE
  VBoxDD_INCS.os2       += $(PATH_ROOT)/src/VBox/HostDrivers/VBoxUSB/os2
  VBoxDD_SOURCES.os2    += \
  	USB/USBProxyDevice.cpp \
  	USB/os2/USBProxyDevice-os2.cpp

  VBoxDD_DEFS.win       += VUSB_HAVE_USBPROXY_DEVICE
  VBoxDD_SOURCES.win    += \
  	USB/USBProxyDevice.cpp \
  	USB/win/USBProxyDevice-win.cpp

  VBoxDD_DEFS.solaris   += VUSB_HAVE_USBPROXY_DEVICE
  VBoxDD_SOURCES.solaris += \
  	USB/USBProxyDevice.cpp \
  	USB/solaris/USBProxyDevice-solaris.cpp

  VBoxDD_DEFS.freebsd   += VUSB_HAVE_USBPROXY_DEVICE
  VBoxDD_SOURCES.freebsd += \
  	USB/USBProxyDevice.cpp \
  	USB/freebsd/USBProxyDevice-freebsd.cpp

  ifdef VRA_WITH_SCSI
   VBoxDD_SOURCES       += \
   	Storage/UsbMsd.cpp
  endif

  if defined(VRA_WITH_EHCI_IMPL)
   VBoxDD_DEFS          += VRA_WITH_EHCI_IMPL
   VBoxDD_SOURCES       += \
   	USB/DevEHCI.cpp
  endif

  if defined(VRA_WITH_XHCI_IMPL)
   VBoxDD_DEFS          += VRA_WITH_XHCI_IMPL
   VBoxDD_SOURCES       += \
   	USB/DevXHCI.cpp
  endif

  if defined(VRA_WITH_USB_VIDEO_IMPL)
   VBoxDD_DEFS          += VRA_WITH_USB_VIDEO_IMPL
   VBoxDD_INCS += \
   	$(VRA_JPEG_INCS)
   VBoxDD_SOURCES       += \
   	Video/UsbWebcam.cpp \
   	Video/UsbWebcamDesc.cpp \
   	Video/jpggen.cpp \
   	Video/DrvHostWebcam.cpp \
   	Video/JPEGEnc.cpp
   VBoxDD_SOURCES.darwin += \
   	Video/HostWebcam-darwin.mm
   VBoxDD_SOURCES.linux += \
   	Video/HostWebcam-v4l2.cpp
   VBoxDD_SOURCES.solaris += \
   	Video/HostWebcam-v4l2.cpp
   VBoxDD_SOURCES.win += \
   	Video/HostWebcam-win.cpp
   VBoxDD_LIBS += \
   	$(PATH_STAGE_LIB)/VBox-libjpeg$(VRA_SUFF_LIB) \
   	$(PATH_STAGE_LIB)/VBox-libjpeg12$(VRA_SUFF_LIB) \
   	$(PATH_STAGE_LIB)/VBox-libjpeg16$(VRA_SUFF_LIB)
   VBoxDD_LIBS.win += \
   	strmiids.lib
   VBoxDD_LDFLAGS.darwin += \
   	-framework AVFoundation \
   	-framework CoreFoundation \
   	-framework ApplicationServices \
   	-framework CoreMedia \
   	-framework CoreVideo \
   	-framework Foundation
  endif

  if defined(VRA_WITH_USB_CARDREADER)
   VBoxDD_DEFS    += VRA_WITH_USB_CARDREADER
   VBoxDD_SOURCES += \
   	Security/UsbCardReader.cpp \
   	Security/CardReaderDebug.cpp

   # @todo Use the lazy loader to dynamically load the PCSC library
   #       and define the necessary interface bits ourselves to avoid
   #       relying on the PCSC SDK.
   if defined(VRA_WITH_USB_CARDREADER_TEST)

    VBoxDD_DEFS    += VRA_WITH_USB_CARDREADER_TEST
    VBoxDD_SOURCES += Security/DrvDirectCardReader2.cpp

    if1of ($(KBUILD_TARGET), linux)
     # PCSC framework on darwin isn't available, so I've used custom build at least for Unix compilation test
     PCSC_sdk ?= /usr
     VBoxDD_INCS.linux += $(PCSC_sdk)/include/PCSC
    endif

    VBoxDD_LDFLAGS.darwin += -L/usr/local/lib
    VBoxDD_LDFLAGS.linux += -L$(PCSC_sdk)/lib
    VBoxDD_LIBS.win += Winscard.lib
    ifn1of ($(KBUILD_TARGET), win)
     VBoxDD_LIBS += pcsclite
    endif
   endif
  endif

 endif # VRA_WITH_USB


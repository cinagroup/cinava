 if defined(VRA_WITH_CLOUD_NET) && defined(VRA_WITH_LIBSSH)
  VBoxDD_SDKS           += VBoxLibSsh VBoxZlib VBoxOpenSsl
  VBoxDD_DEFS           += VRA_WITH_CLOUD_NET
  VBoxDD_SOURCES        += \
  	Network/DrvCloudTunnel.cpp

  VBoxDD_SOURCES       += \
  	$(VBoxDD_0_OUTDIR)/VBoxLibSshLazyLoad.asm
  VBoxDD_CLEAN         += $(VBoxDD_0_OUTDIR)/VBoxLibSshLazyLoad.asm
  $$(VBoxDD_0_OUTDIR)/VBoxLibSshLazyLoad.asm: $(PATH_SUB_CURRENT)/Network/VBoxLibSsh.def $(VRA_DEF_2_LAZY_LOAD) | $$(dir $$@)
	$(call MSG_TOOL,VBoxDef2LazyLoad,VBoxDD,$(filter %.def, $^),$@)
	$(QUIET)$(RM) -f -- "$@"
	$(VRA_DEF_2_LAZY_LOAD) --explicit-load-function --library VBoxLibSsh --output "$@" $(filter %.def, $^)
 endif


 if defined(VRA_WITH_R0_MODULES) && !defined(VRA_WITH_MINIMAL_R0)
  $(call VRA_SET_VER_INFO_R0,VBoxDDR0,VirtualAgent VMM Devices and Drivers$(COMMA) ring-0) # (last!)

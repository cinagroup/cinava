  VBoxDD_DEFS           += VRA_WITH_VUSB
  VBoxDD_SOURCES        += \
  	USB/DevOHCI.cpp \
  	USB/DrvVUSBRootHub.cpp \
  	USB/VUSBDevice.cpp \
  	USB/VUSBSniffer.cpp \
  	USB/VUSBSnifferPcapNg.cpp \
  	USB/VUSBSnifferUsbMon.cpp \
  	USB/VUSBSnifferVmx.cpp \
  	USB/VUSBUrb.cpp \

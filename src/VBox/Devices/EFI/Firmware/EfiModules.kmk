ifndef VRA_EFI_FIRMWARE_EFI_MODULES_KMK_INCLUDED
 VRA_EFI_FIRMWARE_EFI_MODULES_KMK_INCLUDED = 1

 #
 # The name of the subdirectory which the .pdb, .efi and other output files ends
 # up in, apparently.  In the generated makefiles, DEBUG_DIR points to them.
 #
 if 0 #1of ($(VRA_EFI_TOOL_CHAIN.x86), VS2017 VS2019 VS2022)
  VRA_EFI_DEBUG_DIR.x86 = OUTPUT
 else
  VRA_EFI_DEBUG_DIR.x86 = DEBUG
 endif
 if 0 #1of ($(VRA_EFI_TOOL_CHAIN.amd64), VS2017 VS2019 VS2022)
  VRA_EFI_DEBUG_DIR.amd64 = OUTPUT
 else
  VRA_EFI_DEBUG_DIR.amd64 = DEBUG
 endif
 if 0 #of ($(VRA_EFI_TOOL_CHAIN.arm32), VS2017 VS2019 VS2022 CLANGPDB)
  VRA_EFI_DEBUG_DIR.arm32 = OUTPUT
 else
  VRA_EFI_DEBUG_DIR.arm32 = DEBUG
 endif
 if 0 #of ($(VRA_EFI_TOOL_CHAIN.arm64), VS2017 VS2019 VS2022 CLANGPDB)
  VRA_EFI_DEBUG_DIR.arm64 = OUTPUT
 else
  VRA_EFI_DEBUG_DIR.arm64 = DEBUG
 endif

 #
 # List of modules that ends up producing .efi, .debug and .pdb files.
 #

SUB_DEPTH = ../../../..
include $(KBUILD_PATH)/subheader.kmk

ifneq ($(KBUILD_HOST),win)
 $(error "The Windows installer can only be built on Windows!")
endif


#
# Include Sub-Makefiles.
#
include $(PATH_SUB_CURRENT)/InstallHelper/Makefile.kmk

include $(PATH_SUB_CURRENT)/Stub/Makefile.kmk
include $(PATH_SUB_CURRENT)/StubBld/Makefile.kmk
include $(PATH_SUB_CURRENT)/Resources/Makefile.kmk
ifdef VRA_WITH_MSI_HACK
 include $(PATH_SUB_CURRENT)/MsiHack/Makefile.kmk
endif

#
# Profile for quickly testing the actual mechanisms of our installer.
# This leaves out most of the optional stuff to make compilation / linking much
# faster for development cycles. Tweak to your likings if needed.
#
# Note! Rather hacky approach -- this *only* works when 'packing' is executed
#       directly in the VBox\Installer directory; otherwise with WILL break the
#       build mostly likely, as we mess with dependencies between components.
#
#       A better appraoch would be to define separate packing defines for dependencies
#       to decouple the building process from the packing more in such a scenario.
#
#       Use with care!
#
ifdef VRA_INSTALLER_QUICK
 VRA_INSTALLER_LANGUAGES       := en_US de_DE
 VRA_WITH_LICENSE_DISPLAY      :=
 VRA_WITH_SERIALNUMBER_INSTALL :=
 VRA_WITH_ADDITIONS_PACKING    :=
 VRA_WITH_DEBUGGER_GUI         :=
 VRA_WITH_EFIFW_PACKING        :=
 VRA_WITH_EXTPACK              :=
 VRA_WITH_NETADP               :=
 VRA_WITH_NETFLT               :=
 VRA_WITH_PYTHON               :=
 VRA_WITH_WEBSERVICES          :=
 VRA_WITH_UNATTENDED           :=
 VRA_WITH_DOCS_PACKING         :=
 VRA_WITH_QTGUI                :=
 VRA_WITH_USB                  := 1
 VRA_WITH_VRA_IMG             :=
 VRA_WITH_VRASDL              :=
 VRA_CAB_COMPRESSION_LEVEL     := none
endif

# Make sure that we show the license page in non-OSE release builds.
if !defined(VRA_OSE) && defined(VRA_RELEASE_EXACT_MATCH) && !defined(VRA_WITH_LICENSE_DISPLAY)
 $(error In release mode the non-OSE installer must be built with license agreement being displayed!)
endif

#
# Globals.
#
# Tip: Use VRA_CAB_COMPRESSION_LEVEL=none on the kmk command line when working
#      on the installer.
#
VRA_WIN_INST_MAKEFILE_DEP := $(MAKEFILE_CURRENT)
ifndef VRA_CAB_COMPRESSION_LEVEL
 VRA_CAB_COMPRESSION_LEVEL := high
endif

VRA_PATH_WIN_INST_SRC     := $(PATH_SUB_CURRENT)
VRA_WIN_INST_OUT_DIR      := $(PATH_TARGET)/Installer/win
VRA_WIN_INST_REPACK_DIR   := $(PATH_OUT)/repack

# Translate our architecture names to MSI platform/arch.
VRA_INS_PROD_ARCH.amd64 = x64
VRA_INS_PROD_ARCH.arm64 = Arm64
VRA_INS_PROD_ARCH.x86   = Intel
VRA_INS_PROD_ARCH := $(VRA_INS_PROD_ARCH.$(KBUILD_TARGET_ARCH))
ifeq ($(VRA_INS_PROD_ARCH),)
 $(error VRA_INS_PROD_ARCH is empty!)
endif

# Note: en_US *must* come first for the dependency file generation.
ifndef VRA_INSTALLER_LANGUAGES
 VRA_INSTALLER_LANGUAGES   = en_US de_DE ru_RU el_GR fr_FR it_IT tr_TR zh_TW zh_CN sv_SE hu_HU id_ID
 VRA_INSTALLER_LANGUAGES  += $(VRA_INSTALLER_ADD_LANGUAGES)
endif

# Aliases for VRA_SIGN_FILE_FN that allows better control of the MSI and MSM signing.
VRA_SIGN_MSI_FN ?= $(VRA_SIGN_FILE_FN)
VRA_SIGN_MSM_FN ?= $(VRA_SIGN_FILE_FN)
VRA_SIGN_CAB_FN ?= $(VRA_SIGN_FILE_FN)

#
# List of merge modules to use.
#
ifndef VRA_INSTALLER_MERGE_MODULES
 VRA_INSTALLER_MERGE_MODULES = App
 ifdef VRA_WITH_NETADP
  VRA_INSTALLER_MERGE_MODULES += NetAdp6
 endif
 ifdef VRA_WITH_NETFLT
  VRA_INSTALLER_MERGE_MODULES += NetLwf
 endif
 ifdef VRA_WITH_USB
  VRA_INSTALLER_MERGE_MODULES += USB
 endif
 ifdef VRA_WITH_PYTHON
  VRA_INSTALLER_MERGE_MODULES += Python
 endif
endif
ifeq ($(KBUILD_TARGET_ARCH),amd64)
 VRA_INSTALLER_MERGE_MODULES += COM32On64
endif

# We only ship the merge modules in locale en_US for the moment.
ifdef VRA_WITH_MSM_INSTALL
 VRA_INSTALLER_LANGUAGES := en_US
 VRA_INSTALLER_MERGE_LANGUAGES = $(VRA_INSTALLER_LANGUAGES)
endif

#
# Language IDs (LCID, decimal)
#
VRA_BRAND_en_US_LANG_ID ?= 1033
VRA_BRAND_de_DE_LANG_ID ?= 1031
VRA_BRAND_ru_RU_LANG_ID ?= 1049
VRA_BRAND_el_GR_LANG_ID ?= 1032
VRA_BRAND_fa_IR_LANG_ID ?= 1065
VRA_BRAND_fr_FR_LANG_ID ?= 1036
VRA_BRAND_it_IT_LANG_ID ?= 1040
VRA_BRAND_tr_TR_LANG_ID ?= 1055
VRA_BRAND_zh_TW_LANG_ID ?= 1028
VRA_BRAND_zh_CN_LANG_ID ?= 2052
VRA_BRAND_sv_SE_LANG_ID ?= 1053
VRA_BRAND_hu_HU_LANG_ID ?= 1038
VRA_BRAND_id_ID_LANG_ID ?= 1057

# Standard language names (in the native language), to be extended as we go.
# VRA_BRAND_$(lang)_LANG_NAME must be defined for each language which occurs
# in either VRA_LICENSE_ADD_LANGUAGES or VRA_MANUAL_ADD_LANGUAGES.
VRA_BRAND_en_US_LANG_NAME := English
VRA_BRAND_de_DE_LANG_NAME := Deutsch
VRA_BRAND_el_GR_LANG_NAME := Ελληνικά
VRA_BRAND_fr_FR_LANG_NAME := Français
VRA_BRAND_it_IT_LANG_NAME := Italiano
VRA_BRAND_tr_TR_LANG_NAME := Türkçe
VRA_BRAND_zh_TW_LANG_NAME := 正體中文
VRA_BRAND_zh_CN_LANG_NAME := 简体中文


#
# We don't have the license text in another language than English yet,
# so just define the branding targets to use the English one for now.
# The installer generation assumes that there is a translation for each
# of VRA_INSTALLER_LANGUAGES.
#
$(foreach lang,$(VRA_INSTALLER_LANGUAGES), \
	$(eval VRA_BRAND_$(lang)_LICENSE_RTF := $(VRA_BRAND_LICENSE_RTF)))

#
# Set the codepage for all languages to 1252, covers most cases.
#
$(foreach lang,$(sort $(VRA_INSTALLER_LANGUAGES) $(VRA_LICENSE_ADD_LANGUAGES) $(VRA_MANUAL_ADD_LANGUAGES)), \
	$(eval VRA_BRAND_$(lang)_LANGUAGE_CODEPAGE := 1252))
# Exceptions:
VRA_BRAND_el_GR_LANGUAGE_CODEPAGE := 1253
VRA_BRAND_fa_IR_LANGUAGE_CODEPAGE := 1256
VRA_BRAND_tr_TR_LANGUAGE_CODEPAGE := 1254
VRA_BRAND_zh_TW_LANGUAGE_CODEPAGE := 950
VRA_BRAND_zh_CN_LANGUAGE_CODEPAGE := 936

#
# If we want to build a combined package, we separate all common stuff
# (that is all 100% identical content between 32-/64-bit builds)
# into an own .cab file to save space. This .cab file then gets included
# and used by the 32-/64-bit installers.
#
ifdef VRA_WITH_COMBINED_PACKAGE
 VRA_INSTALLER_COMMON_DISKID  := 2
else
 VRA_INSTALLER_COMMON_DISKID  := 1
endif

## @todo VRA_ prefixes!
PACKAGE_BASE                := VirtualAgent-$(VRA_VERSION_STRING)
PACKAGE_NAME_LANG           := $(PACKAGE_BASE)-r$(VRA_SVN_REV)
PACKAGE_NAME_FINAL          := $(PATH_STAGE_BIN)/$(PACKAGE_NAME_LANG).msi

ifdef VRA_WITH_COMBINED_PACKAGE
 PATH_MULTIARCH_TEMP                := $(PATH_OUT_BASE)/win.amd64/$(KBUILD_TYPE)/obj/Installer
 PATH_MULTIARCH_GUEST_ADDITIONS_ISO := $(PATH_OUT_BASE)/win.amd64/$(KBUILD_TYPE)/bin/additions
 PACKAGE_NAME_MULTIARCH             := $(PACKAGE_NAME_LANG)-MultiArch
 PACKAGE_NAME_MULTIARCH.amd64       := $(PACKAGE_NAME_MULTIARCH)_amd64.msi
 PACKAGE_NAME_MULTIARCH.arm64       := $(PACKAGE_NAME_MULTIARCH)_arm64.msi
 PACKAGE_NAME_FINAL                 := $(PATH_MULTIARCH_TEMP)/$(PACKAGE_NAME_MULTIARCH.$(KBUILD_TARGET_ARCH))
 PACKAGE_NAME_MULTIARCH_FINAL       := $(PACKAGE_NAME_MULTIARCH).exe
 # Always take the common.cab from the amd64 build, as it
 # might contain certain files for x86 compatibility such
 # as our 32-on-64-bit COM stuff.
 PACKAGE_NAME_MULTIARCH_COMMONCAB   := $(PATH_OUT_BASE)/win.amd64/$(KBUILD_TYPE)/obj/Installer/win/common.cab

 BLDDIRS += $(PATH_MULTIARCH_TEMP)
 PACKING += $(PACKAGE_NAME_FINAL)
 ifeq ($(KBUILD_TARGET_ARCH),amd64)
  PACKING += $(PATH_STAGE_BIN)/$(PACKAGE_NAME_MULTIARCH_FINAL)
 endif
else
 PACKAGE_NAME_MULTIARCH             := $(PACKAGE_NAME_LANG)-MultiArch
 PACKAGE_NAME_MULTIARCH_FINAL       := $(PACKAGE_NAME_MULTIARCH).exe
 PACKING += $(PACKAGE_NAME_FINAL) $(PATH_STAGE_BIN)/$(PACKAGE_NAME_MULTIARCH_FINAL)
endif
BLDDIRS += \
	$(VRA_WIN_INST_OUT_DIR) \
	$(VRA_WIN_INST_REPACK_DIR)/ \
	$(foreach lang,$(VRA_INSTALLER_LANGUAGES), \
		$(VRA_WIN_INST_OUT_DIR)/$(lang)/ \
		$(VRA_WIN_INST_REPACK_DIR)/files-VirtualAgent_$(lang)/ ) \
	$(VRA_WIN_INST_OUT_DIR)/NLS/

OTHER_CLEAN += \
	$(VRA_WIN_INST_OUT_DIR)/VirtualAgent.wix \
	$(VRA_WIN_INST_REPACK_DIR)/VirtualAgent.wix \
	$(VRA_WIN_INST_OUT_DIR)/VirtualAgent.msi.dep \
	$(VRA_WIN_INST_OUT_DIR)/VirtualAgent_TypeLib.wxi \
	$(VRA_WIN_INST_OUT_DIR)/VirtualAgent_TypeLib_x86.wxi \
	$(VRA_WIN_INST_OUT_DIR)/VirtualAgent_ProxyStub.wxi \
	$(if $(VRA_WITH_QTGUI),$(VRA_WIN_INST_OUT_DIR)/VBoxGuiNLS.wxi) \
	$(VRA_WIN_INST_OUT_DIR)/VBoxKey.wxi \
	$(VRA_WIN_INST_OUT_DIR)/VBoxUnattendedTemplateComponent.wxi \
	$(foreach lang,$(VRA_INSTALLER_LANGUAGES), \
		$(VRA_WIN_INST_OUT_DIR)/NLS/Language_$(lang).wxl \
		$(VRA_WIN_INST_OUT_DIR)/NLS/License_$(lang).wxl \
		$(VRA_WIN_INST_OUT_DIR)/$(lang)/$(lang).mst \
		$(VRA_WIN_INST_OUT_DIR)/$(lang)/$(PACKAGE_NAME_LANG)_$(lang).wixpdb \
		$(VRA_WIN_INST_OUT_DIR)/$(lang)/$(PACKAGE_NAME_LANG)_$(lang).msi \
		$(VRA_WIN_INST_OUT_DIR)/$(lang)/VirtualAgent_$(lang).wix \
		$(VRA_WIN_INST_OUT_DIR)/$(lang)/VirtualAgent_$(lang).msi.dep \
		$(VRA_WIN_INST_REPACK_DIR)/VirtualAgent_$(lang).wix \
		$(VRA_WIN_INST_REPACK_DIR)/VirtualAgent_$(lang).files \
		$(VRA_WIN_INST_REPACK_DIR)/1-build-$(PACKAGE_NAME_LANG).cmd \
		$(VRA_WIN_INST_REPACK_DIR)/files-VirtualAgent_$(lang)/Language_$(lang).wxl \
		$(VRA_WIN_INST_REPACK_DIR)/files-VirtualAgent_$(lang)/License_$(lang).wxl ) \
	$(VRA_WIN_INST_OUT_DIR)/DirComponentsAndFiles_DTrace.wxi \
	$(VRA_WIN_INST_OUT_DIR)/Files_Main.wxi \
	$(VRA_WIN_INST_OUT_DIR)/Files_Doc.wxi \
	$(VRA_WIN_INST_OUT_DIR)/Files_License.wxi \
	$(VRA_WIN_INST_OUT_DIR)/Shortcuts_StartMenu.wxi \
	$(VRA_WIN_INST_OUT_DIR)/$(PACKAGE_NAME_LANG).msi \
	$(VRA_WIN_INST_REPACK_DIR)/2-multilingual-$(PACKAGE_NAME_LANG).cmd \
	$(PATH_STAGE_BIN)/$(PACKAGE_NAME_MULTIARCH_FINAL)

ifdef VRA_WITH_COMBINED_PACKAGE
 ifeq ($(KBUILD_TARGET_ARCH),amd64)
  OTHER_CLEAN += \
  	$(VRA_WIN_INST_REPACK_DIR)/3-multiarch-$(PACKAGE_NAME_MULTIARCH_FINAL).cmd \
  	$(PATH_MULTIARCH_TEMP)/$(PACKAGE_NAME_MULTIARCH.amd64)
 endif
 ifndef VRA_WITH_MSM_INSTALL
  OTHER_CLEAN += \
  	$(VRA_WIN_INST_OUT_DIR)/common.cab
 endif
else
 OTHER_CLEAN += \
 	$(VRA_WIN_INST_REPACK_DIR)/3-multiarch-$(PACKAGE_NAME_MULTIARCH_FINAL).cmd \
 	$(PACKAGE_NAME_FINAL)
endif

ifdef VRA_WITH_MSM_INSTALL
 OTHER_CLEAN += \
 	$(foreach module,$(VRA_INSTALLER_MERGE_MODULES), \
 		$(foreach lang,$(VRA_INSTALLER_MERGE_LANGUAGES), \
 			$(VRA_WIN_INST_OUT_DIR)/VBoxMerge$(module)_$(lang)_$(KBUILD_TARGET_ARCH).msm \
 			$(VRA_WIN_INST_OUT_DIR)/VBoxMerge$(module)_$(lang).msm.dep \
 			$(VRA_WIN_INST_OUT_DIR)/VBoxMerge$(module)_$(lang).wixpdb \
 			$(VRA_WIN_INST_REPACK_DIR)/VBoxMerge$(module)_$(lang).wix \
 			$(VRA_WIN_INST_REPACK_DIR)/VBoxMerge$(module)_$(lang).files)
 BLDDIRS        += $foreach lang,$(VRA_INSTALLER_MERGE_LANGUAGES), \
 	$(VRA_WIN_INST_REPACK_DIR)/files-VBoxMerge$(module)_$(lang)/)
endif

#
# Defines the WIX binary we're going to use.
#
# For WIX v4 there only is one single binary which can do all the required steps
# (compiling, linking, ...).
#
VRA_TOOLS_WIN_WIX_BIN    := $(VRA_PATH_WIX)/tools/net472/x86/wix.exe
# Defines the path to the WIX extension DLLs. Might differ for other (major) WIX versions.
VRA_TOOLS_WIN_WIXEXT_DIR := $(VRA_PATH_WIX)/wixext4/

#
# Defines the extension DLL we use for building an installer.
#
VRA_TOOLS_WIN_WIX_EXT := \
	$(if-expr defined(VRA_WITH_MSI_HACK),-ext $(MsiHack_0_OUTDIR)/MsiHackExtension.dll,) \
	-ext $(VRA_TOOLS_WIN_WIXEXT_DIR)/WixToolset.Ui.wixext.dll \
	-ext $(VRA_TOOLS_WIN_WIXEXT_DIR)/WixToolset.Util.wixext.dll

#
# Create intermediate XML file for languages (needed for .MSI linking).
#
# Note: The double escaping of $(dir $@) in the prereq/dep list is because we first have
#       to escape the expansion of the $(eval ) argument and then the definition of the
#       rule. The statement is finally expanded during second dependency expansion, which
#       takes place after all makefiles has been loaded and with the @ variable defined.
#
define def_vbox_lang_xml
 $(VRA_WIN_INST_OUT_DIR)/NLS/Language_$(lang).wxl: $(VRA_PATH_WIN_INST_SRC)/NLS/$(lang).wxl | $$$$(dir $$$$@)
	$$(call MSG_GENERATE,,$$@,$$<)
	$(QUIET)$(INSTALL) -m 0644 $$< $$@
endef

$(foreach lang,$(VRA_INSTALLER_LANGUAGES), \
	$(eval $(def_vbox_lang_xml)))

#
# Create intermediate XML file for licenses (needed for .MSI building).
# These files are created from the original .RTF files in the /docs directory.
#
# Note: The redirect command below will open $$@ as stdout in append+text mode
#       and then exec cat, thus appending the license file to the result file.
#
# Note: The license_file variable has to be created before def_vbox_license_xml
#       is expanded by the 2nd eval because we rely on the that expansion
#       replacing all $(license_file) (and $(lang)) references before evaluation.
#
# Note: The REDIRECT + ECHO_EXT is because WiX gets upset if there a newline
#       between the tag and the RTF license text.
#
define def_vbox_license_xml
 $(VRA_WIN_INST_OUT_DIR)/NLS/License_$(lang).wxl: $(license_file) $(VRA_WIN_INST_MAKEFILE_DEP) | $$$$(dir $$$$@)
	$$(call MSG_GENERATE,,$$@,$$<)
	$(APPEND) -t $$@ '<?xml version="1.0" encoding="utf-8"?>'
	$(APPEND) $$@ '<WixLocalization xmlns="http://wixtoolset.org/schemas/v4/wxl" Codepage="$(VRA_BRAND_$(lang)_LANGUAGE_CODEPAGE)" Culture="$(lang)">'

	$(REDIRECT) -a+to $$@ -- $(ECHO_EXT) -n '<String Id="LicenseText" Value="'
	$(REDIRECT) -a+to $$@ -- $(SED) -e "s|<|\&lt;|g" -e "s|>|\&gt;|g" $(license_file)
	$(APPEND) $$@ '" />'

	$(APPEND) $$@ '<String Id="LicenseFile" Value="$(license_file)" />'
	$(APPEND) $$@ '<String Id="LicenseInstallFileLong" Value="License_$(lang).rtf" />'
	$(APPEND) $$@ '<String Id="LicenseInstallFileShort" Value="L_$(lang).rtf" />'

	$(APPEND) $$@ '</WixLocalization>'
endef

$(foreach lang,$(VRA_INSTALLER_LANGUAGES), \
	$(eval local license_file := $(VRA_BRAND_$(subst en_US_,,$(lang)_)LICENSE_RTF)) \
	$(eval $(def_vbox_license_xml)))

#
# Create one intermediate WXI (Windows Installer Include) file for all installers (needed for .MSI compiling).
# This file includes all language-specific files (PDFs, CHMs, ...) to install.
#
# Note: When using the -n switch, append will append a new line after each
#       argument. The -t switch makes it truncate the file.
#
$(VRA_WIN_INST_OUT_DIR)/Files_Main.wxi: $(VRA_WIN_INST_MAKEFILE_DEP) | $$(dir $$@)
	$(call MSG_GENERATE,,$@,$<)
	$(APPEND) -t $@ '<?xml version="1.0" ?>'
	$(APPEND) $@ '<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">'
ifdef VRA_WITH_DOCS_PACKING
 ifdef VRA_WITH_DOCS_QHELP_PACKING
	$(APPEND) $@ '	<File Id="file_UserManual.qch" Name="UserManual.qch" DiskId="$(VRA_INSTALLER_COMMON_DISKID)" Vital="yes" Source="$(subst /,\,$(PATH_STAGE_BIN)/UserManual.qch)"></File>'
	$(APPEND) $@ '	<File Id="file_UserManual.qhc" Name="UserManual.qhc" DiskId="$(VRA_INSTALLER_COMMON_DISKID)" Vital="yes" Source="$(subst /,\,$(PATH_STAGE_BIN)/UserManual.qhc)"></File>'
	$(APPEND) -n $@ $(foreach lang,$(VRA_MANUAL_ADD_LANGUAGES), \
		     '	<File Id="file_UserManual_$(lang).qch" Name="UserManual_$(lang).qch" DiskId="$(VRA_INSTALLER_COMMON_DISKID)" Vital="yes" Source="$(subst /,\,$(PATH_STAGE_BIN)/UserManual_$(lang).qch)"></File>' \
		     '	<File Id="file_UserManual_$(lang).qhc" Name="UserManual_$(lang).qhc" DiskId="$(VRA_INSTALLER_COMMON_DISKID)" Vital="yes" Source="$(subst /,\,$(PATH_STAGE_BIN)/UserManual_$(lang).qhc)"></File>')
 endif
endif
	$(APPEND) $@ '</Include>'

$(VRA_WIN_INST_OUT_DIR)/Files_Doc.wxi: $(VRA_WIN_INST_MAKEFILE_DEP) | $$(dir $$@)
	$(call MSG_GENERATE,,$@,$<)
	$(APPEND) -t $@ '<?xml version="1.0" ?>'
	$(APPEND) $@ '<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">'
ifdef VRA_WITH_DOCS_PACKING
	$(APPEND) $@ '	<File Id="file_UserManual.pdf" Name="UserManual.pdf" DiskId="$(VRA_INSTALLER_COMMON_DISKID)" Vital="yes" Source="$(subst /,\,$(PATH_STAGE_BIN)/UserManual.pdf)">'
	$(APPEND) $@ '	</File>'
	$(APPEND) -n $@ $(foreach lang,$(VRA_MANUAL_ADD_LANGUAGES), \
	             '	<File Id="file_UserManual_$(lang).pdf" Name="UserManual_$(lang).pdf" DiskId="$(VRA_INSTALLER_COMMON_DISKID)" Vital="yes" Source="$(subst /,\,$(PATH_STAGE_BIN)/UserManual_$(lang).pdf)">' \
	             '	</File>')
endif
	$(APPEND) $@ '</Include>'

$(VRA_WIN_INST_OUT_DIR)/Files_License.wxi: $(VRA_WIN_INST_MAKEFILE_DEP) | $$(dir $$@)
	$(call MSG_GENERATE,,$@,$<)
	$(APPEND) -t $@ '<?xml version="1.0" ?>'
	$(APPEND) $@ '<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">">'
	$(APPEND) $@ '	<File Id="file_License_en_US.rtf" Name="License_en_US.rtf" DiskId="$(VRA_INSTALLER_COMMON_DISKID)" Vital="yes" Source="$(subst /,\,$(VRA_BRAND_LICENSE_RTF))">' \
	             '	</File>'
	$(APPEND) -n $@ $(foreach lang,$(VRA_LICENSE_ADD_LANGUAGES), \
	             '	<File Id="file_License_$(lang).rtf" Name="License_$(lang).rtf" DiskId="$(VRA_INSTALLER_COMMON_DISKID)" Vital="yes" Source="$(subst /,\,$(VRA_BRAND_$(lang)_LICENSE_RTF))">' \
	             '	</File>')
	$(APPEND) $@ '</Include>'

$(VRA_WIN_INST_OUT_DIR)/DirComponentsAndFiles_DTrace.wxi: $(VRA_WIN_INST_MAKEFILE_DEP) $(PATH_SUB_CURRENT)/../Config.kmk | $$(dir $$@)
	$(call MSG_GENERATE,,$@,$<)
	$(QUIET)$(APPEND) -nt "$@" \
		'<?xml version="1.0" ?>' \
		'<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">'
ifdef VRA_WITH_DTRACE
	$(QUIET)$(APPEND) -n "$@" \
		'<Directory Id="dir_DTrace" Name="dtrace">' \
		'  <Directory Id="dir_DTrace_lib" Name="lib">' \
		'    <Directory Id="dir_DTrace_lib_arch" Name="$(KBUILD_TARGET_ARCH)">' \
		'      <Component Id="cp_dir_DTrace_lib_arch" Guid="7476CDF6-4157-2E17-5CCC-FF92528D2854" Bitness="$$(var.Property_Bitness)">' \
		$(foreach file, $(VRAINST_DTRACE_LIB_ARCH_FILES) \
                	, '        <File Id="file_dtrace_lib_arch_$(subst -,_,$(file))" Name="$(file)" Vital="yes" ' \
			  '              Source="$(subst /,\,$(PATH_STAGE_BIN)/dtrace/lib/$(KBUILD_TARGET_ARCH)/$(file))" />' ) \
		'      </Component>' \
		'    </Directory>' \
		'  </Directory>' \
        $(if $(VRAINST_DTRACE_TESTCASE_ARCH_FILES), \
		'  <Directory Id="dir_DTrace_testcase" Name="testcase">' \
		'    <Directory Id="dir_DTrace_testcase_arch" Name="$(KBUILD_TARGET_ARCH)">' \
		'      <Component Id="cp_dir_DTrace_testcase_arch" Guid="45DF7014-4431-6C40-6DB0-35AF7C690EE1" Bitness="$$(var.Property_Bitness)">' \
		$(foreach file, $(VRAINST_DTRACE_TESTCASE_ARCH_FILES) \
                	, '        <File Id="file_dtrace_testcase_arch_$(subst -,_,$(file))" Name="$(file)" Vital="yes" ' \
			  '              Source="$(subst /,\,$(PATH_STAGE_BIN)/dtrace/testcase/$(KBUILD_TARGET_ARCH)/$(file))" />' ) \
		'      </Component>' \
		'    </Directory>' \
		'  </Directory>') \
        $(if $(VRAINST_DTRACE_SCRIPTS_FILES), \
		'  <Directory Id="dir_DTrace_scripts" Name="scripts">' \
		'    <Component Id="cp_dir_DTrace_scripts" Guid="AE07F9D5-4FD9-ACC7-C760-E9923CE01E16" Bitness="$$(var.Property_Bitness)">' \
		$(foreach file, $(VRAINST_DTRACE_SCRIPTS_FILES) \
                	, '      <File Id="file_dtrace_scripts_$(subst -,_,$(file))" Name="$(file)" Vital="yes" ' \
			  '            Source="$(subst /,\,$(PATH_STAGE_BIN)/dtrace/scripts/$(file))" />' ) \
		'    </Component>' \
		'  </Directory>') \
		'</Directory>'
endif
	$(QUIET)$(APPEND) "$@" '</Include>'


$(VRA_WIN_INST_OUT_DIR)/Shortcuts_StartMenu.wxi: $(VRA_WIN_INST_MAKEFILE_DEP) | $$(dir $$@)
	$(call MSG_GENERATE,,$@,$<)
	$(APPEND) -t $@ '<?xml version="1.0" ?>'
	$(APPEND) $@ '<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">'
        #
        # Documentation (PDF/CHM)
        #
ifdef VRA_WITH_DOCS_PACKING
	$(APPEND) $@ '	<Shortcut Id="sc_StartMenu_ManualPDF_en_US" Directory="dir_StartMenuVBox" Name="!(loc.StartMenu_UserManual) (PDF, English)" Description="!(loc.StartMenu_UserManual)"' \
	             '            Target="[INSTALLDIR]\doc\UserManual.pdf" WorkingDirectory="dir_StartMenuVBox" Advertise="no"/>'
	$(APPEND) -n $@ $(foreach lang,$(VRA_MANUAL_ADD_LANGUAGES), \
	             '	<Shortcut Id="sc_StartMenu_ManualPDF_$(lang)" Directory="dir_StartMenuVBox" Name="!(loc.StartMenu_UserManual) (PDF, $(VRA_BRAND_$(lang)_LANG_NAME))"' \
		     '            Description="!(loc.StartMenu_UserManual) ($(VRA_BRAND_$(lang)_LANG_NAME))" Target="[INSTALLDIR]\doc\UserManual_$(lang).pdf" WorkingDirectory="dir_StartMenuVBox"/>')
endif
        #
        # License(s) (RTF)
        #
	$(APPEND) $@ '	<Shortcut Id="sc_StartMenu_License_en_US" Directory="dir_StartMenuVBox" Name="!(loc.StartMenu_License) (English)" Description="!(loc.StartMenu_License)"' \
	             '            Target="[INSTALLDIR]License_en_US.rtf" WorkingDirectory="INSTALLDIR" Advertise="no"/>'
	$(APPEND) -n $@ $(foreach lang,$(VRA_LICENSE_ADD_LANGUAGES), \
	             '	<Shortcut Id="sc_StartMenu_License_$(lang)" Directory="dir_StartMenuVBox" Name="!(loc.StartMenu_License) ($(VRA_BRAND_$(lang)_LANG_NAME))"' \
		     '            Description="!(loc.StartMenu_License) ($(VRA_BRAND_$(lang)_LANG_NAME))" Target="License_$(lang).rtf" WorkingDirectory="INSTALLDIR"/>')
	$(APPEND) $@ '</Include>'

# Note! Keep the list sorted for easier lookup.
VRA_WIN_INST_ENV := \
	-E 'KBUILD_TARGET_ARCH=$(KBUILD_TARGET_ARCH)' \
	-E 'KBUILD_TYPE=$(KBUILD_TYPE)' \
	-E 'PATH_MULTIARCH_GUEST_ADDITIONS_ISO=$(subst /,\,$(PATH_MULTIARCH_GUEST_ADDITIONS_ISO))' \
	-E 'PATH_OUT=$(subst /,\,$(PATH_OUT))' \
	-E 'PATH_ROOT=$(subst /,\,$(PATH_ROOT))' \
	-E 'PATH_TARGET=$(subst /,\,$(VRA_WIN_INST_OUT_DIR))' \
	-E 'VRA_ADD_LANGUAGES=$(VRA_INSTALLER_ADD_LANGUAGES)' \
	-E 'VRA_BRAND_LICENSE_RTF=$(subst /,\,$(VRA_BRAND_LICENSE_RTF))' \
	-E 'VRA_BRAND_WIN_INST_DLGJPG=$(subst /,\,$(VRA_BRAND_WIN_INST_DLGJPG))' \
	-E 'VRA_BUILD_NR_FOR_INST=$(VRA_VERSION_BUILD)' \
	-E 'VRA_C_YEAR=$(VRA_C_YEAR)' \
	$(foreach lang,$(VRA_INSTALLER_LANGUAGES), \
		-E 'VRA_BRAND_$(lang)_LICENSE_RTF=$(subst /,\,$(VRA_BRAND_$(subst en_US_,,$(lang)_)LICENSE_RTF))') \
	-E 'VRA_INSTALLER_QUICK=$(VRA_INSTALLER_QUICK)' \
	-E 'VRA_MIDL_PROXY_CLSID=$(VRA_MIDL_PROXY_CLSID)' \
	-E 'VRA_PATH_WIN_INST_SRC=$(subst /,\,$(VRA_PATH_WIN_INST_SRC))' \
	-E 'VRA_PRODUCT=$(VRA_PRODUCT)' \
	-E 'VRA_QT_INFIX=$(VRA_QT_INFIX)' \
	-E 'VRA_SIGNING_MODE=$(strip $(if $(VRA_SIGNING_MODE),$(VRA_SIGNING_MODE),none))' \
	-E 'VRA_VCC_TOOL_STEM=$(VRA_VCC_TOOL_STEM)' \
	-E 'VRA_VENDOR_SHORT=$(VRA_VENDOR_SHORT)' \
	-E 'VRA_VENDOR=$(VRA_VENDOR)' \
	-E 'VRA_VERSION_MAJOR_INST=$(VRA_VERSION_MAJOR)' \
	-E 'VRA_VERSION_MINOR_INST=$(VRA_VERSION_MINOR)' \
	-E 'VRA_VERSION_STRING_RAW=$(VRA_VERSION_STRING_RAW)' \
	-E 'VRA_VERSION_STRING=$(VRA_VERSION_STRING)' \
	-E 'VRA_WINDOWS_ICON_FILE=$(subst /,\,$(VRA_WINDOWS_ICON_FILE))' \
	-E 'VRA_WITH_32_ON_64_MAIN_API=$(if $(VRA_WITH_32_ON_64_MAIN_API),yes,no)' \
	-E 'VRA_WITH_ADDITIONS_PACKING=$(if $(VRA_WITH_ADDITIONS_PACKING),yes,no)' \
	-E 'VRA_WITH_COMBINED_PACKAGE=$(if-expr defined(VRA_WITH_COMBINED_PACKAGE),yes,no)' \
	-E 'VRA_WITH_CRT_PACKING=$(if-expr defined(VRA_WITH_CRT_PACKING),yes,no)' \
	-E 'VRA_WITH_DEBUGGER_GUI=$(if-expr defined(VRA_WITH_DEBUGGER_GUI) && defined(VRA_WITH_QTGUI),yes,no)' \
	-E 'VRA_WITH_DOCS_PACKING=$(if $(VRA_WITH_DOCS_PACKING),yes,no)' \
	-E 'VRA_WITH_DRAG_AND_DROP=$(if $(VRA_WITH_DRAG_AND_DROP),yes,no)' \
	-E 'VRA_WITH_DTRACE=$(if $(VRA_WITH_DTRACE),yes,no)' \
	-E 'VRA_WITH_EFIFW_PACKING=$(if $(VRA_WITH_EFIFW_PACKING),yes,no)' \
	-E 'VRA_WITH_EXTPACK=$(if $(VRA_WITH_EXTPACK),yes,no)' \
	-E 'VRA_WITH_FE_AUTOSTART=$(if $(VRA_WITH_FE_AUTOSTART),yes,no)' \
	-E 'VRA_WITH_FE_BALLOONCTRL=$(if $(VRA_WITH_FE_BALLOONCTRL),yes,no)' \
	-E 'VRA_WITH_FE_BUGREPORT=$(if $(VRA_WITH_FE_BUGREPORT),yes,no)' \
	-E 'VRA_WITH_GUEST_CONTROL=$(if $(VRA_WITH_GUEST_CONTROL),yes,no)' \
	-E 'VRA_WITH_GUEST_PROPS=$(if $(VRA_WITH_GUEST_PROPS),yes,no)' \
	-E 'VRA_WITH_HARDENING=$(if $(VRA_WITH_HARDENING),yes,no)' \
	-E 'VRA_WITH_HEADLESS=$(if $(VRA_WITH_HEADLESS),yes,no)' \
	-E 'VRA_WITH_HOST_SHIPPING_AUDIO_TEST=$(if $(VRA_WITH_HOST_SHIPPING_AUDIO_TEST),yes,no)' \
	-E 'VRA_WITH_LIBSSH=$(if $(VRA_WITH_LIBSSH),yes,no)' \
	-E 'VRA_WITH_LICENSE_DISPLAY=$(if $(VRA_WITH_LICENSE_DISPLAY),yes,no)' \
	-E 'VRA_WITH_MIDL_PROXY_STUB=$(if $(VRA_WITH_MIDL_PROXY_STUB),yes,no)' \
	-E 'VRA_WITH_MINIMAL_R0=$(if $(VRA_WITH_MINIMAL_R0),yes,no)' \
	-E 'VRA_WITH_MSM_INSTALL=$(if-expr defined(VRA_WITH_MSM_INSTALL),yes,no)' \
	-E 'VRA_WITH_NETADP=$(if $(VRA_WITH_NETADP),yes,no)' \
	-E 'VRA_WITH_NETFLT=$(if $(VRA_WITH_NETFLT),yes,no)' \
	-E 'VRA_WITH_ORACLE_QT=$(if $(VRA_WITH_ORACLE_QT),yes,no)' \
	-E 'VRA_WITH_PYTHON=$(if $(VRA_WITH_PYTHON),yes,no)' \
	-E 'VRA_WITH_QTGUI=$(if $(VRA_WITH_QTGUI),yes,no)' \
	-E 'VRA_WITH_R0_MODULES=$(if $(VRA_WITH_R0_MODULES),yes,no)' \
	-E 'VRA_WITH_RAW_MODE=$(if $(VRA_WITH_RAW_MODE),yes,no)' \
	-E 'VRA_WITH_SDS=$(if $(VRA_WITH_SDS),yes,no)' \
	-E 'VRA_WITH_SERIALNUMBER_INSTALL=$(if $(VRA_WITH_SERIALNUMBER_INSTALL),yes,no)' \
	-E 'VRA_WITH_UNATTENDED_TEMPLATES=$(if $(VRA_UNATTENDED_TEMPLATES),yes,no)' \
	-E 'VRA_WITH_UNATTENDED=$(if $(VRA_WITH_UNATTENDED),yes,no)' \
	-E 'VRA_WITH_USB=$(if $(VRA_WITH_USB),yes,no)' \
	-E 'VRA_WITH_VRA_IMG=$(if $(VRA_WITH_VRA_IMG),yes,no)' \
	-E 'VRA_WITH_VRASDL=$(if $(VRA_WITH_VRASDL),yes,no)' \
	-E 'VRA_WITH_VIRT_ARMV8=$(if $(VRA_WITH_VIRT_ARMV8),yes,no)' \
	-E 'VRA_WITH_VMSVGA3D=$(if $(VRA_WITH_VMSVGA3D),yes,no)' \
	-E 'VRA_WITH_VRDP=$(if $(VRA_WITH_VRDP),yes,no)' \
	-E 'VRA_WITH_WEBSERVICES=$(if $(VRA_WITH_WEBSERVICES),yes,no)'

ifndef VRA_WIN_ATTESTATION_SIGNING
 VRA_WIN_INST_ENV += \
 	-E 'VRA_PATH_ATTESTATION_SIGNED=$(subst /,\,$(PATH_OUT))\bin'

else  # VRA_WIN_ATTESTATION_SIGNING
 VRA_WIN_INST_ENV += \
 	-E 'VRA_PATH_ATTESTATION_SIGNED=$(subst /,\,$(VRA_WIN_INST_REPACK_DIR))\hostdrivers'

 $(VRA_WIN_INST_REPACK_DIR)/$(PACKAGE_NAME_LANG)-$(KBUILD_TARGET_ARCH).cab \
 + $(VRA_WIN_INST_REPACK_DIR)/$(PACKAGE_NAME_LANG)-$(KBUILD_TARGET_ARCH).cab.ddf \
 + $(VRA_WIN_INST_REPACK_DIR)/$(PACKAGE_NAME_LANG)-$(KBUILD_TARGET_ARCH).cab.inf \
 + $(VRA_WIN_INST_REPACK_DIR)/$(PACKAGE_NAME_LANG)-$(KBUILD_TARGET_ARCH).cab.rpt: \
 		$(VRA_WIN_INST_REPACK_DIR)/PackDriversForSubmission.cmd ## @todo more deps
	$(call MSG_L1,Packing drivers for submission to attesttion signing (=> $@))
	$(RM) -f -- "$@" "$@.ddf" "$@.inf" "$@.rpt"
	$(REDIRECT) -E 'KBUILD_BIN_PATH=$(KBUILD_BIN_PATH)' \
		-C "$(@D)" \
		-- $(EXEC_X86_WIN32) cmd.exe /c \
		'PackDriversForSubmission.cmd -b $(PATH_STAGE_BIN) -a $(KBUILD_TARGET_ARCH) -x -n --no-extpack -o $(VRA_WIN_INST_REPACK_DIR)/$(PACKAGE_NAME_LANG)-$(KBUILD_TARGET_ARCH).cab'

 $(VRA_WIN_INST_REPACK_DIR)/$(PACKAGE_NAME_LANG)-$(KBUILD_TARGET_ARCH).cab.Signed.zip: \
 		$(VRA_WIN_INST_REPACK_DIR)/$(PACKAGE_NAME_LANG)-$(KBUILD_TARGET_ARCH).cab
	$(call MSG_L1,Submitting drivers ($<) for attestation signing (=> $@))
	$(TIME_EXT) $(REDIRECT_EXT) -C "$(@D)" \
		-- $(VRA_RETRY) $(VRA_WIN_ATTESTATION_SIGNING_EXE) \
		"VirtualAgent Base drivers $(KBUILD_TARGET_ARCH) $(VRA_VERSION_MAJOR).$(VRA_VERSION_MINOR).$(VRA_VERSION_BUILD)r$(VRA_SVN_REV)" \
		"$(KBUILD_TARGET_ARCH)" \
		"r$(VRA_SVN_REV)" \
		"$(PACKAGE_NAME_LANG)-$(KBUILD_TARGET_ARCH).cab"

 $(VRA_WIN_INST_REPACK_DIR)/hostdrivers/UnpackedSignedDrivers.ts: \
 		$(VRA_WIN_INST_REPACK_DIR)/$(PACKAGE_NAME_LANG)-$(KBUILD_TARGET_ARCH).cab.Signed.zip
	$(call MSG_L1,Unpacking attestation signed drivers ($<))
	$(RM) -Rf -- "$(@D)"
	$(MKDIR) -p -- "$(@D)"
	unzip -j "$<" -d "$(@D)"
 ## @todo verify the signatures like UnpackBlessedDrivers.cmd does?
	$(TOUCH) "$@"

endif # VRA_WIN_ATTESTATION_SIGNING

#
# Building the main installer (en_US).
#
# Since WIX v4 we don't need to do compilation + linking as separate steps,
# as the WIX binary all now does this internally with its "build" command.
#
# Note: This will clean up any previous .msi and .wixpdb files to prevent dep
#       build boxes from filling up with old files.
#
define def_vbox_build_msi
 $(VRA_WIN_INST_OUT_DIR)/$(lang)/$(PACKAGE_NAME_LANG)_$(lang).msi \
 $(if-expr defined(VRA_WITH_COMBINED_PACKAGE) && !defined(VRA_WITH_MSM_INSTALL), + $(VRA_WIN_INST_OUT_DIR)/common.cab,): \
 		$(VRA_WIN_INST_OUT_DIR)/VirtualAgent_$(lang).wixlib \
 		$(VRA_WIN_INST_OUT_DIR)/NLS/Language_$(lang).wxl \
 		$(VRA_WIN_INST_OUT_DIR)/NLS/License_$(lang).wxl \
 		$(PATH_STAGE_BIN)/VBoxDrvInst.exe \
 		$(PATH_STAGE_BIN)/VBoxInstallHelper.dll \
 		$(if-expr defined(VRA_WIN_ATTESTATION_SIGNING),$(VRA_WIN_INST_REPACK_DIR)/hostdrivers/UnpackedSignedDrivers.ts,) \
 		$(VRA_SVN_REV_KMK) \
 		$(VRA_WIN_INST_MAKEFILE_DEP) \
 		$(if-expr defined(VRA_WITH_MSI_HACK),$(MsiHack_0_OUTDIR)/MsiHack.dll,) \
 		$(if-expr defined(VRA_WITH_MSI_HACK),$(MsiHack_0_OUTDIR)/MsiHackExtension.dll,) \
 		| $$$$(dir $$$$@)
	$$(call MSG_L1,Building installer $$@)
	$(QUIET)$(RM) -f $$(wildcard $$(subst r$$(VRA_SVN_REV),r*,\
		$$@ \
		$$(basename $$@).wixpdb \
		$$(VRA_WIN_INST_REPACK_DIR)/2-link-$$(PACKAGE_NAME_LANG).cmd ))
	kmk_time $$(REDIRECT_EXT) $(VRA_WIN_INST_ENV) -E WIX_TEMP='$$(subst /,\,$$(@D))' \
		-- $(VRA_TOOLS_WIN_WIX_BIN) build \
		-arch "$(VRA_INS_PROD_ARCH)" \
		-defaultcompressionlevel "$(VRA_CAB_COMPRESSION_LEVEL)" \
		-intermediatefolder $$(@D)/wix-temp/ \
		-loc $(VRA_WIN_INST_OUT_DIR)/NLS/Language_$(lang).wxl \
		-loc $(VRA_WIN_INST_OUT_DIR)/NLS/License_$(lang).wxl \
		-lib $(VRA_WIN_INST_OUT_DIR)/VirtualAgent_$(lang).wixlib \
		-ext $(VRA_TOOLS_WIN_WIXEXT_DIR)/WixToolset.Util.wixext.dll \
		-pdbtype none \
		-out $$@
 if defined(VRA_WITH_COMBINED_PACKAGE) && !defined(VRA_WITH_MSM_INSTALL)
	$(MV) -f -- $$(@D)/common.cab $$(@D)/../common.cab
 endif
 ifeq ($(lang),en_US)
	$(CP) -f -- "$(VRA_WIN_INST_OUT_DIR)/NLS/Language_$(lang).wxl" "$(VRA_WIN_INST_OUT_DIR)/NLS/License_$(lang).wxl" \
       	"$(VRA_WIN_INST_REPACK_DIR)/files-VirtualAgent_$(lang)/"
  # Create repack script for this step.
	$(APPEND) -tn "$$(VRA_WIN_INST_REPACK_DIR)/1-compile-$$(PACKAGE_NAME_LANG).cmd" \
       	'if ".%KBUILD_DEVTOOLS%" == "." (echo KBUILD_DEVTOOLS is not set & exit /b1)' \
		$(subst $(KBUILD_DEVTOOLS),%KBUILD_DEVTOOLS%,\
		'$(VRA_TOOLS_WIN_WIX_BIN) build ^' \
		'  files-VirtualAgent_$(lang)/Language_$(lang).wxl ^' \
		'  files-VirtualAgent_$(lang)/License_$(lang).wxl ^' \
		'  -lib VirtualAgent_en_US.wixlib ^' \
		'  -ext $(VRA_TOOLS_WIN_WIXEXT_DIR)/WixToolset.Util.wixext.dll ^' \
		'  -pdbtype none ^' \
		'  -out $$(@F) ^' \
               '  || exit /b1' \
               ) \
               '@echo Created MSI installer: $$(@F)' \
		$(if-expr defined(VRA_WITH_COMBINED_PACKAGE) && !defined(VRA_WITH_MSM_INSTALL),'@echo Created: common.cab',)

 endif
	$(RM) -Rf -- $$(@D)/wix-temp/
endef

$(foreach lang, en_US, $(eval $(def_vbox_build_msi)))


#
# Merge module building (all languages).
#
# This takes the existing merge module WIX library (.wixlib) as input and builds a MSI merge
# module (.msm) out of it.
#
# Note: This will clean up any previous .msm to prevent dep build boxes from
#       filling up with old files.
#
define def_vbox_build_msm
 $(VRA_WIN_INST_OUT_DIR)/VBoxMerge$(module)_$(lang)_$(KBUILD_TARGET_ARCH).msm: \
 		$(VRA_WIN_INST_OUT_DIR)/VBoxMerge$(module)_$(lang).wixlib \
 		$(VRA_WIN_INST_OUT_DIR)/NLS/Language_$(lang).wxl \
 		$(VRA_WIN_INST_OUT_DIR)/NLS/License_$(lang).wxl \
 		$(PATH_STAGE_BIN)/VBoxDrvInst.exe \
 		$(PATH_STAGE_BIN)/VBoxInstallHelper.dll \
 		$(VRA_SVN_REV_KMK) \
 		$(VRA_WIN_INST_MAKEFILE_DEP) \
 		| $$$$(dir $$$$@)
	$$(call MSG_L1,Building merge module $$@)
	$(QUIET)$(RM) -f $$(wildcard $(VRA_WIN_INST_OUT_DIR)/$(PACKAGE_BASE)-r*_$(lang).msi)
	kmk_time $$(REDIRECT_EXT) $(VRA_WIN_INST_ENV) -E WIX_TEMP='$$(subst /,\,$$(@D))' \
		-- $(VRA_TOOLS_WIN_WIX_BIN) build \
		-arch "$(VRA_INS_PROD_ARCH)" \
		-defaultcompressionlevel "$(VRA_CAB_COMPRESSION_LEVEL)" \
		-intermediatefolder $$(@D)/wix-temp/ \
		-loc $(VRA_WIN_INST_OUT_DIR)/NLS/Language_$(lang).wxl \
		-loc $(VRA_WIN_INST_OUT_DIR)/NLS/License_$(lang).wxl \
		-lib $(VRA_WIN_INST_OUT_DIR)/VBoxMerge$(module)_$(lang).wixlib \
		-pdbtype none \
		-out $$@
	$(RM) -Rf -- \
		$(VRA_WIN_INST_OUT_DIR)/NLS/$(lang).mst \
		$$(@D)/wix-temp/
	$(call VRA_SIGN_MSM_FN,$$@,$(VRA_PRODUCT) $(VRA_VERSION_STRING)r$(VRA_SVN_REV) ($(KBUILD_TARGET_ARCH)),,,disable-dual-signing)
 # Create repack script for this step.
	$(APPEND) -tn "$$(VRA_WIN_INST_REPACK_DIR)/1-build-VBoxMerge$(module)_$(lang).cmd" \
       	'if ".%KBUILD_DEVTOOLS%" == "." (echo KBUILD_DEVTOOLS is not set & exit /b1)' \
		$(subst $(KBUILD_DEVTOOLS),%KBUILD_DEVTOOLS%,\
		'$(VRA_TOOLS_WIN_WIX_BIN) build ^' \
		'  files-VirtualAgent_$(lang)/Language_$(lang).wxl ^' \
		'  files-VirtualAgent_$(lang)/License_$(lang).wxl ^' \
		'  $(VRA_TOOLS_WIN_WIX_EXT) ^' \
		'  -out $$(@F) ^' \
               '  || exit /b1' \
		'call sign-sha1.cmd $$(@F) || exit /b1' \
               ) \
               '@echo Created MSM module: $$(@F)'
endef

ifdef VRA_WITH_MSM_INSTALL
 $(foreach module,$(VRA_INSTALLER_MERGE_MODULES), \
 	$(foreach lang,$(VRA_INSTALLER_MERGE_LANGUAGES), \
		$(eval $(def_vbox_build_msm))))
endif


#
# Add dependencies that makes sure necessary bits gets built.
# For combined packages we always use the .ISO from the amd64 build.
#
## @todo these are applied to the wrong step at the moment...
ifdef VRA_WITH_COMBINED_PACKAGE
 VRA_MSI_DEPENDENCIES := \
 	$(if $(VRA_WITH_ADDITIONS_PACKING),$(PATH_MULTIARCH_GUEST_ADDITIONS_ISO)/VBoxGuestAdditions.iso)
else
 VRA_MSI_DEPENDENCIES := \
 	$(if $(VRA_WITH_ADDITIONS_PACKING),$(VRA_PATH_ADDITIONS_ISO)/VBoxGuestAdditions.iso)
endif


#
# Building a WIX library object (.wixlib).
# We've separated the final building from the WIX library building for repacking reasons.
#
## @todo Proper dependencies: unzip -p VirtualAgent_en_US.wixlib | sed -e "s/\([,{]\)/\1\n/g" bar.json | sed -n -e "s/,$//" -e "s/]}$//" -e "s/}}$//" -e 's/"file"://p' -e 's/"path"://p' | sort |uniq
$(call KB_FN_AUTO_CMD_DEPS,$(VRA_WIN_INST_OUT_DIR)/VirtualAgent_en_US.wixlib)
$(VRA_WIN_INST_OUT_DIR)/VirtualAgent_en_US.wixlib \
+ $(VRA_WIN_INST_REPACK_DIR)/VirtualAgent_en_US.wixlib \
+ $(VRA_WIN_INST_REPACK_DIR)/VirtualAgent_en_US.files: \
		$(PATH_SUB_CURRENT)/VirtualAgent.wxs \
		$(PATH_SUB_CURRENT)/UserInterface.wxi \
		$(PATH_SUB_CURRENT)/CommonProperties.wxi \
		$(PATH_SUB_CURRENT)/Defines.wxi \
		$(PATH_SUB_CURRENT)/VBoxMergeApp.wxi \
		$(PATH_SUB_CURRENT)/VBoxMergeAppCA.wxi \
		$(PATH_SUB_CURRENT)/VBoxMergeAppSeq.wxi \
		$(VRA_WIN_INST_OUT_DIR)/Files_Doc.wxi \
		$(VRA_WIN_INST_OUT_DIR)/DirComponentsAndFiles_DTrace.wxi \
		$(VRA_WIN_INST_OUT_DIR)/Files_License.wxi \
		$(VRA_WIN_INST_OUT_DIR)/Files_Main.wxi \
		$(VRA_WIN_INST_OUT_DIR)/VBoxKey.wxi \
		$(VRA_WIN_INST_OUT_DIR)/VBoxGuiNLS.wxi \
		$(VRA_WIN_INST_OUT_DIR)/VirtualAgent_TypeLib.wxi \
		$(VRA_WIN_INST_OUT_DIR)/VBoxUnattendedTemplateComponent.wxi \
		$(if-expr defined(VRA_WITH_MSM_INSTALL), \
			$(foreach module,$(VRA_INSTALLER_MERGE_MODULES), \
				$(VRA_WIN_INST_OUT_DIR)/VBoxMerge$(module)_en_US_$(KBUILD_TARGET_ARCH).msm) \
			, \
			$(VRA_WIN_INST_OUT_DIR)/Shortcuts_StartMenu.wxi \
			$(VRA_WIN_INST_OUT_DIR)/VirtualAgent_TypeLib.wxi \
			$(if $(VRA_WITH_32_ON_64_MAIN_API),$(VRA_WIN_INST_OUT_DIR)/VirtualAgent_TypeLib_x86.wxi,) \
			$(VRA_WIN_INST_OUT_DIR)/VBoxKey.wxi \
			$(if $(VRA_WITH_CRT_PACKING),$(VRA_WIN_INST_OUT_DIR)/VBoxCrtDlls.wxi,) \
			$(if $(VRA_WITH_CRT_PACKING),$(VRA_WIN_INST_OUT_DIR)/VBoxCrtDlls32.wxi,) \
			$(VRA_WIN_INST_OUT_DIR)/VBoxUnattendedTemplateComponent.wxi \
			$(if $(VRA_WITH_QTGUI),$(VRA_WIN_INST_OUT_DIR)/VBoxGuiNLS.wxi) \
			$(VRA_MSI_DEPENDENCIES)) \
		$(VRA_VERSION_STAMP) \
		| $$(dir $$@) \
		$(VRA_WIN_INST_REPACK_DIR)/ \
		$(VRA_WIN_INST_REPACK_DIR)/files-VirtualAgent_en_US/
	$(call KB_FN_AUTO_CMD_DEPS_COMMANDS)
	$(QUIET)$(RM) -f -- "$@"  "$(VRA_WIN_INST_OUT_DIR)/VirtualAgent_en_US.wixlib" "$(VRA_WIN_INST_REPACK_DIR)/VirtualAgent_en_US.wixlib"
	$(REDIRECT) \
		$(VRA_WIN_INST_ENV) \
		$(if-expr defined(VRA_WITH_MSM_INSTALL), \
		$(foreach module,$(VRA_INSTALLER_MERGE_MODULES), \
			-E 'VRA_WIN_INST_MERGE_$(toupper $(module))=$(subst /,\,$(VRA_WIN_INST_OUT_DIR)/VBoxMerge$(module)_en_US_$(KBUILD_TARGET_ARCH).msm')),) \
		-- \
		$(VRA_TOOLS_WIN_WIX_BIN) build $(filter-out $(VRA_VERSION_STAMP),$<) \
			-arch "$(VRA_INS_PROD_ARCH)" \
			-defaultcompressionlevel "$(VRA_CAB_COMPRESSION_LEVEL)" \
			-intermediatefolder $(@D)/wix-temp/ \
			$(VRA_TOOLS_WIN_WIX_EXT) \
			-outputtype library \
			-out $(VRA_WIN_INST_OUT_DIR)/VirtualAgent_en_US.wixlib
# Copy over the .wixlib into the repack directory, so that it can be used later when
# doing the repacking via the shell scripts.
	$(CP) $(VRA_WIN_INST_OUT_DIR)/VirtualAgent_en_US.wixlib $(VRA_WIN_INST_REPACK_DIR)/
	$(RM) -Rf -- $(@D)/wix-temp/

## @todo r=bird: what is this supposed to be doing these days? OTHER_CLEAN += $(VRA_REPACK_FILES_VirtualAgent_en_US)


#
# MSM (merge module) building as a WIX library (.wixlib).
#
define def_vbox_build_msm_wixlib
 includedep $(VRA_WIN_INST_OUT_DIR)/VBoxMerge$(module)_$(lang).wixlib.dep
 $(VRA_WIN_INST_OUT_DIR)/VBoxMerge$(module)_$(lang).wixlib \
 $(if-expr "$(lang)" != "en_US",, \
 	+ $(VRA_WIN_INST_REPACK_DIR)/VBoxMerge$(module)_$(lang).wixlib): \
 		$(PATH_SUB_CURRENT)/VBoxMerge$(module).wxs \
 		$(PATH_SUB_CURRENT)/VBoxMerge$(module).wxi \
 		$(PATH_SUB_CURRENT)/VBoxMerge$(module)CA.wxi \
 		$(PATH_SUB_CURRENT)/VBoxMerge$(module)Seq.wxi \
 		$(PATH_SUB_CURRENT)/UserInterface.wxi \
 		$(VRA_WIN_INST_OUT_DIR)/Shortcuts_StartMenu.wxi \
 		$(VRA_WIN_INST_OUT_DIR)/VirtualAgent_TypeLib.wxi \
 		$(if $(VRA_WITH_32_ON_64_MAIN_API),$(VRA_WIN_INST_OUT_DIR)/VirtualAgent_TypeLib_x86.wxi,) \
 		$(VRA_WIN_INST_OUT_DIR)/VBoxKey.wxi \
 		$(if $(VRA_WITH_CRT_PACKING),$(VRA_WIN_INST_OUT_DIR)/VBoxCrtDlls.wxi,) \
 		$(if $(VRA_WITH_CRT_PACKING),$(VRA_WIN_INST_OUT_DIR)/VBoxCrtDlls32.wxi,) \
 		$(VRA_WIN_INST_OUT_DIR)/VBoxUnattendedTemplateComponent.wxi \
 		$(if $(VRA_WITH_QTGUI),$(VRA_WIN_INST_OUT_DIR)/VBoxGuiNLS.wxi) \
 		$(VRA_MSI_DEPENDENCIES) \
 		$(VRA_VERSION_STAMP) \
 		| $$$$(dir $$$$@) $(VRA_WIN_INST_REPACK_DIR)/
	$(QUIET)$(RM) -f -- "$$@" "$(VRA_WIN_INST_OUT_DIR)/VBoxMerge$(module)_$(lang).wix" "$(VRA_WIN_INST_REPACK_DIR)/VBoxMerge$(module)_$(lang).wix"
	$(REDIRECT) \
		$(VRA_WIN_INST_ENV) \
		$(if-expr defined(VRA_WITH_MSM_INSTALL), \
		$(foreach module,$(VRA_INSTALLER_MERGE_MODULES), \
			-E 'VRA_WIN_INST_MERGE_$(toupper $(module))=$(subst /,\,$(VRA_WIN_INST_OUT_DIR)/VBoxMerge$(module)_$(lang)_$(KBUILD_TARGET_ARCH).msm')),) \
		-- \
		$(VRA_TOOLS_WIN_WIX_BIN) build $(filter-out $(VRA_VERSION_STAMP),$$<) \
			-arch "$(VRA_INS_PROD_ARCH)" \
			-defaultcompressionlevel "$(VRA_CAB_COMPRESSION_LEVEL)" \
			-intermediatefolder $$(@D)/wix-temp/ \
			$(VRA_TOOLS_WIN_WIX_EXT) \
			-outputtype library \
			-out $(VRA_WIN_INST_OUT_DIR)/VBoxMerge$(module)_$(lang).wixlib
	$(RM) -Rf -- $$(@D)/wix-temp/
 ifeq ($(lang),en_US)
  # Copy over the .wixlib into the repack directory, so that it can be used later when
  # doing the repacking via the shell scripts.
	$(CP) $(VRA_WIN_INST_OUT_DIR)/VBoxMerge$(module)_$(lang).wixlib $(VRA_WIN_INST_REPACK_DIR)/
	$(MKDIR) -p -- "$(VRA_WIN_INST_REPACK_DIR)/files-VBoxMerge$(module)_$(lang)/"
 endif
 $(eval OTHER_CLEAN += $(VRA_REPACK_FILES_VBoxMerge$(module)_$(lang)))
endef

$(foreach module,$(VRA_INSTALLER_MERGE_MODULES), \
	$(foreach lang,$(VRA_INSTALLER_MERGE_LANGUAGES), \
		$(eval $(def_vbox_build_msm_wixlib))))

#
# VirtualAgent Type Library definition.
#
$(VRA_WIN_INST_OUT_DIR)/VirtualAgent_TypeLib.wxi: \
		$(PATH_SUB_CURRENT)/$(if-expr defined(VRA_WITH_MIDL_PROXY_STUB),VirtualAgent_TypeLibWithInterfaces.xsl,VirtualAgent_TypeLib.xsl) \
		$(VRA_XIDL_FILE) \
		$(MAKEFILE) \
		| $$(dir $$@)
	$(VRA_XSLTPROC) \
		$(if-expr defined(VRA_WITH_MIDL_PROXY_STUB),--stringparam "a_sProxyStubClsid" "$(VRA_MIDL_PROXY_CLSID)",) \
		$(if-expr defined(VRA_WITH_SDS),--stringparam "a_sWithSDS" "yes",) \
		-o $@ $< $(VRA_XIDL_FILE)

$(VRA_WIN_INST_OUT_DIR)/VirtualAgent_TypeLib_x86.wxi: \
		$(PATH_SUB_CURRENT)/$(if-expr defined(VRA_WITH_MIDL_PROXY_STUB),VirtualAgent_TypeLibWithInterfaces.xsl,VirtualAgent_TypeLib.xsl) \
		$(VRA_XIDL_FILE) \
		| $$(dir $$@)
	$(VRA_XSLTPROC) --stringparam "a_sTarget" "VBoxClient-x86" \
		$(if-expr defined(VRA_WITH_MIDL_PROXY_STUB),--stringparam "a_sProxyStubClsid" "$(VRA_MIDL_PROXY_CLSID)",) \
		$(if-expr defined(VRA_WITH_SDS),--stringparam "a_sWithSDS" "yes",) \
 		-o $@ $< $(VRA_XIDL_FILE)

#
# Construct the list of GUI translations.
# ('-t' -- truncate file; '-n' -- new line between arguments)
#
include $(PATH_ROOT)/src/VBox/Frontends/VirtualAgent/nls/ApprovedLanguages.kmk
$(call KB_FN_AUTO_CMD_DEPS,$(VRA_WIN_INST_OUT_DIR)/VBoxGuiNLS.wxi)
$(VRA_WIN_INST_OUT_DIR)/VBoxGuiNLS.wxi: $(PATH_ROOT)/src/VBox/Frontends/VirtualAgent/nls/ApprovedLanguages.kmk | $$(dir $$@)
	$(call KB_FN_AUTO_CMD_DEPS_COMMANDS)
	$(APPEND) -t $@ '<?xml version="1.0" ?>'
	$(APPEND) $@ '<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">'
	$(APPEND) -n $@ $(foreach lang,$(VRA_APPROVED_GUI_LANGUAGES), \
	             '  <File Id="file_nlsqt${lang}"  Name="qt_${lang}.qm"         DiskId="$(VRA_INSTALLER_COMMON_DISKID)" Vital="yes" Source="$$(env.PATH_OUT)\bin\nls\qt_${lang}.qm"         />' \
	             '  <File Id="file_nlsgui${lang}" Name="VirtualAgent_${lang}.qm" DiskId="$(VRA_INSTALLER_COMMON_DISKID)" Vital="yes" Source="$$(env.PATH_OUT)\bin\nls\VirtualAgent_${lang}.qm" />')
	$(APPEND) $@ '</Include>'

#
# Edit the version stored in the registry.
#
$(call KB_FN_AUTO_CMD_DEPS,$(VRA_WIN_INST_OUT_DIR)/VBoxKey.wxi)
$(VRA_WIN_INST_OUT_DIR)/VBoxKey.wxi: $(PATH_SUB_CURRENT)/VBoxKey.wxi $(VRA_VERSION_STAMP) | $$(dir $$@)
	$(call KB_FN_AUTO_CMD_DEPS_COMMANDS)
	$(SED)	-e 's/%VER%/$(VRA_VERSION_STRING_RAW)/' \
		-e 's/%VER_EXT%/$(VRA_VERSION_STRING)/' \
		--output $@ $<

#
# Generate the list of CRT DLLs.
#
ifndef TOOL_$(VRA_VCC_TOOL)
 include $(KBUILD_PATH)/tools/$(VRA_VCC_TOOL).kmk
endif
$(call KB_FN_AUTO_CMD_DEPS,$(VRA_WIN_INST_OUT_DIR)/VBoxCrtDlls.wxi)
$(VRA_WIN_INST_OUT_DIR)/VBoxCrtDlls.wxi: | $$(dir $$@)
	$(call KB_FN_AUTO_CMD_DEPS_COMMANDS)
	$(APPEND) -t -n $@ \
		'<?xml version="1.0" ?>' \
		'<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">' \
		$(foreach dll \
		,$(if-expr "$(VRA_VCC_TOOL_STEM)"=="VCC100",msvcr100.dll msvcp100.dll \
		  ,$(if-expr "$(VRA_VCC_TOOL_STEM)"=="VCC110",msvcr110.dll msvcp110.dll \
                   ,$(TOOL_$(VRA_VCC_TOOL)_REDIST_CRT_DLLS) $(TOOL_$(VRA_VCC_TOOL)_REDIST_CPP_DLLS))) \
        	 $(if-expr "$(KBUILD_TYPE)"=="asan",clang_rt.asan_dynamic-x86_64.dll,) \
               ,'  <File Id="file_$(translate $(dll),-,_)" Name="$(dll)" Source="$$(env.PATH_OUT)\bin\$(dll)" />') \
		'</Include>'

#
# Generate the list of 32-bit CRT DLLs.
#
ifndef TOOL_$(VRA_VCC_TOOL_STEM)X86
 include $(KBUILD_PATH)/tools/$(VRA_VCC_TOOL_STEM)X86.kmk
endif
$(call KB_FN_AUTO_CMD_DEPS,$(VRA_WIN_INST_OUT_DIR)/VBoxCrtDlls32.wxi)
$(VRA_WIN_INST_OUT_DIR)/VBoxCrtDlls32.wxi: | $$(dir $$@)
	$(call KB_FN_AUTO_CMD_DEPS_COMMANDS)
	$(APPEND) -t -n $@ \
		'<?xml version="1.0" ?>' \
		'<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">' \
		$(foreach dll \
		,$(if-expr "$(VRA_VCC_TOOL_STEM)"=="VCC100",msvcr100.dll msvcp100.dll \
		  ,$(if-expr "$(VRA_VCC_TOOL_STEM)"=="VCC110",msvcr110.dll msvcp110.dll \
                   ,$(TOOL_$(VRA_VCC_TOOL_STEM)X86_REDIST_CRT_DLLS) $(TOOL_$(VRA_VCC_TOOL_STEM)X86_REDIST_CPP_DLLS))) \
        	 $(if-expr "$(KBUILD_TYPE)"=="asan",clang_rt.asan_dynamic-i386.dll,) \
               ,'  <File Id="file_$(translate $(dll),-,_)_x86" Name="$(dll)" Source="$$(env.PATH_OUT)\bin\x86\$(dll)" DiskId="$$(var.Property_DiskIdCommon)" />') \
		'</Include>'
#
# Generate the list of unattended template script files.
#
$(call KB_FN_AUTO_CMD_DEPS,$(VRA_WIN_INST_OUT_DIR)/VBoxUnattendedTemplateComponent.wxi)
$(VRA_WIN_INST_OUT_DIR)/VBoxUnattendedTemplateComponent.wxi: | $$(dir $$@)
	$(call KB_FN_AUTO_CMD_DEPS_COMMANDS)
	$(APPEND) -t -n $@ \
		'<?xml version="1.0" ?>' \
		'<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">'
ifdef VRA_UNATTENDED_TEMPLATES
	$(APPEND) -n $@ \
		'  <Directory Id="dir_VBoxUnattendedTemplates" Name="UnattendedTemplates">' \
		'    <Component Id="cp_UnattendedTemplates" Guid="0571550d-aaa5-4723-c17b-5ddcc29f5686" Bitness="$$(var.Property_Bitness)">' \
		$(foreach file,$(VRA_UNATTENDED_TEMPLATES), \
		'      <File Id="file_$(file)" Name="$(file)" Source="$$(env.PATH_OUT)\bin\UnattendedTemplates\$(file)" />') \
		'    </Component>' \
		'  </Directory>'
endif
	$(APPEND) $@ '</Include>'


#
# Build the multi-language version of the .MSI installer (final installer).
#
# This is done by creating binary .MST diffs of all the language-specific installers
# against the en_US one, and then merging the diffs into the en_US one using tools
# from the MS Installer SDK.
#
# Only contains the minimal set of stuff to get a language-specific .msi built.
# We also don't need waste time to compress anything here.
#
# See also https://github.com/wixtoolset/issues/issues/7544 which requests a
# simpler way of doing this.
#
define def_vbox_create_mst
 $(VRA_WIN_INST_OUT_DIR)/$(lang)/$(lang).mst \
 + $(VRA_WIN_INST_REPACK_DIR)/$(lang).mst: \
 		$(VRA_WIN_INST_OUT_DIR)/en_US/$(PACKAGE_NAME_LANG)_en_US.msi \
 		$(VRA_WIN_INST_OUT_DIR)/NLS/Language_$(lang).wxl \
 		$(VRA_WIN_INST_OUT_DIR)/NLS/License_$(lang).wxl \
 		$(PATH_STAGE_BIN)/VBoxInstallHelper.dll \
 		$(VRA_SVN_REV_KMK) \
 		$(VRA_WIN_INST_MAKEFILE_DEP) \
 		$(if-expr defined(VRA_WITH_MSI_HACK),$(MsiHack_0_OUTDIR)/MsiHack.dll,) \
 		$(if-expr defined(VRA_WITH_MSI_HACK),$(MsiHack_0_OUTDIR)/MsiHackExtension.dll,) \
 		| $$$$(dir $$$$@) $(VRA_WIN_INST_REPACK_DIR)/
	$(RM) -f -- "$$@"
	$(call MSG_L1,Creating language diff for $(lang))
	kmk_time $$(REDIRECT_EXT) -E WIX_TEMP='$$(subst /,\,$$(@D))' $(VRA_WIN_INST_ENV) \
		-- $(VRA_TOOLS_WIN_WIX_BIN) build \
		-arch "$(VRA_INS_PROD_ARCH)" \
		-defaultcompressionlevel none \
		-intermediatefolder $$(@D)/wix-temp/ \
		-loc $(VRA_WIN_INST_OUT_DIR)/NLS/Language_$(lang).wxl \
		-loc $(VRA_WIN_INST_OUT_DIR)/NLS/License_$(lang).wxl \
		-lib $(VRA_WIN_INST_OUT_DIR)/VirtualAgent_en_US.wixlib \
		-ext $(VRA_TOOLS_WIN_WIXEXT_DIR)/WixToolset.Util.wixext.dll \
		-pdbtype none \
		-out $$(@D)/$(PACKAGE_NAME_LANG)_$(lang).msi
	$(VRA_TOOLS_WIN_WIX_BIN) msi transform -t language -intermediateFolder "$$(@D)/wix-temp/" \
		"$$<" "$$(@D)/$(PACKAGE_NAME_LANG)_$(lang).msi" -out "$$@"
	$(CP) -f -- "$(VRA_WIN_INST_OUT_DIR)/$(lang)/$(lang).mst" "$(VRA_WIN_INST_REPACK_DIR)/$(lang).mst"
	$(RM) -Rf -- "$$(@D)/$(PACKAGE_NAME_LANG)_$(lang).msi" \
		"$$(@D)/wix-temp/" \
		"$$(@D)/common.cab"

endef

$(foreach lang,$(filter-out en_US, $(VRA_INSTALLER_LANGUAGES)), \
	$(eval local lang_id := $(VRA_BRAND_$(lang)_LANG_ID)) \
	$(eval $(def_vbox_create_mst)))


# Create WISUMINFO argument.
VRA_INS_PROD_LANG := 7="$(VRA_INS_PROD_ARCH);1033
$(foreach lang, $(filter-out en_US,$(VRA_INSTALLER_LANGUAGES))\
	, $(eval VRA_INS_PROD_LANG := $(VRA_INS_PROD_LANG)$(COMMA)$(VRA_BRAND_$(lang)_LANG_ID)))
VRA_INS_PROD_LANG := $(VRA_INS_PROD_LANG)"

# The multilingual installer rule.
$(call KB_FN_AUTO_CMD_DEPS,$(VRA_WIN_INST_OUT_DIR)/$(PACKAGE_NAME_LANG).msi)
$(VRA_WIN_INST_OUT_DIR)/$(PACKAGE_NAME_LANG).msi \
+ $(VRA_WIN_INST_REPACK_DIR)/2-multilingual-$(PACKAGE_NAME_LANG).cmd: \
		$(VRA_WIN_INST_OUT_DIR)/en_US/$(PACKAGE_NAME_LANG)_en_US.msi \
		$(foreach lang,$(filter-out en_US,$(VRA_INSTALLER_LANGUAGES)),$(VRA_WIN_INST_OUT_DIR)/$(lang)/$(lang).mst)
	$(call KB_FN_AUTO_CMD_DEPS_COMMANDS)
	$(call MSG_L1,Creating final multilingual MSI)
	$(QUIET)$(RM) -f -- \
		$(wildcard $(@D)/$(PACKAGE_BASE)-r*.msi $(VRA_WIN_INST_REPACK_DIR)/2-multilingual-$(PACKAGE_BASE)-r*.cmd )
	$(CP) -f -- "$<" "$@"
# Add non-english languages.
	$(foreach lang,$(filter-out en_US,$(VRA_INSTALLER_LANGUAGES)), \
		$(NLTAB)$(REDIRECT) -C "$(@D)/$(lang)" -- $(VRA_PATH_MSIDB) -d "$@" -r "$(lang).mst" \
		$(NLTAB)$(REDIRECT) -C "$(@D)/$(lang)" -- cscript.exe /nologo $(VRA_PATH_WISUBSTG) $@ $(lang).mst $(VRA_BRAND_$(lang)_LANG_ID) )
# Display MSI details.
	$(REDIRECT) -C $(@D) -- cscript.exe /nologo $(VRA_PATH_WISUBSTG) $(@F)
	$(REDIRECT) -C $(@D) -- cscript.exe /nologo $(VRA_PATH_WISUMINFO) $@
# Update the list of language IDs (starts with platform/arch).
	$(REDIRECT) -C $(@D) -- cscript.exe /nologo $(VRA_PATH_WISUMINFO) $@ $(VRA_INS_PROD_LANG)
# Display updated MSI details.
	$(REDIRECT) -C $(@D) -- cscript.exe /nologo $(VRA_PATH_WISUMINFO) $@
# Finally, sign it.
	$(call VRA_SIGN_MSI_FN,$@,$(VRA_PRODUCT) $(VRA_VERSION_STRING)r$(VRA_SVN_REV) ($(KBUILD_TARGET_ARCH)),,,disable-dual-signing)
# Create repack script for this step.
	$(APPEND) -nt "$(VRA_WIN_INST_REPACK_DIR)/2-multilingual-$(PACKAGE_NAME_LANG).cmd" \
		'if ".%KBUILD_DEVTOOLS%" == "." (echo KBUILD_DEVTOOLS is not set & exit /b1)' \
		'if ".%KBUILD_BIN_PATH%" == "." (echo KBUILD_BIN_PATH is not set & exit /b1)' \
		'copy /y  "$(<F)" "$(@F)" || exit /b1' \
		$(subst $(KBUILD_BIN_PATH),%KBUILD_BIN_PATH%,$(subst $(KBUILD_DEVTOOLS),%KBUILD_DEVTOOLS%,\
		$(foreach lang,$(filter-out en_US,$(VRA_INSTALLER_LANGUAGES)), \
			'$(VRA_PATH_MSIDB) -d $(@F) -r $(lang).mst || exit /b1' \
			'cscript.exe /nologo $(VRA_PATH_WISUBSTG) $(@F) $(lang).mst $(VRA_BRAND_$(lang)_LANG_ID) || exit /b1') \
		'cscript.exe /nologo $(VRA_PATH_WISUBSTG) $(@F) || exit /b1' \
		'cscript.exe /nologo $(VRA_PATH_WISUMINFO) $(@F) $(VRA_INS_PROD_LANG) || exit /b1' \
		'call sign-sha1.cmd $(@F) || exit /b1' \
		) ) \
		$(if-expr defined(VRA_WITH_COMBINED_PACKAGE),'copy /y "$(@F)" "$(notdir $(PACKAGE_NAME_FINAL))" || exit /b1',) \
		'@echo Created multilanguage MSI: $(notdir $(PACKAGE_NAME_FINAL))'
# Validation.  Currently there is a list of grievances, we ignore it. (TODO: Fix errors.)
	$(call MSG_L1,Start validation of "$@")
	$(REDIRECT) -- $(VRA_TOOLS_WIN_WIX_BIN) msi validate "$@"
	$(call MSG_L1,Finished validating "$@")


# Copy multilingual installer to bin, deleting any older .msi files to avoid wasting space.
$(PACKAGE_NAME_FINAL): $(VRA_WIN_INST_OUT_DIR)/$(PACKAGE_NAME_LANG).msi | $$(dir $$@)
	$(QUIET)$(RM) -f $(wildcard $(@D)/$(PACKAGE_BASE)-r*$(if-expr defined(VRA_WITH_COMBINED_PACKAGE),_$(KBUILD_TARGET_ARCH),).msi)
	$(INSTALL_STAGING) -- $< $@


if defined(VRA_WITH_COMBINED_PACKAGE) && "$(KBUILD_TARGET_ARCH)" == "amd64"
 #
 # Make the multi-architecture installer by calling our stub builder
 # with both platform installers (amd64 and arm64) + common cab. The common
 # cab only is needed when we don't use merge modules. We only
 # need to do this once; so do it on amd64 only.
 #
 $(PATH_STAGE_BIN)/$(PACKAGE_NAME_MULTIARCH_FINAL) \
 + $(VRA_WIN_INST_REPACK_DIR)/3-multiarch-$(PACKAGE_NAME_MULTIARCH_FINAL).cmd: \
 		$(PATH_MULTIARCH_TEMP)/$(PACKAGE_NAME_MULTIARCH.amd64) \
 		$(PATH_MULTIARCH_TEMP)/$(PACKAGE_NAME_MULTIARCH.arm64) \
 		$(PATH_STAGE_BIN)/VBoxStub.exe \
 		$$(VBoxStubBld_1_TARGET)
	$(call MSG_L1,Building Windows combined package)
	$(QUIET)$(RM) -f -- $(wildcard $(subst r$(VRA_SVN_REV),r*, \
		$@ \
		$(VRA_WIN_INST_REPACK_DIR)/3-multiarch-$(PACKAGE_NAME_MULTIARCH_FINAL).cmd ) )
	$(if-expr defined(VRA_WITH_MSM_INSTALL),,$(call VRA_SIGN_CAB_FN,$(PACKAGE_NAME_MULTIARCH_COMMONCAB)))
	$(REDIRECT) -C $(@D) -- \
		$(VBoxStubBld_1_TARGET) -out $@ \
			-target-amd64 $(PATH_MULTIARCH_TEMP)/$(PACKAGE_NAME_MULTIARCH.amd64) \
			-target-arm64 $(PATH_MULTIARCH_TEMP)/$(PACKAGE_NAME_MULTIARCH.arm64) \
			$(if-expr defined(VRA_WITH_MSM_INSTALL),,-target-all $(PACKAGE_NAME_MULTIARCH_COMMONCAB)) \
			-stub $(PATH_STAGE_BIN)/VBoxStub.exe
	$(VRA_VCC_EDITBIN) /IntegrityCheck:NO $@
	$(call VRA_SIGN_FILE_FN,$@)
 # Create repack script for this step.
	$(APPEND) -nt "$(VRA_WIN_INST_REPACK_DIR)/3-multiarch-$(@F).cmd" \
		'if ".%KBUILD_DEVTOOLS%" == "." (echo KBUILD_DEVTOOLS is not set & exit /b1)' \
		'if ".%KBUILD_BIN_PATH%" == "." (echo KBUILD_BIN_PATH is not set & exit /b1)' \
		$(subst $(KBUILD_BIN_PATH),%KBUILD_BIN_PATH%,$(subst $(KBUILD_DEVTOOLS),%KBUILD_DEVTOOLS%, \
		$(if-expr defined(VRA_WITH_MSM_INSTALL), \
		,'call sign-dual.cmd ../../../win.amd64/$(KBUILD_TYPE)/repack/$(notdir $(PACKAGE_NAME_MULTIARCH_COMMONCAB)) || exit /b1') \
		'..\bin\VBoxStubBld.exe ^' \
		'  -out $(@F) ^' \
		'  -target-amd64 $(PACKAGE_NAME_MULTIARCH.amd64) ^' \
		'  -target-arm64 ../../../win.arm64/$(KBUILD_TYPE)/repack/$(PACKAGE_NAME_MULTIARCH.arm64) ^' \
		$(if-expr defined(VRA_WITH_MSM_INSTALL),\
		,'  -target-all $(notdir $(PACKAGE_NAME_MULTIARCH_COMMONCAB)) ^' ) \
		'  -stub ../bin/VBoxStub.exe || exit /b1' \
		'$(VRA_VCC_EDITBIN) /IntegrityCheck:NO $(@F) || exit /b1' \
		'call sign-dual.cmd $(@F) || exit /b1' \
		) ) \
		'@echo Created multiarch EXE: $(@F)'
else
 #
 # We still do the installer stub thing even if we only ship 64-bit, because we've
 # gotten used to having it around to install the certificate and such.
 #
 $(PATH_STAGE_BIN)/$(PACKAGE_NAME_MULTIARCH_FINAL) \
 + $(VRA_WIN_INST_REPACK_DIR)/3-multiarch-$(PACKAGE_NAME_MULTIARCH_FINAL).cmd: \
 		$(PACKAGE_NAME_FINAL) \
 		$(PATH_STAGE_BIN)/VBoxStub.exe \
 		$$(VBoxStubBld_1_TARGET)
	$(call MSG_L1,Building Windows package w/ installer stub)
	$(QUIET)$(RM) -f -- $(wildcard $(subst r$(VRA_SVN_REV),r*, \
		$@ \
		$(VRA_WIN_INST_REPACK_DIR)/3-multiarch-$(PACKAGE_NAME_MULTIARCH_FINAL).cmd ) )
	$(REDIRECT) -C "$(@D)" -- \
		$(VBoxStubBld_1_TARGET) -out $@ \
			-target-$(KBUILD_TARGET_ARCH) $(PACKAGE_NAME_FINAL) \
			-stub $(PATH_STAGE_BIN)/VBoxStub.exe
	$(VRA_VCC_EDITBIN) /IntegrityCheck:NO $@
	$(call VRA_SIGN_FILE_FN,$@,,,,,,timed)
 # Create repack script for this step.
	$(APPEND) -nt "$(VRA_WIN_INST_REPACK_DIR)/3-multiarch-$(@F).cmd" \
		'if ".%KBUILD_DEVTOOLS%" == "." (echo KBUILD_DEVTOOLS is not set & exit /b1)' \
		'if ".%KBUILD_BIN_PATH%" == "." (echo KBUILD_BIN_PATH is not set & exit /b1)' \
		$(subst $(KBUILD_BIN_PATH),%KBUILD_BIN_PATH%,$(subst $(KBUILD_DEVTOOLS),%KBUILD_DEVTOOLS%, \
		'..\bin\VBoxStubBld.exe ^' \
		'  -out $(@F) ^' \
		'  -target-$(KBUILD_TARGET_ARCH) $(notdir $(PACKAGE_NAME_FINAL)) ^' \
		'  -stub ../bin/VBoxStub.exe || exit /b1' \
		'$(VRA_VCC_EDITBIN) /IntegrityCheck:NO $(@F) || exit /b1' \
		'call sign-dual.cmd $(@F) || exit /b1' \
		) ) \
		'@echo Created multiarch EXE: $(@F)'
endif

#
# Repackaging scripts and files.
#
INSTALLS += RePackScripts
RePackScripts_TEMPLATE = DUMMY
RePackScripts_INST = repack/
RePackScripts_INSTTYPE = stage
RePackScripts_SOURCES = \
	Scripts/UnpackBlessedDrivers.cmd \
	$(RePackScripts_0_OUTDIR)/PackDriversForSubmission.cmd \
	$(RePackScripts_0_OUTDIR)/sign-dual.cmd \
	$(RePackScripts_0_OUTDIR)/sign-sha1.cmd \
	$(if-expr defined(VRA_SIGN_EV_FILE_FN),$(RePackScripts_0_OUTDIR)/sign-ev.cmd,) \
	$(RePackScripts_0_OUTDIR)/VMMR0.inf \
	$(RePackScripts_0_OUTDIR)/VBoxExtPackPuel.inf
if !defined(VRA_WITH_COMBINED_PACKAGE) || "$(KBUILD_TARGET_ARCH)" == "amd64"
 RePackScripts_SOURCES += \
 	$(RePackScripts_0_OUTDIR)/RepackExtPack.cmd
endif
ifdef VRA_WITH_COMBINED_PACKAGE
 if "$(KBUILD_TARGET_ARCH)" == "amd64"
  RePackScripts_SOURCES += \
  	$(RePackScripts_0_OUTDIR)/Combined-1-Prepare.cmd \
  	$(RePackScripts_0_OUTDIR)/Combined-3-Repack.cmd \
  	$(RePackScripts_0_OUTDIR)/Combined-3-RepackAdditions.cmd
 endif
else
 RePackScripts_SOURCES += \
 	$(RePackScripts_0_OUTDIR)/Single-1-Prepare.cmd \
 	$(RePackScripts_0_OUTDIR)/Single-3-Repack.cmd

 ifndef VRA_OSE
  RePackScripts_SOURCES += \
  	$(RePackScripts_0_OUTDIR)/Single-0-All.cmd
 endif

endif
RePackScripts_CLEAN = \
	$(RePackScripts_0_OUTDIR)/PackDriversForSubmission.cmd \
	$(RePackScripts_0_OUTDIR)/sign-dual.cmd \
	$(RePackScripts_0_OUTDIR)/sign-sha1.cmd \
	$(RePackScripts_0_OUTDIR)/sign-ev.cmd \
	$(RePackScripts_0_OUTDIR)/VMMR0.inf \
	$(RePackScripts_0_OUTDIR)/VBoxExtPackPuel.inf

$(call VRA_EDIT_VERSION_AND_BUILD_RULE_FN,RePackScripts,Scripts/PackDriversForSubmission.cmd,PackDriversForSubmission.cmd)
$(call VRA_EDIT_VERSION_AND_BUILD_RULE_FN,RePackScripts,Scripts/RepackExtPack.cmd,RepackExtPack.cmd)
ifdef VRA_WITH_COMBINED_PACKAGE
 $(call VRA_EDIT_VERSION_AND_BUILD_RULE_FN,RePackScripts,Scripts/Combined-1-Prepare.cmd,Combined-1-Prepare.cmd)
 $(call VRA_EDIT_VERSION_AND_BUILD_RULE_FN,RePackScripts,Scripts/Combined-3-Repack.cmd,Combined-3-Repack.cmd)
 $(call VRA_EDIT_VERSION_AND_BUILD_RULE_FN,RePackScripts,Scripts/Combined-3-RepackAdditions.cmd,Combined-3-RepackAdditions.cmd)
else
 ifndef VRA_OSE
  $(call VRA_EDIT_VERSION_AND_BUILD_RULE_FN,RePackScripts,Scripts/Single-0-All.cmd,Single-0-All.cmd)
 endif
 $(call VRA_EDIT_VERSION_AND_BUILD_RULE_FN,RePackScripts,Scripts/Single-1-Prepare.cmd,Single-1-Prepare.cmd)
 $(call VRA_EDIT_VERSION_AND_BUILD_RULE_FN,RePackScripts,Scripts/Single-3-Repack.cmd,Single-3-Repack.cmd)
endif

$$(RePackScripts_0_OUTDIR)/sign-dual.cmd: | $$(dir $$@)
	$(APPEND) -nt "$@" \
		'if ".%KBUILD_DEVTOOLS%" == "." (echo KBUILD_DEVTOOLS is not set & exit /b 1)' \
		'if ".%KBUILD_BIN_PATH%" == "." (echo KBUILD_BIN_PATH is not set & exit /b 1)' \
		'if ".%1" == "." (echo No .cat file specified & exit /b 1)' \
		$(subst /win-6.1/,/win-rel/,$(subst $(KBUILD_BIN_PATH),%KBUILD_BIN_PATH%,$(subst $(KBUILD_DEVTOOLS),%KBUILD_DEVTOOLS%, \
		'( $(call VRA_SIGN_FILE_FN,%1,$(VRA_PRODUCT) $(VRA_VERSION_STRING)r$(VRA_SVN_REV) ($(KBUILD_TARGET_ARCH)),,,,&&) ) || exit /b1' \
		) ) )

$$(RePackScripts_0_OUTDIR)/sign-sha1.cmd: | $$(dir $$@)
	$(APPEND) -nt "$@" \
		'if ".%KBUILD_DEVTOOLS%" == "." (echo KBUILD_DEVTOOLS is not set & exit /b 1)' \
		'if ".%KBUILD_BIN_PATH%" == "." (echo KBUILD_BIN_PATH is not set & exit /b 1)' \
		'if ".%1" == "." (echo No .cat file specified & exit /b 1)' \
		$(subst $(KBUILD_BIN_PATH),%KBUILD_BIN_PATH%,$(subst $(KBUILD_DEVTOOLS),%KBUILD_DEVTOOLS%, \
		'( $(call VRA_SIGN_FILE_FN,%1,$(VRA_PRODUCT) $(VRA_VERSION_STRING)r$(VRA_SVN_REV) ($(KBUILD_TARGET_ARCH)),,,disable-dual-signing,&&) ) || exit /b1' \
		) )

# The %~dp1\ oddity is working around otherwise ending with \" during
# expansion of the CCS command line which for a reason I cannot immediately
# understand appends a " to the path.
$$(RePackScripts_0_OUTDIR)/sign-ev.cmd: | $$(dir $$@)
	$(APPEND) -nt "$@" \
		'if ".%KBUILD_DEVTOOLS%" == "." (echo KBUILD_DEVTOOLS is not set & exit /b 1)' \
		'if ".%KBUILD_BIN_PATH%" == "." (echo KBUILD_BIN_PATH is not set & exit /b 1)' \
		'if ".%1" == "." (echo No .cab file specified & exit /b 1)' \
		$(subst $(KBUILD_BIN_PATH),%KBUILD_BIN_PATH%,$(subst $(KBUILD_DEVTOOLS),%KBUILD_DEVTOOLS%, \
		'( $(call VRA_SIGN_EV_FILE_FN,%1,%~dp1\) ) || exit /b1' \
		) )

$$(RePackScripts_0_OUTDIR)/VMMR0.inf: $(PATH_SUB_CURRENT)/Scripts/VMMR0.inf $(MAKEFILE_CURRENT) | $$(dir $$@)
	$(call MSG_GENERATE,RePackScripts,$@,$<)
	$(call VRA_EDIT_INF_FN,$<,$@)
$$(RePackScripts_0_OUTDIR)/VBoxExtPackPuel.inf: $(PATH_SUB_CURRENT)/Scripts/VBoxExtPackPuel.inf $(MAKEFILE_CURRENT) | $$(dir $$@)
	$(call MSG_GENERATE,RePackScripts,$@,$<)
	$(call VRA_EDIT_INF_FN,$<,$@)

vbox_uninstall:
	@kmk_builtin_echo "Uninstalling VirtualAgent ..."
	@kmk_builtin_echo ""
	@powershell -Command "Start-Process -Wait powershell -Verb RunAs -ArgumentList '-NoProfile -ExecutionPolicy Bypass -File \"$(PATH_SUB_CURRENT)/Scripts/vbox_uninstall.ps1\" \"*VirtualAgent*\"'"

include $(FILE_KBUILD_SUB_FOOTER)

SUB_DEPTH = ../../../..
include $(KBUILD_PATH)/subheader.kmk


#
# Globals
#
VRA_PATH_DI_SRC := $(PATH_SUB_CURRENT)
VRA_DI_OUT_DIR  := $(PATH_TARGET)/Installer/darwin
BLDDIRS += $(VRA_DI_OUT_DIR)

VRA_DI_FN_DEP_BOTH = $(VRA_PATH_DIST)/$1
ifeq ($(KBUILD_TARGET_ARCH),x86)
 VRA_DI_FN_DEP_32  = $(VRA_PATH_DIST)/$1
 VRA_DI_FN_DEP_64  =
else
 VRA_DI_FN_DEP_64  = $(VRA_PATH_DIST)/$1
 VRA_DI_FN_DEP_32  =
endif
VRA_PATH_DIST_OTHER = $(error VRA_PATH_DIST_OTHER used in a non-combined package deal)

VRA_QT_VERSION_MAJOR = A

ifeq ($(KBUILD_TARGET_ARCH),arm64)
 VRA_DI_TARGET_ARCH = arm64
 VRA_DI_ARCH_LIST   = arm64
else # Assume amd64 for now
 VRA_DI_TARGET_ARCH = x86_64
 VRA_DI_ARCH_LIST   = i386,arm64
endif

# Unset this to speed up things during makefile hacking.
VRA_DARWIN_INST_DEP_ON_MAKEFILE := $(MAKEFILE_CURRENT)

# The location of the pkgbuild program.
ifndef VRA_PKGBUILD
 VRA_PKGBUILD := pkgbuild
endif

# The location of the productbuild program.
ifndef VRA_PRODUCTBUILD
 VRA_PRODUCTBUILD := productbuild
endif

# Where we do the packing (override this in LocalConfig.kmk if building on smbfs).
ifndef VRA_PATH_PACK_TMP
 VRA_PATH_PACK_TMP := $(VRA_DI_OUT_DIR)
endif

# Shorthand for $(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.root/Applications/VirtualAgent.app
VRA_PATH_VRA_APP_TMP := $(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.root/Applications/VirtualAgent.app


#
# Install the darwin docs/license.
#
INSTALLS += darwin-docs
darwin-docs_INST = $(INST_DIST)
darwin-docs_MODE = a+r,u+w
darwin-docs_SOURCES = \
	$(VRA_BRAND_LICENSE_TXT)=>LICENSE


#
# The packing.
#
PACKING += $(VRA_PATH_DIST)/VirtualAgent-$(VRA_VERSION_STRING)-r$(VRA_SVN_REV).dmg
OTHER_CLEAN = $(VRA_DMG_SHADOW_STORAGE)


include $(FILE_KBUILD_SUB_FOOTER)


#
# We're running commands as root here, take some care and assertion
# a sane environment.
#
ifeq ($(strip $(VRA_PATH_DIST)),)
 $(error VRA_PATH_DIST=$(VRA_PATH_DIST))
endif
ifeq ($(strip $(VRA_PATH_DIST)),/)
 $(error VRA_PATH_DIST=$(VRA_PATH_DIST))
endif
ifeq ($(strip $(VRA_PATH_PACK_TMP)),)
 $(error VRA_PATH_PACK_TMP=$(VRA_PATH_PACK_TMP))
endif
ifeq ($(strip $(VRA_PATH_PACK_TMP)),/)
 $(error VRA_PATH_PACK_TMP=$(VRA_PATH_PACK_TMP))
endif


# Check for additional manuals
VRA_ADD_MANUALS := $(foreach f,$(VRA_MANUAL_ADD_LANGUAGES),$(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/UserManual_$(f).pdf)

VRA_ADD_MANUAL_de_DE := $(filter $(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/UserManual_de_DE.pdf,$(VRA_ADD_MANUALS))
VRA_ADD_MANUAL_fr_FR := $(filter $(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/UserManual_fr_FR.pdf,$(VRA_ADD_MANUALS))

#
# The disk image.
#
$(VRA_PATH_DIST)/VirtualAgent-$(VRA_VERSION_STRING)-r$(VRA_SVN_REV).dmg: \
		$(VRA_PATH_PACK_TMP)/DiskImage/VirtualAgent.pkg \
		$(VRA_BRAND_DARWIN_DISKIMAGE_BG) \
		$(VRA_BRAND_DARWIN_DISKIMAGE_DS_STORE) \
		$$(wildcard $(VRA_PATH_DI_SRC)/DiskImage/*) \
		$(if $(VRA_WITH_DOCS_PACKING), \
			$(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/UserManual.pdf \
			$(VRA_ADD_MANUALS)) \
		$(VRA_DARWIN_INST_DEP_ON_MAKEFILE)
	$(call MSG_TOOL,hdiutil,,,$@)
	@# Cleanup any previously failed attempts and various trash.
	sudo rm -Rf $(VRA_PATH_PACK_TMP)/DiskImage.tmp
	$(MKDIR) -p $(VRA_PATH_PACK_TMP)/DiskImage.tmp/
	sudo mv $(VRA_PATH_PACK_TMP)/DiskImage/VirtualAgent.pkg $(VRA_PATH_PACK_TMP)/DiskImage.tmp/
	sudo rm -Rf \
		$@ \
		$(VRA_PATH_PACK_TMP)/DiskImage/
	sudo mv $(VRA_PATH_PACK_TMP)/DiskImage.tmp $(VRA_PATH_PACK_TMP)/DiskImage
	@# Remove .dmg packages from old depend builds
	$(QUIET)$(RM) -f $(wildcard $(VRA_PATH_DIST)/VirtualAgent-*-r*.dmg)
	@# Populate the image with uninstaller, readme, picture, and .VolumeIcon.icns. (TODO)
	$(INSTALL) $(VRA_PATH_DI_SRC)/DiskImage/VirtualAgent_Uninstall.tool  $(VRA_PATH_PACK_TMP)/DiskImage/
ifdef VRA_SIGNING_MODE
	$(call VRA_SIGN_FILE_FN,$(VRA_PATH_PACK_TMP)/DiskImage/VirtualAgent_Uninstall.tool,org.virtualbox.dmg.uninstaller)
	@# Code signing (the non-local one) seems to be losing the execute permission.
	chmod 0755 $(VRA_PATH_PACK_TMP)/DiskImage/VirtualAgent_Uninstall.tool
endif
ifeq (1,1)
	@# Pedantic mode...
	$(INSTALL) -m 644 $(VRA_BRAND_DARWIN_DISKIMAGE_DS_STORE)           $(VRA_PATH_PACK_TMP)/DiskImage/.DS_Store
	$(MKDIR) $(VRA_PATH_PACK_TMP)/DiskImage/.background
	$(INSTALL) -m 644 $(VRA_BRAND_DARWIN_DISKIMAGE_BG)                 $(VRA_PATH_PACK_TMP)/DiskImage/.background/vbox_folder.tiff
 ifdef VRA_WITH_BUNDLED_INSTALLER
	$(if $(VRA_WITH_DOCS_PACKING), \
		$(INSTALL) -m 644 $(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/UserManual.pdf $(VRA_PATH_PACK_TMP)/DiskImage/User\ Manual.pdf$(NLTAB) \
		$(if $(VRA_ADD_MANUAL_de_DE),$(INSTALL) -m 644 $(VRA_ADD_MANUAL_de_DE) "$(VRA_PATH_PACK_TMP)/DiskImage/$(VRA_BRAND_de_DE_MANUAL_NAME).pdf"$(NLTAB)) \
		$(if $(VRA_ADD_MANUAL_fr_FR),$(INSTALL) -m 644 $(VRA_ADD_MANUAL_fr_FR) "$(VRA_PATH_PACK_TMP)/DiskImage/$(VRA_BRAND_fr_FR_MANUAL_NAME).pdf"$(NLTAB)))
  # Rename the main package
 else
	$(if $(VRA_WITH_DOCS_PACKING), $(INSTALL) $(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/UserManual.pdf $(VRA_PATH_PACK_TMP)/DiskImage/)
	$(LN) -s /Applications/                                             $(VRA_PATH_PACK_TMP)/DiskImage/Applications
 endif
endif
	@# hdiutil of OS X 10.10 adds a .Trashes directory and some suggest this may upset the image size calculations (-5341).
	$(MKDIR) -m 1333  $(VRA_PATH_PACK_TMP)/DiskImage/.Trashes
	@# Change the owners.
	sudo chown -R root:admin $(VRA_PATH_PACK_TMP)/DiskImage
	@# Create the image. We calculate the size our selves, adding 32MB (was 16MB) for fudging (min 13MB fudge needed on high sierra).
	sudo hdiutil create -format UDBZ -volname "VirtualAgent" -srcfolder "$(VRA_PATH_PACK_TMP)/DiskImage" \
		-size $(DOLLAR)((`sudo /usr/bin/du -sk "$(VRA_PATH_PACK_TMP)/DiskImage/" | /usr/bin/cut -f1` + 32768))k \
		"$@"
	@# Change (back) the owner so it can be deleted by the user.
	sudo chown "$(shell whoami)" "$@"
	sudo chown -R "$(shell whoami)" $(VRA_PATH_PACK_TMP)/DiskImage
	@# Make sure to delete any old shadow storage for the disk image to prevent mounting the newly build disk image
	@# due to a mismatch.
	sudo kmk_rm -f $(VRA_DMG_SHADOW_STORAGE)
ifdef VRA_SIGNING_MODE
 ifndef VRA_WITHOUT_SIGNED_DMG
	@# Sign the created dmg.
	$(call VRA_SIGN_DMG_FN,$@,org.virtualbox.dmg)
  if $(intersects darwin darwin_notarize all 1,$(VRA_WITH_CORP_CODE_SIGNING))
	@# Notarize the signed dmg (includes stapling).
	$(call VRA_NOTARIZE_FILE_FN,$@,org.virtualbox.VirtualAgent.$(VRA_VERSION_MAJOR).$(VRA_VERSION_MINOR).$(VRA_VERSION_BUILD).$(VRA_SVN_REV),$(call VRA_DIRX,$@).tmp)
	$(MV) -f $(call VRA_DIRX,$@).tmp/$(call VRA_NOTDIRX,$@) $@
	$(RMDIR) $(call VRA_DIRX,$@).tmp
  endif
 endif
endif

#
# The meta-package.
#
$(VRA_PATH_PACK_TMP)/DiskImage/VirtualAgent.pkg: \
		$(if $(VRA_WITH_VRADRV), $(VRA_PATH_PACK_TMP)/Packages/VBoxKEXTs.pkg) \
		$(VRA_PATH_PACK_TMP)/Packages/VirtualAgentCLI.pkg \
		$(VRA_PATH_PACK_TMP)/Packages/VirtualAgent.pkg \
		$$(wildcard \
			$(VRA_PATH_DI_SRC)/VirtualAgent_mpkg/* \
			$(VRA_PATH_DI_SRC)/VirtualAgent_mpkg/*.lproj/*) \
		$(foreach f,$(VRA_INSTALLER_ADD_LANGUAGES), $(VRA_BRAND_$(f)_VIRTUALBOX_WELCOME_RTF)) \
		$(if $(VRA_WITH_FUSE_PACKING), $(VRA_PATH_PACK_TMP)/Packages/OSXFuseCore.pkg) \
		$(VRA_DARWIN_INST_DEP_ON_MAKEFILE)
	$(call MSG_TOOL,productbuild,,,$@)
	@# Cleanup any previously failed attempts.
	sudo rm -Rf \
		$@ \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.dist.root \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.dist.desc \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.dist.res
	@# Correct directory permissions are important.
	$(MKDIR) -p \
		$(@D) \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.dist.desc \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.dist.res \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.dist.res/English.lproj
	@# Do keyword replacement in the package info and description files.
	$(SED) \
		-e 's+@VRA_VERSION_STRING@+$(VRA_VERSION_STRING)+g' \
		-e 's+@VRA_VERSION_MAJOR@+$(VRA_VERSION_MAJOR)+g' \
		-e 's+@VRA_VERSION_MINOR@+$(VRA_VERSION_MINOR)+g' \
		-e 's+@VRA_VERSION_BUILD@+$(VRA_VERSION_BUILD)+g' \
		-e 's+@VRA_VENDOR@+$(VRA_VENDOR)+g' \
		-e 's+@VRA_PRODUCT@+$(VRA_PRODUCT)+g' \
		-e 's+@VRA_C_YEAR@+$(VRA_C_YEAR)+g' \
		--output $(VRA_PATH_PACK_TMP)/VirtualAgent.dist.res/English.lproj/Welcome.rtf \
		$(VRA_PATH_DI_SRC)/VirtualAgent_mpkg/Welcome.rtf
	@# Do keyword replacement in the distribution script.
	$(SED) \
		-e 's+@VRA_TARGET_ARCH@+$(VRA_DI_TARGET_ARCH)+g' \
		-e 's+@VRA_ARCH_LIST@+$(VRA_DI_ARCH_LIST)+g' \
		--output $(VRA_PATH_PACK_TMP)/distribution.dist \
		$(if $(VRA_WITH_VRADRV), $(VRA_PATH_DI_SRC)/VirtualAgent_mpkg/distribution.dist, $(VRA_PATH_DI_SRC)/VirtualAgent_mpkg/distribution-driverless.dist)
	@# Copy the resources.
	$(INSTALL) -m 0644 $(VRA_PATH_DI_SRC)/VirtualAgent_mpkg/Conclusion.rtf                   $(VRA_PATH_PACK_TMP)/VirtualAgent.dist.res/English.lproj/Conclusion.rtf
	$(SED) \
		-e 's+@VRA_VENDOR@+$(VRA_VENDOR)+g' \
		-e 's+@VRA_PRODUCT@+$(VRA_PRODUCT)+g' \
		-e 's+@VRA_C_YEAR@+$(VRA_C_YEAR)+g' \
		--output $(VRA_PATH_PACK_TMP)/VirtualAgent.dist.res/English.lproj/Localizable.strings \
		$(VRA_PATH_DI_SRC)/VirtualAgent_mpkg/Localizable.strings
	$(INSTALL) -m 0644 $(VRA_BRAND_DARWIN_INSTALLER_BG)                                    $(VRA_PATH_PACK_TMP)/VirtualAgent.dist.res/background.tiff
	$(foreach f,$(VRA_INSTALLER_ADD_LANGUAGES), \
		$(MKDIR) -p \
			$(VRA_PATH_PACK_TMP)/VirtualAgent.dist.res/$(VRA_INSTALLER_$(f)_DARWIN_TARGET).lproj$(NLTAB) \
		$(SED) \
			-e 's+@VRA_VERSION_STRING@+$(VRA_VERSION_STRING)+g' \
			-e 's+@VRA_VERSION_MAJOR@+$(VRA_VERSION_MAJOR)+g' \
			-e 's+@VRA_VERSION_MINOR@+$(VRA_VERSION_MINOR)+g' \
			-e 's+@VRA_VERSION_BUILD@+$(VRA_VERSION_BUILD)+g' \
			--output $(VRA_PATH_PACK_TMP)/VirtualAgent.dist.res/$(VRA_INSTALLER_$(f)_DARWIN_TARGET).lproj/Welcome.rtf \
			$(VRA_BRAND_$(f)_VIRTUALBOX_WELCOME_RTF)$(NLTAB) \
		$(INSTALL) -m 0644 $(VRA_BRAND_$(f)_VIRTUALBOX_CONCLUSION_RTF)                $(VRA_PATH_PACK_TMP)/VirtualAgent.dist.res/$(VRA_INSTALLER_$(f)_DARWIN_TARGET).lproj/Conclusion.rtf$(NLTAB) \
		$(SED) \
			-e 's+@VRA_VENDOR@+$(VRA_VENDOR)+g' \
			-e 's+@VRA_PRODUCT@+$(VRA_PRODUCT)+g' \
			-e 's+@VRA_C_YEAR@+$(VRA_C_YEAR)+g' \
			--output $(VRA_PATH_PACK_TMP)/VirtualAgent.dist.res/$(VRA_INSTALLER_$(f)_DARWIN_TARGET).lproj/Localizable.strings \
			$(VRA_BRAND_$(f)_VIRTUALBOX_LOCALIZABLE_STRINGS)$(NLTAB) \
	)
	@# Build the package.
	$(VRA_PRODUCTBUILD) \
		--distribution $(VRA_PATH_PACK_TMP)/distribution.dist \
		--package-path $(VRA_PATH_PACK_TMP)/Packages \
		--resources $(VRA_PATH_PACK_TMP)/VirtualAgent.dist.res \
		--identifier org.VirtualAgent.mpkg.virtualbox \
		--version $(VRA_VERSION_MAJOR).$(VRA_VERSION_MINOR).$(VRA_VERSION_BUILD) \
		$(if-expr defined(VRA_MACOSX_INSTALLER_SIGN) && $(intersects darwin all 1,$(VRA_WITH_CORP_CODE_SIGNING)) == "",--sign "$(VRA_MACOSX_INSTALLER_SIGN)",) \
		$@
ifdef VRA_SIGNING_MODE
 if $(intersects darwin all 1,$(VRA_WITH_CORP_CODE_SIGNING))
	@# Sign the created pkg.
	$(call VRA_SIGN_PKG_FN,$@,org.VirtualAgent.mpkg.virtualbox)
 endif
endif
	@# Cleanup.
	sudo rm -Rf \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.dist.root \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.dist.desc \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.dist.res


ifdef VRA_WITH_VRADRV
 #
 # The VirtualAgent Kernel extensions.
 #
 VRA_DI_KEXTS_UNIVERSAL = VBoxDrv VBoxNetFlt VBoxNetAdp
 VRA_DI_KEXTS = $(VRA_DI_KEXTS_UNIVERSAL)

 $(VRA_PATH_PACK_TMP)/Packages/VBoxKEXTs.pkg: \
 		$(foreach kext,$(VRA_DI_KEXTS_UNIVERSAL), $(call VRA_DI_FN_DEP_BOTH,$(kext).kext/Contents/MacOS/$(kext))) \
 		$(foreach kext,$(VRA_DI_KEXTS), $(VRA_PATH_DIST)/$(kext).kext/Contents/Info.plist) \
 		$$(wildcard \
 			$(VRA_PATH_DI_SRC)/VBoxKEXTs/* \
 			$(VRA_PATH_DI_SRC)/VBoxKEXTs/*.lproj/*) \
 		$(foreach f,$(VRA_INSTALLER_ADD_LANGUAGES), \
 			$(VRA_BRAND_$(f)_VRAKEXTS_DESCRIPTION_PLIST) \
 			$(VRA_BRAND_$(f)_VRAKEXTS_README_HTML) \
 			$(VRA_BRAND_$(f)_VRAKEXTS_INSTALLATIONCHECK_STRINGS)) \
 		$(VRA_DARWIN_INST_DEP_ON_MAKEFILE)
	$(call MSG_TOOL,pkgbuild,,,$@)
	@# Cleanup any previously failed attempts.
	sudo rm -Rf \
		$@ \
		$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root \
		$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.desc \
		$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.res
	@# Correct directory permissions are important.
	$(MKDIR) -p \
		$(@D) \
		$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.desc \
		$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.res \
		$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.res/English.lproj
	$(MKDIR) -p -m 0755 \
		$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root \
		$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root/LaunchDaemons \
		$(foreach kext,$(VRA_DI_KEXTS), \
			$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root/$(kext).kext \
			$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root/$(kext).kext/Contents \
			$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root/$(kext).kext/Contents/MacOS )
	@# Copy the launch daemon bits.
	$(INSTALL) -m 0755  $(VRA_PATH_DI_SRC)/VBoxKEXTs/VirtualAgentStartup.sh          $(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root/LaunchDaemons/
	$(INSTALL) -m 0644  $(VRA_PATH_DI_SRC)/VBoxKEXTs/org.virtualbox.startup.plist	$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root/LaunchDaemons/
	@# Copy the common files (Info.plist).
	$(foreach kext,$(VRA_DI_KEXTS), \
		$(NLTAB)$(INSTALL) -m 0644 $(VRA_PATH_DIST)/$(kext).kext/Contents/Info.plist $(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root/$(kext).kext/Contents/)
	@# Copy the binaries and invoking lipo.
	$(foreach kext,$(VRA_DI_KEXTS), \
		$(NLTAB)$(INSTALL) -m 0755 $(VRA_PATH_DIST)/$(kext).kext/Contents/MacOS/$(kext) $(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root/$(kext).kext/Contents/MacOS/)
	@# Sign the kext bundles.
 ifdef VRA_SIGNING_MODE
	$(foreach kext,$(VRA_DI_KEXTS) \
		,$(NLTAB)$(call VRA_SIGN_MACHO_FN,$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root/$(kext).kext/Contents/MacOS/$(kext),org.virtualbox.app.kext.$(kext)) )
	$(foreach kext,$(VRA_DI_KEXTS) \
		,$(NLTAB)$(call VRA_SIGN_BUNDLE_FN,$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root/$(kext).kext,org.virtualbox.app.kext.$(kext)) \
		$(NLTAB)chmod a+r $(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root/$(kext).kext/Contents/_CodeSignature/* )
  ## @TODO check why this fails on the build box:	$(foreach kext,$(VRA_DI_KEXTS), $(NLTAB)codesign --verify --verbose=1 $(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root/$(kext).kext )
 endif
	@# Set the correct owners.
	sudo chown -R root:wheel $(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root/
	@# Do keyword replacement in the package info and description files.
	$(SED) \
		-e 's+@VRA_VERSION_STRING@+$(VRA_VERSION_STRING)+g' \
		-e 's+@VRA_VERSION_MAJOR@+$(VRA_VERSION_MAJOR)+g' \
		-e 's+@VRA_VERSION_MINOR@+$(VRA_VERSION_MINOR)+g' \
		-e 's+@VRA_VERSION_BUILD@+$(VRA_VERSION_BUILD)+g' \
		-e 's+@VRA_VENDOR@+$(VRA_VENDOR)+g' \
		-e 's+@VRA_PRODUCT@+$(VRA_PRODUCT)+g' \
		-e 's+@VRA_C_YEAR@+$(VRA_C_YEAR)+g' \
		--output $(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.desc/PkgBuildComponent.plist \
		$(VRA_PATH_DI_SRC)/VBoxKEXTs/PkgBuildComponent.plist
	@# Copy the resources.
	$(INSTALL) -m 0755 $(VRA_PATH_DI_SRC)/VBoxKEXTs/postflight                            $(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.res/
	@# Build the package.
	$(VRA_PKGBUILD) \
		--root   $(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root/ \
		--component-plist $(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.desc/PkgBuildComponent.plist \
		--script $(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.res \
		--identifier org.virtualbox.pkg.vboxkexts \
		--version $(VRA_VERSION_MAJOR).$(VRA_VERSION_MINOR).$(VRA_VERSION_BUILD) \
		--install-location "/Library/Application Support/VirtualAgent" \
		--ownership preserve \
		$(if-expr defined(VRA_MACOSX_INSTALLER_SIGN) && $(intersects darwin all 1,$(VRA_WITH_CORP_CODE_SIGNING)) == "",--sign "$(VRA_MACOSX_INSTALLER_SIGN)",) \
		$@
 ifdef VRA_SIGNING_MODE
  if $(intersects darwin all 1,$(VRA_WITH_CORP_CODE_SIGNING))
	@# Sign the created pkg.
	$(call VRA_SIGN_PKG_FN,$@,org.virtualbox.pkg.vboxkexts)
  endif
 endif
	@# Cleanup
	sudo chown -R "$(shell whoami)" \
		$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root
	sudo rm -Rf \
		$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.root \
		$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.desc \
		$(VRA_PATH_PACK_TMP)/VBoxKEXTs.pkg.res
endif # !VRA_WITH_VRADRV


#
# Figure out which languages that we support and construct
# .qm and .lproj lists for these.
#
include $(PATH_ROOT)/src/VBox/Frontends/VirtualAgent/nls/ApprovedLanguages.kmk
ifdef VRA_WITH_QTGUI
 VRA_INSTALL_LANG_FILES := $(foreach f,$(VRA_APPROVED_GUI_LANGUAGES), VirtualAgent_$(f).qm qt_$(f).qm)
else
 VRA_INSTALL_LANG_FILES :=
endif
VRA_INSTALL_LANG_LPROJ  := $(addsuffix .lproj,$(VRA_APPROVED_GUI_LANGUAGES))


#
# The VirtualAgent Application.
#

VRA_DI_VBAPP_PROGS_HARDENED = \
	MacOS/VBoxHeadless \
	MacOS/VBoxNetDHCP \
	MacOS/VBoxNetNAT \
	MacOS/VBoxVMMPreload
ifdef VRA_WITH_QTGUI
 VRA_DI_VBAPP_PROGS_HARDENED += \
 	Resources/VirtualAgentVM.app/Contents/MacOS/VirtualAgentVM
endif

VRA_DI_VBAPP_PROGS = \
	MacOS/VBoxManage \
	MacOS/VBoxSVC \
	MacOS/VBoxNetAdpCtl \
	MacOS/VBoxExtPackHelperApp \
	$(if $(VRA_WITH_FE_BUGREPORT),MacOS/VBoxBugReport) \
	$(if $(VRA_WITH_FE_BALLOONCTRL),MacOS/VBoxBalloonCtrl) \
	$(if $(VRA_WITH_FE_AUTOSTART),MacOS/VBoxAutostart) \
	$(if $(VRA_WITH_WEBSERVICES),MacOS/vboxwebsrv) \
	$(if $(VRA_WITH_DTRACE),MacOS/VBoxDTrace,) \
	$(if $(VRA_WITH_HOST_SHIPPING_AUDIO_TEST),MacOS/VBoxAudioTest,)
ifdef VRA_WITH_QTGUI
 VRA_DI_VBAPP_PROGS += \
 	MacOS/VirtualAgent
endif


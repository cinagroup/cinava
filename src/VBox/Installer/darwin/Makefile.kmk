 	MacOS/VBoxEFI-x86.fd \
 	MacOS/VBoxEFI-amd64.fd
 ifdef VRA_WITH_VIRT_ARMV8
  VRA_DI_VBAPP_MISC_FILES += \
  	MacOS/VBoxEFI-arm32.fd \
  	MacOS/VBoxEFI-arm64.fd
 endif
endif
VRA_DI_VBAPP_SYMLINKS =
ifdef VRA_WITH_QTGUI
 VRA_DI_VBAPP_DYLIBS += \
 	$(foreach qtmod, $(VRA_QT_MOD_NAMES), Frameworks/$(qtmod).framework/Versions/$(VRA_QT_VERSION_MAJOR)/$(qtmod)) \
 	plugins/platforms/libqcocoa$(SUFF_DLL) \
 	plugins/platforms/libqminimal$(SUFF_DLL) \
 	plugins/platforms/libqoffscreen$(SUFF_DLL) \
 	plugins/sqldrivers/libqsqlite$(SUFF_DLL) \
 	plugins/styles/libqmacstyle$(SUFF_DLL)
 VRA_DI_VBAPP_MISC_FILES += \
 	$(foreach qtmod, $(VRA_QT_MOD_NAMES), Frameworks/$(qtmod).framework/Versions/$(VRA_QT_VERSION_MAJOR)/Resources/Info.plist)
 VRA_DI_VBAPP_SYMLINKS += \
 	Resources/vmstarter.app/Contents/MacOS=>../../../MacOS/ \
 	$(foreach qtmod, $(VRA_QT_MOD_NAMES) \
 		,Frameworks/$(qtmod).framework/Versions/Current=>$(VRA_QT_VERSION_MAJOR) )
endif
ifdef VRA_WITH_PYTHON
 # Python XPCOM glue
 VRA_DI_VBAPP_PYTHON_FILES = \
 	$(VRAINST_SDK_BINDINGS_XPCOM_PYTHON_FILES) \
 	$(VRAINST_SDK_INSTALLER_PYTHON_FILES)
endif
ifdef VRA_WITH_INTNET_SERVICE_IN_R3
 VRA_DI_VBAPP_PROGS += \
 	XPCServices/org.virtualbox.intnet.xpc/Contents/MacOS/VBoxIntNetSwitch
 VRA_DI_VBAPP_MISC_FILES += \
 	XPCServices/org.virtualbox.intnet.xpc/Contents/Info.plist
 ifdef VRA_WITH_QTGUI
  VRA_DI_VBAPP_SYMLINKS += \
  	Resources/VirtualAgentVM.app/Contents/XPCServices=>../../../XPCServices
 endif
endif

VRA_VIRTUALBOX_APP_ENTITLEMENTS := $(VRA_DARWIN_ENTITLEMENTS_FILE)
VRA_VIRTUALBOXVM_APP_ENTITLEMENTS := $(VRA_DARWIN_ENTITLEMENTS_FILE_VM)

##
# Add application and team ID into entitlement file
# $(evalcall def_vbox_entitlement_add_app_and_team_id)
# @param    1   Source entitlement file.
# @param    2   Target entitlement file.
# @param    3   Application ID.
# @param    4   Team ID.
define def_vbox_entitlement_add_app_and_team_id =
 $(2): $(1) $$(VRA_DARWIN_INST_DEP_ON_MAKEFILE) | $$$$(dir $$$$@)
	$$(QUIET)$$(SED) \
		-e '/^<dict>$$$$/a \    <key>com.apple.application-identifier</key>\n    <string>$(strip $(4)).$(strip $(3))</string>\n    <key>com.apple.developer.team-identifier</key>\n    <string>$(strip $(4))</string>' \
		--output $$@ $$<
endef

if defined(VRA_WITH_MACOS_HARDENED_RUNTIME) && defined(VRA_SIGNING_MODE) && defined(VRA_PROVISIONPROFILE_TEAM_ID)
 ifdef VRA_VIRTUALBOX_APP_ID
  VRA_VIRTUALBOX_APP_ENTITLEMENTS := $(VRA_PATH_PACK_TMP)/SUPR3HardenedEntitlements.plist
  $(evalcall2 def_vbox_entitlement_add_app_and_team_id,$(VRA_DARWIN_ENTITLEMENTS_FILE),$(VRA_VIRTUALBOX_APP_ENTITLEMENTS),$(VRA_VIRTUALBOX_APP_ID),$(VRA_PROVISIONPROFILE_TEAM_ID))
 endif

 ifdef VRA_VIRTUALBOXVM_APP_ID
  VRA_VIRTUALBOXVM_APP_ENTITLEMENTS := $(VRA_PATH_PACK_TMP)/SUPR3HardenedEntitlementsVM.plist
  $(evalcall2 def_vbox_entitlement_add_app_and_team_id,$(VRA_DARWIN_ENTITLEMENTS_FILE_VM),$(VRA_VIRTUALBOXVM_APP_ENTITLEMENTS),$(VRA_VIRTUALBOXVM_APP_ID),$(VRA_PROVISIONPROFILE_TEAM_ID))
 endif
endif

# (The dependencies are including way too much here because I'm lazy.)
$(VRA_PATH_PACK_TMP)/Packages/VirtualAgent.pkg: \
		$(foreach f,$(VRA_INSTALLER_ADD_LANGUAGES), \
			$(VRA_BRAND_$(f)_VIRTUALBOX_DESCRIPTION_PLIST)) \
		$(foreach f, $(VRA_DI_VBAPP_DYLIBS) $(VRA_DI_VBAPP_OTHER_UNIVERSAL_BINS) $(VRA_DI_VBAPP_UNIVERSAL_PROGS) \
			$(VRA_DI_VBAPP_OTHER_BINS) $(VRA_DI_VBAPP_PROGS) $(VRA_DI_VBAPP_PROGS_HARDENED) $(VRA_DI_VBAPP_MISC_FILES) \
			,$(call VRA_DI_FN_DEP_BOTH,VirtualAgent.app/Contents/$(f)) ) \
		$(foreach f, $(VRA_DI_VBAPP_DYLIBS.x86) $(VRA_DI_VBAPP_MISC_FILES.x86) \
			,$(call VRA_DI_FN_DEP_32,VirtualAgent.app/Contents/$(f)) ) \
		$(foreach f, $(VRA_DI_VBAPP_DYLIBS.amd64) $(VRA_DI_VBAPP_MISC_FILES.amd64) \
			,$(call VRA_DI_FN_DEP_64,VirtualAgent.app/Contents/$(f)) ) \
		\
		$(if $(VRA_WITH_DOCS_PACKING),$(VRA_ADD_MANUALS),) \
		$(VRA_BRAND_LICENSE_TXT) \
		$(wildcard $(VRA_PATH_DI_SRC)/VirtualAgent/*) \
		$(wildcard $(VRA_PATH_DI_SRC)/VirtualAgent/*.lproj/*) \
		$$(addprefix $(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/nls/,$(VRA_INSTALL_LANG_FILES)) \
		\
		$$(wildcard $(VRA_PATH_DIST)/VirtualAgent.app/*) \
		$(filter-out Disabled, $(wildcard $(VRA_PATH_DIST)/VirtualAgent.app/Contents/*)) \
		$$(wildcard $(VRA_PATH_DIST)/VirtualAgent.app/Contents/Resources/*) \
		$$(wildcard $(VRA_PATH_DIST)/VirtualAgent.app/Contents/Resources/VirtualAgentVM.app/Contents/*) \
		$$(wildcard $(VRA_PATH_DIST)/VirtualAgent.app/Contents/Resources/VirtualAgentVM.app/Contents/Resources/*) \
		$$(wildcard $(VRA_PATH_DIST)/VirtualAgent.app/Contents/Resources/VirtualAgentVM.app/Contents/Resources/*.lproj/*) \
		$$(wildcard $(VRA_PATH_DIST)/VirtualAgent.app/Contents/Resources/vmstarter.app/Contents/*) \
		$$(wildcard $(VRA_PATH_DIST)/VirtualAgent.app/Contents/Resources/vmstarter.app/Contents/Resources/*) \
		$$(wildcard $(VRA_PATH_DIST)/VirtualAgent.app/Contents/Resources/vmstarter.app/Contents/Resources/*.lproj/*) \
		$$(wildcard $(VRA_PATH_DIST)/VirtualAgent.app/Contents/Resources/*.lproj/*) \
		$$(wildcard $(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/*) \
		$$(wildcard $(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/additions/*) \
		$$(wildcard $(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/components/*) \
		$$(wildcard $(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/accessible/*) \
		$(addprefix $(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/UnattendedTemplates/, $(VRA_UNATTENDED_TEMPLATES)) \
		$(if-expr defined(VRA_WITH_PYTHON), $(addprefix $(VRA_PATH_DIST)/, $(VRA_DI_VBAPP_PYTHON_FILES)),) \
		$(if-expr defined(VRA_WITH_JXPCOM), $(addprefix $(VRA_PATH_DIST)/, sdk/bindings/xpcom/java/vboxjxpcom.jar),) \
		$(if-expr defined(VRA_PROVISIONPROFILE_TEAM_ID),$(VRA_PATH_DI_SRC)/VirtualAgent/$(VRA_PROVISIONPROFILE_TEAM_ID).provisionprofile,) \
		$(if $(VRA_WITH_WEBSERVICES),$(VRA_PATH_DI_SRC)/VirtualAgent/org.virtualbox.vboxwebsrv.plist,) \
		$(if $(VRA_WITH_FE_BALLOONCTRL),$(VRA_PATH_DI_SRC)/VirtualAgent/org.virtualbox.vboxballoonctrl.plist) \
		$(if $(VRA_WITH_FE_AUTOSTART),$(VRA_PATH_DI_SRC)/VirtualAgent/org.virtualbox.vboxautostart.plist) \
		$(if $(VRA_WITH_FE_AUTOSTART),$(VRA_PATH_DI_SRC)/VirtualAgent/VBoxAutostartDarwin.sh) \
		$(if-expr defined(VRA_WITH_DTRACE), \
			$(foreach f, $(VRAINST_DTRACE_LIB_ARCH_FILES), \
				$(call VRA_DI_FN_DEP_32,VirtualAgent.app/Contents/MacOS/dtrace/lib/x86/$f) \
				$(call VRA_DI_FN_DEP_64,VirtualAgent.app/Contents/MacOS/dtrace/lib/amd64/$f)) \
			$(foreach f, $(VRAINST_DTRACE_TESTCASE_ARCH_FILES), \
				$(call VRA_DI_FN_DEP_32,VirtualAgent.app/Contents/MacOS/dtrace/testcase/x86/$f) \
				$(call VRA_DI_FN_DEP_64,VirtualAgent.app/Contents/MacOS/dtrace/testcase/amd64/$f)) \
			$(addprefix $(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/dtrace/scripts/,$(VRAINST_DTRACE_SCRIPTS_FILES)) \
			,) \
		$(if-expr defined(VRA_WITH_MACOS_HARDENED_RUNTIME) && defined(VRA_SIGNING_MODE), \
			$(VRA_VIRTUALBOX_APP_ENTITLEMENTS) $(VRA_VIRTUALBOXVM_APP_ENTITLEMENTS),) \
		$(VRA_DARWIN_INST_DEP_ON_MAKEFILE)
	$(call MSG_TOOL,pkgbuild,,,$@)
	@# Cleanup any previously failed attempts.
	sudo rm -Rf \
		$@ \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.root \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.desc \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.res
	@# Correct directory permissions are important.
	$(MKDIR) -p \
		$(@D) \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.desc \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.res \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.res/English.lproj
	$(MKDIR) -p -m 0775 \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.root/Applications
	$(MKDIR) -p -m 0755 $(sort \
		$(VRA_PATH_VRA_APP_TMP)/Contents \
		$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS \
		$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/components \
		$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/nls \
		$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/accessible \
		$(VRA_PATH_VRA_APP_TMP)/Contents/Resources \
		$(if-expr defined(VRA_WITH_QTGUI), \
			$(VRA_PATH_VRA_APP_TMP)/Contents/Resources/VirtualAgentVM.app \
			$(VRA_PATH_VRA_APP_TMP)/Contents/Resources/VirtualAgentVM.app/Contents \
			$(VRA_PATH_VRA_APP_TMP)/Contents/Resources/vmstarter.app \
			$(VRA_PATH_VRA_APP_TMP)/Contents/Resources/vmstarter.app/Contents,) \
		$(if-expr defined(VRA_WITH_PYTHON), \
			$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/sdk \
			$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/sdk/installer \
			$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/sdk/installer/python \
			$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/sdk/installer/python/vboxapi \
			$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/sdk/installer/python/vboxapi/src \
			$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/sdk/installer/python/vboxapi/src/vboxapi \
			$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/sdk/bindings/ \
			$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/sdk/bindings/xpcom \
			$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/sdk/bindings/xpcom/python \
			$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/sdk/bindings/xpcom/python/xpcom \
			$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/sdk/bindings/xpcom/python/xpcom/client \
			$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/sdk/bindings/xpcom/python/xpcom/server,) \
		$(if-expr defined(VRA_WITH_JXPCOM), \
			$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/sdk/bindings/xpcom/java,) \
		$(addprefix $(VRA_PATH_VRA_APP_TMP)/Contents/,$(dir \
			$(VRA_DI_VBAPP_DYLIBS) \
			$(VRA_DI_VBAPP_OTHER_UNIVERSAL_BINS) \
			$(VRA_DI_VBAPP_UNIVERSAL_PROGS) \
			$(VRA_DI_VBAPP_OTHER_BINS) \
			$(VRA_DI_VBAPP_PROGS) \
			$(VRA_DI_VBAPP_PROGS_HARDENED) \
			$(VRA_DI_VBAPP_MISC_FILES) \
			$(VRA_DI_VBAPP_DYLIBS.$(KBUILD_TARGET_ARCH)) \
			$(VRA_DI_VBAPP_MISC_FILES.$(KBUILD_TARGET_ARCH)) \
			))\
		)
# Create the .lproj language directories
	$(MKDIR) -p -m 0755 \
		$(addprefix $(VRA_PATH_VRA_APP_TMP)/Contents/Resources/,$(VRA_INSTALL_LANG_LPROJ))
# Install all supported language files
	$(foreach f, $(VRA_INSTALL_LANG_FILES) \
		,$(INSTALL) -m 0644 $(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/nls/$(f)    $(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/nls/$(f)$(NLTAB))
ifdef VRA_PROVISIONPROFILE_TEAM_ID
	$(INSTALL) -m 0644 $(VRA_PATH_DI_SRC)/VirtualAgent/$(VRA_PROVISIONPROFILE_TEAM_ID).provisionprofile	$(VRA_PATH_VRA_APP_TMP)/Contents/embedded.provisionprofile
endif
ifdef VRA_WITH_WEBSERVICES
	$(INSTALL) -m 0644 $(VRA_PATH_DI_SRC)/VirtualAgent/org.virtualbox.vboxwebsrv.plist       $(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/
endif
ifdef VRA_WITH_FE_BALLOONCTRL
	$(INSTALL) -m 0644 $(VRA_PATH_DI_SRC)/VirtualAgent/org.virtualbox.vboxballoonctrl.plist  $(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/
endif
ifdef VRA_WITH_FE_AUTOSTART
	$(INSTALL) -m 0644 $(VRA_PATH_DI_SRC)/VirtualAgent/org.virtualbox.vboxautostart.plist    $(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/
	$(INSTALL) -m 0755 $(VRA_PATH_DI_SRC)/VirtualAgent/VBoxAutostartDarwin.sh                $(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/
endif
# Install the python bridge stuff
ifdef VRA_WITH_PYTHON
	$(foreach f,$(VRA_DI_VBAPP_PYTHON_FILES) \
		,$(INSTALL) -m 0644 $(VRA_PATH_DIST)/$(f)                                      $(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/$(f)$(NLTAB) )
	$(INSTALL) -m 0755 $(PATH_ROOT)/src/VBox/Frontends/VBoxShell/vboxshell.py               $(VRA_PATH_VRA_APP_TMP)/Contents/MacOS
endif
# Install the java bridge stuff
ifdef VRA_WITH_JXPCOM
	$(INSTALL) -m 0755 $(VRA_PATH_DIST)/sdk/bindings/xpcom/java/vboxjxpcom.jar             $(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/sdk/bindings/xpcom/java/vboxjxpcom.jar
endif
# Copy misc files.
	$(foreach f,$(VRA_DI_VBAPP_MISC_FILES) \
		,$(INSTALL) -m 0644 $(VRA_PATH_DIST)/VirtualAgent.app/Contents/$(f)              $(VRA_PATH_VRA_APP_TMP)/Contents/$(f)$(NLTAB) )
	$(INSTALL) -m 644 $(VRA_BRAND_LICENSE_TXT)                                             $(VRA_PATH_VRA_APP_TMP)/Contents/Resources/LICENSE
	$(INSTALL) -m 644 $(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/.autoreg		$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS
	$(TOUCH)										$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/.autoreg
ifdef VRA_WITH_DOCS_PACKING
	$(foreach f,$(VRA_ADD_MANUALS) \
		,$(INSTALL) -m 0644 $(f) $(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/$(NLTAB))
endif
	@# Create symlinks.
	$(foreach symlink,$(VRA_DI_VBAPP_SYMLINKS) $(VRA_DI_VBAPP_SYMLINKS.$(KBUILD_TARGET_ARCH)) \
		,$(LN) -s $(word 2,$(subst =>, ,$(symlink)))                                    $(VRA_PATH_VRA_APP_TMP)/Contents/$(word 1,$(subst =>, ,$(symlink)))$(NLTAB))
	@# Copy the dylibs.
	$(foreach dylib, $(VRA_DI_VBAPP_DYLIBS) $(VRA_DI_VBAPP_DYLIBS.$(KBUILD_TARGET_ARCH)) \
		,$(INSTALL) -m 0644 $(VRA_PATH_DIST)/VirtualAgent.app/Contents/$(dylib)          $(VRA_PATH_VRA_APP_TMP)/Contents/$(dylib)$(NLTAB))
	@# Copy the other binaries.
	$(foreach otherbin, $(VRA_DI_VBAPP_OTHER_UNIVERSAL_BINS) $(VRA_DI_VBAPP_OTHER_BINS) \
		,$(INSTALL) -m 0644 $(VRA_PATH_DIST)/VirtualAgent.app/Contents/$(otherbin)       $(VRA_PATH_VRA_APP_TMP)/Contents/$(otherbin)$(NLTAB))
	@# Create/copy the universal executable binaries.
	$(foreach otherbin, $(VRA_DI_VBAPP_UNIVERSAL_PROGS) \
		,$(INSTALL) -m 0755 $(VRA_PATH_DIST)/VirtualAgent.app/Contents/$(otherbin)       $(VRA_PATH_VRA_APP_TMP)/Contents/$(otherbin)$(NLTAB))
	@# Copy the binaries.
	$(foreach prog, $(VRA_DI_VBAPP_PROGS) $(VRA_DI_VBAPP_PROGS_HARDENED) \
		,$(INSTALL) -m 0755 $(VRA_PATH_DIST)/VirtualAgent.app/Contents/$(prog)			$(VRA_PATH_VRA_APP_TMP)/Contents/$(prog)$(NLTAB))
ifdef VRA_UNATTENDED_TEMPLATES
 # Unattended installation template scripts.
	$(MKDIR) -p -m 0755 -- $(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/UnattendedTemplates
	$(foreach file, $(VRA_UNATTENDED_TEMPLATES) \
		,$(INSTALL) -m 0655 $(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/UnattendedTemplates/$(file) \
			$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/UnattendedTemplates/$(file)$(NLTAB))
endif
ifdef VRA_WITH_DTRACE
 # DTrace library, testcases and scripts.
	$(MKDIR) -p -m 0755 -- \
		$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/dtrace/lib/$(KBUILD_TARGET_ARCH)/ \
		$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/dtrace/testcase/$(KBUILD_TARGET_ARCH)/ \
		$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/dtrace/scripts/
	$(foreach file, $(addprefix lib/$(KBUILD_TARGET_ARCH)/,$(VRAINST_DTRACE_LIB_ARCH_FILES)) \
			$(addprefix testcase/$(KBUILD_TARGET_ARCH)/,$(VRAINST_DTRACE_TESTCASE_ARCH_FILES)) \
			$(addprefix scripts/,$(VRAINST_DTRACE_SCRIPTS_FILES)) \
		,$(INSTALL) -m 0655 $(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/dtrace/$(file) \
			$(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/dtrace/$(file)$(NLTAB))
endif
ifndef VRA_WITH_QTGUI
 # Hack alert! Just something to make pkgbuild happy.
	$(APPEND) -tn "$(VRA_PATH_VRA_APP_TMP)/Contents/PkgInfo" "APPLVRA"
	$(APPEND) -tn "$(VRA_PATH_VRA_APP_TMP)/Contents/Info.plist" \
		'<?xml version="1.0" encoding="UTF-8"?>' \
		'<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' \
		'<plist version="1.0">' \
		'<dict>' \
		'  <key>CFBundlePackageType</key>              <string>APPL</string>' \
		'  <key>CFBundleSignature</key>                <string>VRA</string>' \
		'  <key>CFBundleDevelopmentRegion</key>        <string>English</string>' \
		'  <key>CFBundleIdentifier</key>               <string>org.virtualbox.app.VBoxManage</string>' \
		'  <key>CFBundleName</key>                     <string>VirtualAgent</string>' \
		'  <key>CFBundleExecutable</key>               <string>VBoxManage</string>' \
		'  <key>CFBundleVersion</key>                  <string>$(VRA_VERSION_MAJOR).$(VRA_VERSION_MINOR).$(VRA_VERSION_BUILD)</string>' \
		'  <key>CFBundleShortVersionString</key>       <string>$(VRA_VERSION_MAJOR).$(VRA_VERSION_MINOR).$(VRA_VERSION_BUILD)</string>' \
		'  <key>CFBundleGetInfoString</key>            <string>$(VRA_PRODUCT) Manager $(VRA_VERSION_STRING), © 2007-$(VRA_C_YEAR) $(VRA_VENDOR)</string>' \
		'  <key>CFBundleInfoDictionaryVersion</key>    <string>6.0</string>' \
		'</dict>' \
		'</plist>'
endif
	@# Sign the binaries and the application bundle.
ifdef VRA_SIGNING_MODE
 ifdef VRA_WITH_QTGUI
	$(foreach qtmod, $(VRA_QT_MOD_NAMES) \
		,$(NLTAB)$(call VRA_SIGN_MACHO_FN,$(VRA_PATH_VRA_APP_TMP)/Contents/Frameworks/$(qtmod).framework/Versions/$(VRA_QT_VERSION_MAJOR)/$(qtmod),org.virtualbox.app.frameworks.$(qtmod)) )
	$(foreach qtmod, $(VRA_QT_MOD_NAMES) \
		,$(NLTAB)$(call VRA_SIGN_BUNDLE_FN,$(VRA_PATH_VRA_APP_TMP)/Contents/Frameworks/$(qtmod).framework/Versions/$(VRA_QT_VERSION_MAJOR),org.virtualbox.app.frameworks.$(qtmod)) )
 endif
	$(foreach dylib, \
		$(VRA_DI_VBAPP_DYLIBS) \
		$(VRA_DI_VBAPP_DYLIBS.$(KBUILD_TARGET_ARCH)) \
		, $(NLTAB)$(call VRA_SIGN_MACHO_FN,$(VRA_PATH_VRA_APP_TMP)/Contents/$(dylib),org.virtualbox.app.macos.$(notdir $(dylib))) )
	$(foreach bin, $(VRA_DI_VBAPP_UNIVERSAL_PROGS) \
		, $(NLTAB)$(call VRA_SIGN_MACHO_FN,$(VRA_PATH_VRA_APP_TMP)/Contents/$(bin),org.virtualbox.app.macos.$(notdir $(bin))) )
	$(foreach other, $(VRA_DI_VBAPP_OTHER_UNIVERSAL_BINS) $(VRA_DI_VBAPP_OTHER_BINS)\
		, $(NLTAB)$(call VRA_SIGN_MACHO_FN,$(VRA_PATH_VRA_APP_TMP)/Contents/$(other),org.virtualbox.app.macos.$(notdir $(other))) )
	$(foreach bin, $(filter-out MacOS/VirtualAgent,$(VRA_DI_VBAPP_PROGS) $(if-expr !defined(VRA_WITH_MACOS_HARDENED_RUNTIME),$(VRA_DI_VBAPP_PROGS_HARDENED),)) \
		, $(NLTAB)$(call VRA_SIGN_MACHO_FN,$(VRA_PATH_VRA_APP_TMP)/Contents/$(bin),org.virtualbox.app.macos.$(notdir $(bin))) )
	$(foreach file, $(if-expr defined(VRA_WITH_WEBSERVICES),MacOS/org.virtualbox.vboxwebsrv.plist,) \
			$(if-expr defined(VRA_WITH_FE_BALLOONCTRL),MacOS/org.virtualbox.vboxballoonctrl.plist,) \
			$(if-expr defined(VRA_WITH_FE_AUTOSTART),MacOS/org.virtualbox.vboxautostart.plist,) \
			$(if-expr defined(VRA_WITH_FE_AUTOSTART),MacOS/VBoxAutostartDarwin.sh,) \
			$(if-expr defined(VRA_WITH_PYTHON),$(addprefix MacOS/, $(VRA_DI_VBAPP_PYTHON_FILES) vboxshell.py),) \
			$(if-expr defined(VRA_WITH_JXPCOM),MacOS/sdk/bindings/xpcom/java/vboxjxpcom.jar,) \
			$(filter MacOS/%,$(VRA_DI_VBAPP_MISC_FILES)) \
			$(if-expr defined(VRA_WITH_DOCS_PACKING),$(addprefix MacOS/,$(VRA_ADD_MANUALS)),) \
			$(if-expr defined(VRA_WITH_DTRACE),\
				$(addprefix MacOS/dtrace/lib/$(KBUILD_TARGET_ARCH)/,$(VRAINST_DTRACE_LIB_ARCH_FILES)) \
				$(addprefix MacOS/dtrace/testcase/$(KBUILD_TARGET_ARCH)/,$(VRAINST_DTRACE_TESTCASE_ARCH_FILES)) \
				$(addprefix MacOS/dtrace/scripts/,$(VRAINST_DTRACE_SCRIPTS_FILES)) ,) \
			$(addprefix MacOS/nls/,$(VRA_INSTALL_LANG_FILES)) \
		, $(NLTAB)$(call VRA_SIGN_FILE_FN,$(VRA_PATH_VRA_APP_TMP)/Contents/$(file),org.virtualbox.app.$(tolower $(subst $(SP),,$(subst /,.,$(file))))) )

 ifdef VRA_PROVISIONPROFILE_TEAM_ID
  #	$(INSTALL) -m 0644 $(VRA_PATH_DI_SRC)/VirtualAgent/$(VRA_PROVISIONPROFILE_TEAM_ID).provisionprofile	$(VRA_PATH_VRA_APP_TMP)/Contents/Resources/VirtualAgentVM.app/Contents/embedded.provisionprofile
 endif
	$(call VRA_SIGN_BUNDLE_FN,$(VRA_PATH_VRA_APP_TMP)/Contents/Resources/VirtualAgentVM.app,,$(if-expr defined(VRA_WITH_MACOS_HARDENED_RUNTIME)\
		,--entitlements="$(VRA_VIRTUALBOX_APP_ENTITLEMENTS)",))
 ifdef VRA_WITH_QTGUI
	$(call VRA_SIGN_BUNDLE_FN,$(VRA_PATH_VRA_APP_TMP)/Contents/Resources/vmstarter.app,,)
 endif
	$(call VRA_SIGN_BUNDLE_FN,$(VRA_PATH_VRA_APP_TMP),,--deep)
 ifdef VRA_WITH_MACOS_HARDENED_RUNTIME # HACK ALERT! --deep fries the entitlements, so redo w/o --deep now.
	$(foreach bin, $(filter-out MacOS/VirtualAgentVM MacOS/VBoxHeadless,$(VRA_DI_VBAPP_PROGS_HARDENED)) \
		, $(NLTAB)$(call VRA_SIGN_MACHO_FN,$(VRA_PATH_VRA_APP_TMP)/Contents/$(bin),org.virtualbox.app.macos.$(notdir $(bin)), \
				--entitlements="$(VRA_VIRTUALBOX_APP_ENTITLEMENTS)"))
	$(foreach bin, $(filter MacOS/VirtualAgentVM MacOS/VBoxHeadless,$(VRA_DI_VBAPP_PROGS_HARDENED)) \
		, $(NLTAB)$(call VRA_SIGN_MACHO_FN,$(VRA_PATH_VRA_APP_TMP)/Contents/$(bin),org.virtualbox.app.macos.$(notdir $(bin)), \
				--entitlements="$(VRA_VIRTUALBOXVM_APP_ENTITLEMENTS)"))
	$(call VRA_SIGN_BUNDLE_FN,$(VRA_PATH_VRA_APP_TMP)/Contents/Resources/VirtualAgentVM.app,,\
		--entitlements="$(VRA_VIRTUALBOXVM_APP_ENTITLEMENTS)",)
	$(call VRA_SIGN_BUNDLE_FN,$(VRA_PATH_VRA_APP_TMP),,\
		--entitlements="$(VRA_VIRTUALBOX_APP_ENTITLEMENTS)",)
	$(foreach bin, $(VRA_DI_VBAPP_PROGS_HARDENED) \
		, $(NLTAB)codesign -d -v -v -v --entitlements :- $(VRA_PATH_VRA_APP_TMP)/Contents/$(bin) )
	$(foreach bin, $(VRA_DI_VBAPP_PROGS) \
		, $(NLTAB)codesign -d -v -v -v --entitlements :- $(VRA_PATH_VRA_APP_TMP)/Contents/$(bin) )
 endif
endif
	@# Set the correct owner and set the set-user-ID-on-execution bit on the relevant executables.
	sudo chown -R root:admin $(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.root
	sudo chmod u+s $(VRA_PATH_VRA_APP_TMP)/Contents/MacOS/VBoxNetAdpCtl
ifdef VRA_WITH_HARDENING
	sudo chmod u+s $(foreach bin,$(VRA_DI_VBAPP_PROGS_HARDENED),$(VRA_PATH_VRA_APP_TMP)/Contents/$(bin))
endif
if 0 # Handy for testing the app bundle w/o having to reinstall all the time (just untar it into -C /Applications/)
	$(RM) -f -- "$(PATH_OUT)/VirtualAgent.app.tar.gz"
	tar -czf "$(PATH_OUT)/VirtualAgent.app.tar.gz" -C "$(VRA_PATH_VRA_APP_TMP)/.." VirtualAgent.app
endif
	@# Do keyword replacement in the package info and description files.
	$(SED) \
		-e 's+@VRA_VERSION_STRING@+$(VRA_VERSION_STRING)+g' \
		-e 's+@VRA_VERSION_MAJOR@+$(VRA_VERSION_MAJOR)+g' \
		-e 's+@VRA_VERSION_MINOR@+$(VRA_VERSION_MINOR)+g' \
		-e 's+@VRA_VERSION_BUILD@+$(VRA_VERSION_BUILD)+g' \
		-e 's+@VRA_VENDOR@+$(VRA_VENDOR)+g' \
		-e 's+@VRA_PRODUCT@+$(VRA_PRODUCT)+g' \
		-e 's+@VRA_C_YEAR@+$(VRA_C_YEAR)+g' \
		--output $(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.desc/PkgBuildComponent.plist \
		$(VRA_PATH_DI_SRC)/VirtualAgent/PkgBuildComponent.plist
	@# Copy the resources.
	$(INSTALL) -m 0755 $(VRA_PATH_DI_SRC)/VirtualAgent/preflight                         $(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.res/
ifdef VRA_WITH_HARDENING
	$(INSTALL) -m 0755 $(VRA_PATH_DI_SRC)/VirtualAgent/postflight                        $(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.res/
else
	$(SED) -s '/WITH_HARDENING/d' -o $(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.res/postflight $(VRA_PATH_DI_SRC)/VirtualAgent/postflight
	$(CHMOD) 0755 $(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.res/postflight
endif
	ls -lR $(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.root/Applications/
	@# Build the package.
	$(VRA_PKGBUILD) \
		--root   $(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.root/Applications/ \
		--component-plist $(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.desc/PkgBuildComponent.plist \
		--script $(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.res \
		--identifier org.virtualbox.pkg.virtualbox \
		--version $(VRA_VERSION_MAJOR).$(VRA_VERSION_MINOR).$(VRA_VERSION_BUILD) \
		--install-location /Applications/ \
		--ownership preserve \
		--preserve-xattr \
		$(if-expr defined(VRA_MACOSX_INSTALLER_SIGN) && $(intersects darwin all 1,$(VRA_WITH_CORP_CODE_SIGNING)) == "",--sign "$(VRA_MACOSX_INSTALLER_SIGN)",) \
		$@
ifdef VRA_SIGNING_MODE
 if $(intersects darwin all 1,$(VRA_WITH_CORP_CODE_SIGNING))
	@# Sign the created pkg.
	$(call VRA_SIGN_PKG_FN,$@,org.virtualbox.pkg.virtualbox)
 endif
endif
	@# Cleanup
	sudo chown -R "$(shell whoami)" \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.root
	sudo chmod -R a-s \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.root
	sudo rm -Rf \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.root \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.desc \
		$(VRA_PATH_PACK_TMP)/VirtualAgent.pkg.res

#
# The VirtualAgent CLI wrapper scripts.
#
$(VRA_PATH_PACK_TMP)/Packages/VirtualAgentCLI.pkg: \
		$$(wildcard \
			$(VRA_PATH_DI_SRC)/VirtualAgentCLI/* \
			$(VRA_PATH_DI_SRC)/VirtualAgentCLI/*.lproj/*) \
		$(foreach f,$(VRA_INSTALLER_ADD_LANGUAGES) \
			,$(VRA_BRAND_$(f)_VIRTUALBOXCLI_DESCRIPTION_PLIST)) \
		$(VRA_DARWIN_INST_DEP_ON_MAKEFILE)
	$(call MSG_TOOL,pkgbuild,,,$@)
	@# Cleanup any previously failed attempts.
	sudo rm -Rf \
		$@ \
		$(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root \
		$(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.desc \
		$(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.res
	@# Correct directory permissions are important.
	$(MKDIR) -p \
		$(@D) \
		$(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.desc \
		$(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.res \
		$(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.res/English.lproj
	$(MKDIR) -p -m 0755 \
		$(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr \
		$(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr/local/bin
	@# Generate the wrapper scripts.
	$(APPEND) -tn  $(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr/local/bin/VirtualAgent \
		'#!/bin/bash' 'exec /Applications/VirtualAgent.app/Contents/MacOS/VirtualAgent "$$@"'
	$(APPEND) -tn  $(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr/local/bin/VirtualAgentVM \
		'#!/bin/bash' 'exec /Applications/VirtualAgent.app/Contents/Resources/VirtualAgentVM.app/Contents/MacOS/VirtualAgentVM "$$@"'
	$(APPEND) -tn  $(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr/local/bin/VBoxManage \
		'#!/bin/bash' 'exec /Applications/VirtualAgent.app/Contents/MacOS/VBoxManage "$$@"'
	$(APPEND) -tn $(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr/local/bin/VBoxVRDP \
		'#!/bin/bash' 'exec /Applications/VirtualAgent.app/Contents/MacOS/VBoxHeadless "$$@"'
	$(APPEND) -tn $(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr/local/bin/VBoxHeadless \
		'#!/bin/bash' 'exec /Applications/VirtualAgent.app/Contents/MacOS/VBoxHeadless "$$@"'
ifdef VRA_WITH_WEBSERVICES
	$(APPEND) -tn $(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr/local/bin/vboxwebsrv \
		'#!/bin/bash' 'exec /Applications/VirtualAgent.app/Contents/MacOS/vboxwebsrv "$$@"'
endif
if defined(VRA_WITH_VRA_IMG) || defined(VRA_WITH_TESTCASES)
	$(APPEND) -tn $(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr/local/bin/vbox-img \
		'#!/bin/bash' 'exec /Applications/VirtualAgent.app/Contents/MacOS/vbox-img "$$@"'
endif
ifdef VRA_WITH_VRAIMGMOUNT
	$(APPEND) -tn $(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr/local/bin/vboximg-mount \
		'#!/bin/bash' 'exec /Applications/VirtualAgent.app/Contents/MacOS/vboximg-mount "$$@"'
endif
ifdef VRA_WITH_FE_BUGREPORT
	$(APPEND) -tn $(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr/local/bin/VBoxBugReport \
		'#!/bin/bash' 'exec /Applications/VirtualAgent.app/Contents/MacOS/VBoxBugReport "$$@"'
endif
ifdef VRA_WITH_FE_BALLOONCTRL
	$(APPEND) -tn $(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr/local/bin/VBoxBalloonCtrl \
		'#!/bin/bash' 'exec /Applications/VirtualAgent.app/Contents/MacOS/VBoxBalloonCtrl "$$@"'
endif
ifdef VRA_WITH_FE_AUTOSTART
	$(APPEND) -tn $(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr/local/bin/VBoxAutostart \
		'#!/bin/bash' 'exec /Applications/VirtualAgent.app/Contents/MacOS/VBoxAutostart "$$@"'
endif
ifdef VRA_WITH_DTRACE
	$(APPEND) -tn $(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr/local/bin/VBoxDTrace \
		'#!/bin/bash' 'exec /Applications/VirtualAgent.app/Contents/MacOS/VBoxDTrace "$$@"'
endif
ifdef VRA_WITH_HOST_SHIPPING_AUDIO_TEST
	$(APPEND) -tn $(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr/local/bin/VBoxAudioTest \
		'#!/bin/bash' 'exec /Applications/VirtualAgent.app/Contents/MacOS/VBoxAudioTest "$$@"'
endif
	@# Set the correct owners and file permissions.
	sudo chmod 0755 $(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr/local/bin/*
	sudo chown    root:admin $(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root
	sudo chown -R root:wheel $(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr
	@# Build the package.
	$(VRA_PKGBUILD) \
		--root   $(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root/usr/local/bin \
		--identifier org.virtualbox.pkg.virtualboxcli \
		--version $(VRA_VERSION_MAJOR).$(VRA_VERSION_MINOR).$(VRA_VERSION_BUILD) \
		--install-location /usr/local/bin \
		--ownership preserve \
		$(if-expr defined(VRA_MACOSX_INSTALLER_SIGN) && $(intersects darwin all 1,$(VRA_WITH_CORP_CODE_SIGNING)) == "",--sign "$(VRA_MACOSX_INSTALLER_SIGN)",) \
		$@
ifdef VRA_SIGNING_MODE
 if $(intersects darwin all 1,$(VRA_WITH_CORP_CODE_SIGNING))
	@# Sign the created pkg.
	$(call VRA_SIGN_PKG_FN,$@,org.virtualbox.pkg.virtualboxcli)
 endif
endif
	@# Cleanup
	sudo chown -R "$(shell whoami)" \
		$(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root
	sudo rm -Rf \
		$(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.root \
		$(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.desc \
		$(VRA_PATH_PACK_TMP)/VirtualAgentCLI.pkg.res

ifdef VRA_WITH_FUSE_PACKING
 #
 # The FUSE for macOS core package.
 #
 VRA_PATH_FUSE_CORE_PKG ?= $(lastword $(sort $(wildcard $(KBUILD_DEVTOOLS_TRG)/osxfuse/v*)))/Core.pkg
 $(VRA_PATH_PACK_TMP)/Packages/OSXFuseCore.pkg: \
 		$(VRA_PATH_FUSE_CORE_PKG)
	$(call MSG_TOOL,Preparing FUSE for macOS core package,,,$@)
	@# Cleanup any previously failed attempts.
	sudo rm -Rf $@
	$(MKDIR) -p $(@D)
	pkgutil --flatten $(VRA_PATH_FUSE_CORE_PKG) $@
endif


#
# Aliases.
#
VBoxKEXTs.pkg: $(VRA_PATH_PACK_TMP)/Packages/VBoxKEXTs.pkg
VirtualAgentCLI.pkg: $(VRA_PATH_PACK_TMP)/Packages/VirtualAgentCLI.pkg
VirtualAgent.pkg: $(VRA_PATH_PACK_TMP)/Packages/VirtualAgent.pkg
VirtualAgent.mpkg: $(VRA_PATH_PACK_TMP)/DiskImage/VirtualAgent.pkg
VirtualAgent.dmg: $(VRA_PATH_DIST)/VirtualAgent-$(VRA_VERSION_STRING)-r$(VRA_SVN_REV).dmg

# Path specifying the .dmg mount point being used with 'kmk mount_dmg' and 'kmk unmount_dmg'.
VRA_PATH_DMG_MOUNTPOINT := /Volumes/VirtualAgent-$(VRA_VERSION_STRING)-r$(VRA_SVN_REV)

# Path to the (temporary) shadow storage, required for editing the .dmg file.
VRA_DMG_SHADOW_STORAGE := $(VRA_PATH_PACK_TMP)/VirtualAgent-$(VRA_VERSION_STRING)-r$(VRA_SVN_REV)-shadow.dmg

#
# Mounts the created .dmg file within Finder in read-write mode using a shadow storage
# which holds the modififed content.
#
# This is needed in order to modify the styling of the .dmg's DS_Store file (which is a
# proprietary file format known by Finder). Needs root.
#
mount_dmg:
	@kmk_builtin_echo "Mounting .dmg file in R/W mode (using shadow storage) ..."
	@sudo hdiutil attach -quiet -readwrite \
		-mountpoint $(VRA_PATH_DMG_MOUNTPOINT) \
		-shadow $(VRA_DMG_SHADOW_STORAGE) \
		$(VRA_PATH_DIST)/VirtualAgent-$(VRA_VERSION_STRING)-r$(VRA_SVN_REV).dmg
	@kmk_builtin_echo ""
	@kmk_builtin_echo "Successfully mounted within Finder."
	@kmk_builtin_echo "You may now alter the .dmg image as needed.
	@kmk_builtin_echo "To save your changes, unmount via 'kmk unmount_dmg'."
	@kmk_builtin_echo "To discard your changes, unmount directly via Finder (eject icon)."

#
# Unmounts the formerly mounted .dmg file and saves the (eventually) altered .DS_Store file from the
# shadow storage back into the SVN repo tree. Needs root.
#
unmount_dmg:
	@kmk_builtin_echo "Unmounting .dmg file ..."
	@kmk_cp $(VRA_PATH_DMG_MOUNTPOINT)/.DS_Store $(PATH_SUB_CURRENT)/DiskImage/DS_Store
	@sudo hdiutil detach -quiet $(VRA_PATH_DMG_MOUNTPOINT)
	@kmk_builtin_echo ""
	@kmk_builtin_echo "Files have been updated within SVN tree. Check what the changes are."

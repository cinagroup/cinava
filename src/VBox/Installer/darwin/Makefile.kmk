 	Info.plist \
 	PkgInfo \
 	$(VRA_DI_VBAPP_DUPLICATED_RESOURCE_FILES) \
 	Resources/VirtualAgentVM.app/Contents/Info.plist \
 	Resources/VirtualAgentVM.app/Contents/PkgInfo \
 	$(addprefix Resources/VirtualAgentVM.app/Contents/,$(VRA_DI_VBAPP_DUPLICATED_RESOURCE_FILES)) \
 	Resources/vmstarter.app/Contents/Info.plist \
 	Resources/vmstarter.app/Contents/PkgInfo \
 	$(addprefix Resources/vmstarter.app/Contents/,$(VRA_DI_VBAPP_DUPLICATED_RESOURCE_FILES))
endif
ifdef VRA_WITH_DOCS_PACKING

 	MacOS/UserManual.pdf
 ifdef VRA_WITH_DOCS_QHELP_PACKING
  VRA_DI_VBAPP_MISC_FILES += \
  	MacOS/UserManual.qch \
  	MacOS/UserManual.qhc
 endif
endif
ifdef VRA_WITH_ADDITIONS_PACKING
 ifneq ($(wildcard $(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/VBoxGuestAdditions.iso),)
  VRA_DI_VBAPP_MISC_FILES += \
  	MacOS/VBoxGuestAdditions.iso
 endif
endif
ifdef VRA_WITH_EFIFW_PACKING

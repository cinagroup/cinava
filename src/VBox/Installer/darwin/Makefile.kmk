 	MacOS/VBoxDxVk.dylib \
 	MacOS/libMoltenVK.dylib
endif
ifdef VRA_WITH_DXMT
 VRA_DI_VBAPP_DYLIBS += \
 	MacOS/VBoxDxMt.dylib
endif

if defined(VRA_WITH_JXPCOM)
 VRA_DI_VBAPP_DYLIBS += \
 	MacOS/libvboxjxpcom.jnilib
endif

if1of ($(VRA_DI_VBAPP_DYLIBS.amd64), $(VRA_DI_VBAPP_DYLIBS.x86))
 $(error Conflict.$(NLTAB)VRA_DI_VBAPP_DYLIBS.amd64=$(VRA_DI_VBAPP_DYLIBS.amd64)$(NLTAB)VRA_DI_VBAPP_DYLIBS.x86  =$(VRA_DI_VBAPP_DYLIBS.x86))
endif
if1of ($(VRA_DI_VBAPP_DYLIBS.amd64) $(VRA_DI_VBAPP_DYLIBS.x86), $(VRA_DI_VBAPP_DYLIBS))
 $(error Conflict.$(NLTAB)VRA_DI_VBAPP_DYLIBS.amd64=$(VRA_DI_VBAPP_DYLIBS.amd64)$(NLTAB)VRA_DI_VBAPP_DYLIBS.x86  =$(VRA_DI_VBAPP_DYLIBS.x86)$(NLTAB)VRA_DI_VBAPP_DYLIBS=$(VRA_DI_VBAPP_DYLIBS))
endif


 if defined(VRA_WITH_QTGUI) && defined(VRA_WITH_DEBUGGER_GUI)
  VRA_DI_VBAPP_DYLIBS += \
  	MacOS/VBoxDbg.dylib
 endif
endif
ifdef VRA_WITH_HARDENING
 VRA_DI_VBAPP_DYLIBS += $(addprefix MacOS/,$(addsuffix .dylib,$(notdir $(VRA_DI_VBAPP_PROGS_HARDENED))))
endif
if defined(VRA_WITH_PYTHON) && "$(VRA_DEF_MACOSX_VERSION_MIN)" vlt "10.13"
 VRA_DI_VBAPP_DYLIBS += \
 	MacOS/VBoxPython2_6.so
endif
if defined(VRA_WITH_PYTHON) && "$(VRA_DEF_MACOSX_VERSION_MIN)" vlt "11.0"
 VRA_DI_VBAPP_DYLIBS += \
 	MacOS/VBoxPython2_7.so
endif
if   defined(VRA_WITH_PYTHON) \
  && !defined(VRA_WITHOUT_PYTHON_LIMITED_API) \
  && exists "$(VRA_PATH_DIST)/VirtualAgent.app/Contents/MacOS/VBoxPython3.so"
 VRA_DI_VBAPP_DYLIBS += \
 	MacOS/VBoxPython3.so
endif
ifdef VRA_WITH_VMSVGA3D

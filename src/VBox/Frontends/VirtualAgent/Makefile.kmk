SUB_DEPTH = ../../../..
include $(KBUILD_PATH)/subheader.kmk


#
# Globals.
#
VRA_VIRTUALBOX_SRC := $(PATH_SUB_CURRENT)
VRA_VIRTUALBOX_OUT_DIR := $(PATH_TARGET)/VirtualAgent/misc
USES += qt6


#
# Targets.
#
ifdef VRA_WITH_HARDENING
 PROGRAMS += VirtualAgent
 PROGRAMS += VirtualAgentHardenedVM
 DLLS += VirtualAgentVM
 DLLS += UICommon
else
 PROGRAMS += VirtualAgent
 PROGRAMS += VirtualAgentVM
 DLLS += UICommon
endif
INSTALLS += VirtualAgent.nls


#
# Include the language lists.
#
include $(PATH_SUB_CURRENT)/nls/ApprovedLanguages.kmk


#
# Hardened VirtualAgentVM.
#
ifdef VRA_WITH_HARDENING
 VirtualAgentHardenedVM_TEMPLATE = VBoxR3HardenedExe
 VirtualAgentHardenedVM_INST.darwin = $(INST_VIRTUALBOX)Contents/Resources/VirtualAgentVM.app/Contents/MacOS/
 VirtualAgentHardenedVM_NAME = VirtualAgentVM
 VirtualAgentHardenedVM_DEFS += $(if $(VRA_WITH_DRIVERLESS_NEM_FALLBACK),VRA_WITH_DRIVERLESS_NEM_FALLBACK,)
 VirtualAgentHardenedVM_SOURCES = src/hardenedmain.cpp
 VirtualAgentHardenedVM_LDFLAGS.win = /SUBSYSTEM:$(if-expr "$(KBUILD_TYPE)" != "release",console,windows)
 $(call VRA_SET_VER_INFO_EXE,VirtualAgentHardenedVM,VirtualAgent Virtual Machine,$(VRA_WINDOWS_ICON_FILE))
endif


#
# Include Qt project file, we'll use FORMS and TRANSLATIONS in
# the VirtualAgent setup below.
#
# This is a bit messy.  We boldly ASSUME that LANGUAGE, IMAGES, FORMS
# and TRANSLATIONS are all unused by kBuild and the host toolchain.
#
SAVED_TEMPLATE := $(TEMPLATE)
include $(PATH_SUB_CURRENT)/VBoxUI.pro
TEMPLATE       := $(SAVED_TEMPLATE)
SAVED_TEMPLATE :=
LANGUAGE       :=
IMAGES         :=
# FORMS and TRANSLATIONS are reset further down.


#
# Perform initial new version check on startup.
# If this setting is disabled the user can still check using the menu.
#
ifndef VRA_OSE
 VRA_WITH_UPDATE_REQUEST := 1
endif


#
# VirtualAgent Manager Application
#
VirtualAgent_TEMPLATE      := VBoxQtGuiExe
VirtualAgent_NAME           = VirtualAgent
VirtualAgent_DEPS           = $(UICommon_0_OUTDIR)/include/COMWrappers
VirtualAgent_SDKS.win       = ReorderCompilerIncs $(VRA_WINPSDK) $(VRA_WINDDK)
VirtualAgent_DEFS           =
VirtualAgent_DEFS          += VRA_IS_QT6_OR_LATER
VirtualAgent_DEFS.debug     = VRA_CHECK_STATE # QT_FATAL_ASSERT
VirtualAgent_DEFS.linux     = VRA_WS_NIX QT_NO_DEPRECATED_WARNINGS
VirtualAgent_DEFS.solaris   = VRA_WS_NIX
VirtualAgent_DEFS.freebsd   = VRA_WS_NIX
VirtualAgent_DEFS.darwin    = VRA_WS_MAC
VirtualAgent_DEFS.win       = VRA_WS_WIN
VirtualAgent_DEFS.linux     += VRA_WITH_MASKED_SEAMLESS VRA_WITH_TRANSLUCENT_SEAMLESS
VirtualAgent_DEFS.solaris   += VRA_WITH_MASKED_SEAMLESS VRA_WITH_TRANSLUCENT_SEAMLESS
VirtualAgent_DEFS.freebsd   += VRA_WITH_MASKED_SEAMLESS VRA_WITH_TRANSLUCENT_SEAMLESS
VirtualAgent_DEFS.darwin    += VRA_WITH_TRANSLUCENT_SEAMLESS # VRA_WITH_MASKED_SEAMLESS
VirtualAgent_DEFS.win       += VRA_WITH_MASKED_SEAMLESS # VRA_WITH_TRANSLUCENT_SEAMLESS
ifdef VRA_WITH_VMNET
 VirtualAgent_DEFS.darwin += VRA_WITH_VMNET
endif
VirtualAgent_DEFS.win       += UNICODE QT_DLL
# Sort alphabetically!
VirtualAgent_DEFS           += \
	$(if $(VRA_GUI_WITH_CUSTOMIZATIONS1),VRA_GUI_WITH_CUSTOMIZATIONS1) \
	$(if $(VRA_GUI_WITH_KEYS_RESET_HANDLER),VRA_GUI_WITH_KEYS_RESET_HANDLER) \
	$(if $(VRA_GUI_WITH_PIDFILE),VRA_GUI_WITH_PIDFILE) \
	$(if $(VRA_WITH_3D_ACCELERATION),VRA_WITH_3D_ACCELERATION) \
	$(if $(VRA_WITH_ADDITIONS_AUTOUPDATE_UI),VRA_WITH_ADDITIONS_AUTOUPDATE_UI) \
	$(if $(VRA_WITH_CLOUD_NET),VRA_WITH_CLOUD_NET) \
	$(if $(VRA_WITH_DRAG_AND_DROP),VRA_WITH_DRAG_AND_DROP) \
	$(if $(VRA_WITH_DRAG_AND_DROP_GH),VRA_WITH_DRAG_AND_DROP_GH) \
	$(if $(VRA_WITH_DRAG_AND_DROP_PROMISES),VRA_WITH_DRAG_AND_DROP_PROMISES) \
	$(if $(VRA_WITH_HARDENING),VRAR3_HARDENED_DLL) \
	$(if $(VRA_WITH_NETFLT)$(eq $(KBUILD_TARGET),freebsd),VRA_WITH_NETFLT) \
	$(if $(VRA_WITH_RAW_MODE),VRA_WITH_RAW_MODE) \
	$(if $(VRA_WITH_SDS),VRA_WITH_SDS,) \
	$(if $(VRA_WITH_UPDATE_REQUEST),VRA_WITH_UPDATE_REQUEST) \
	$(if $(VRA_WITH_VDE),VRA_WITH_VDE) \
	$(if $(VRA_WITH_VIRT_ARMV8),VRA_WITH_VIRT_ARMV8,)
ifdef VRA_WITH_DEBUGGER_GUI
 VirtualAgent_DEFS          += VRA_WITH_DEBUGGER_GUI
 if "$(KBUILD_TYPE)" != "release"
  VirtualAgent_DEFS         += VRA_WITH_DEBUGGER_GUI_MENU
 endif
endif
ifdef VRA_WITH_LIBCURL
 VirtualAgent_DEFS          += VRA_GUI_WITH_NETWORK_MANAGER
 VRA_GUI_WITH_NETWORK_MANAGER := 1
endif
if "$(KBUILD_TYPE)" != "release" || defined(VRA_GUI_WITH_EXTRADATA_MANAGER_UI)
 VirtualAgent_DEFS          += VRA_GUI_WITH_EXTRADATA_MANAGER_UI
endif
if "$(KBUILD_TYPE)" != "release" || defined(VRA_NOTIFICATION_CENTER_WITH_KEEP_BUTTON)
 VirtualAgent_DEFS          += VRA_NOTIFICATION_CENTER_WITH_KEEP_BUTTON
endif
ifndef VRA_WITHOUT_LESS_VIRTUALBOX_INCLUDING
 VirtualAgent_DEFS          += VRA_WITH_LESS_VIRTUALBOX_INCLUDING
endif


#
# VirtualAgent Virtual Machine Application
#
VirtualAgentVM_TEMPLATE       := $(if $(VRA_WITH_HARDENING),VBoxQtGuiDll,VBoxQtGuiSignedExe)
VirtualAgentVM_NAME           = VirtualAgentVM
ifndef VRA_WITH_HARDENING
 VirtualAgentVM_INST.darwin   = $(INST_VIRTUALBOX)Contents/Resources/VirtualAgentVM.app/Contents/MacOS/
endif
VirtualAgentVM_DEPS           = $(UICommon_0_OUTDIR)/include/COMWrappers
VirtualAgentVM_SDKS.win       = ReorderCompilerIncs $(VRA_WINPSDK) $(VRA_WINDDK)
VirtualAgentVM_DEFS           = VRA_RUNTIME_UI
VirtualAgentVM_DEFS          += VRA_IS_QT6_OR_LATER
VirtualAgentVM_DEFS.debug     = VRA_CHECK_STATE # QT_FATAL_ASSERT
VirtualAgentVM_DEFS.linux     = VRA_WS_NIX QT_NO_DEPRECATED_WARNINGS
VirtualAgentVM_DEFS.solaris   = VRA_WS_NIX
VirtualAgentVM_DEFS.freebsd   = VRA_WS_NIX
VirtualAgentVM_DEFS.darwin    = VRA_WS_MAC
VirtualAgentVM_DEFS.win       = VRA_WS_WIN
VirtualAgentVM_DEFS.linux     += VRA_WITH_MASKED_SEAMLESS VRA_WITH_TRANSLUCENT_SEAMLESS
VirtualAgentVM_DEFS.solaris   += VRA_WITH_MASKED_SEAMLESS VRA_WITH_TRANSLUCENT_SEAMLESS
VirtualAgentVM_DEFS.freebsd   += VRA_WITH_MASKED_SEAMLESS VRA_WITH_TRANSLUCENT_SEAMLESS
VirtualAgentVM_DEFS.darwin    += VRA_WITH_TRANSLUCENT_SEAMLESS # VRA_WITH_MASKED_SEAMLESS
VirtualAgentVM_DEFS.win       += VRA_WITH_MASKED_SEAMLESS # VRA_WITH_TRANSLUCENT_SEAMLESS
ifdef VRA_WITH_VMNET
 VirtualAgentVM_DEFS.darwin   += VRA_WITH_VMNET
endif
VirtualAgentVM_DEFS.win       += UNICODE QT_DLL
# Sort alphabetically!
VirtualAgentVM_DEFS           += \
	$(if $(VRA_GUI_WITH_CUSTOMIZATIONS1),VRA_GUI_WITH_CUSTOMIZATIONS1) \
	$(if $(VRA_GUI_WITH_KEYS_RESET_HANDLER),VRA_GUI_WITH_KEYS_RESET_HANDLER) \
	$(if $(VRA_GUI_WITH_PIDFILE),VRA_GUI_WITH_PIDFILE) \
	$(if $(VRA_WITH_3D_ACCELERATION),VRA_WITH_3D_ACCELERATION) \
	$(if $(VRA_WITH_ADDITIONS_AUTOUPDATE_UI),VRA_WITH_ADDITIONS_AUTOUPDATE_UI) \
	$(if $(VRA_WITH_DRAG_AND_DROP),VRA_WITH_DRAG_AND_DROP) \
	$(if $(VRA_WITH_DRAG_AND_DROP_GH),VRA_WITH_DRAG_AND_DROP_GH) \
	$(if $(VRA_WITH_DRAG_AND_DROP_PROMISES),VRA_WITH_DRAG_AND_DROP_PROMISES) \
	$(if $(VRA_WITH_HARDENING),VRAR3_HARDENED_DLL) \
	$(if $(VRA_WITH_NETFLT)$(eq $(KBUILD_TARGET),freebsd),VRA_WITH_NETFLT) \
	$(if $(VRA_WITH_RAW_MODE),VRA_WITH_RAW_MODE) \
	$(if $(VRA_WITH_SDS),VRA_WITH_SDS,) \
	$(if $(VRA_WITH_UPDATE_REQUEST),VRA_WITH_UPDATE_REQUEST) \
	$(if $(VRA_WITH_VDE),VRA_WITH_VDE) \
	$(if $(VRA_WITH_VIRT_ARMV8),VRA_WITH_VIRT_ARMV8,)
ifdef VRA_WITH_DEBUGGER_GUI
 VirtualAgentVM_DEFS          += VRA_WITH_DEBUGGER_GUI
 if "$(KBUILD_TYPE)" != "release"
  VirtualAgentVM_DEFS         += VRA_WITH_DEBUGGER_GUI_MENU
 endif
endif
ifdef VRA_WITH_LIBCURL
 VirtualAgentVM_DEFS          += VRA_GUI_WITH_NETWORK_MANAGER
 VRA_GUI_WITH_NETWORK_MANAGER := 1
endif
if "$(KBUILD_TYPE)" != "release" || defined(VRA_GUI_WITH_EXTRADATA_MANAGER_UI)
 VirtualAgentVM_DEFS          += VRA_GUI_WITH_EXTRADATA_MANAGER_UI
endif
if "$(KBUILD_TYPE)" != "release" || defined(VRA_NOTIFICATION_CENTER_WITH_KEEP_BUTTON)
 VirtualAgentVM_DEFS          += VRA_NOTIFICATION_CENTER_WITH_KEEP_BUTTON
endif
ifndef VRA_WITHOUT_LESS_VIRTUALBOX_INCLUDING
 VirtualAgentVM_DEFS          += VRA_WITH_LESS_VIRTUALBOX_INCLUDING
endif


#
# VirtualAgent - GUI Global Shared Library.
#
UICommon_TEMPLATE = VBoxQtGuiDll
UICommon_NAME = UICommon
UICommon_DEFS         = VRA_GUI_LIBRARY
UICommon_DEFS        += VRA_IS_QT6_OR_LATER
UICommon_DEFS.darwin  = VRA_WS_MAC
UICommon_DEFS.freebsd = VRA_WS_NIX
UICommon_DEFS.linux   = VRA_WS_NIX QT_NO_DEPRECATED_WARNINGS
UICommon_DEFS.solaris = VRA_WS_NIX
UICommon_DEFS.win     = VRA_WS_WIN
UICommon_DEFS.debug   = VRA_CHECK_STATE # QT_FATAL_ASSERT
ifdef VRA_WITH_VMNET
 UICommon_DEFS.darwin += VRA_WITH_VMNET
endif
#UICommon_DEFS.win     += UNICODE QT_DLL
# Sort alphabetically!
UICommon_DEFS         += \
	$(if $(VRA_GUI_WITH_CUSTOMIZATIONS1),VRA_GUI_WITH_CUSTOMIZATIONS1) \
	$(if $(VRA_GUI_WITH_PIDFILE),VRA_GUI_WITH_PIDFILE) \
	$(if $(VRA_WITH_3D_ACCELERATION),VRA_WITH_3D_ACCELERATION) \
	$(if $(VRA_WITH_CLOUD_NET),VRA_WITH_CLOUD_NET) \
	$(if $(VRA_WITH_DOCS_QHELP),VRA_WITH_DOCS_QHELP) \
	$(if $(VRA_WITH_DRAG_AND_DROP),VRA_WITH_DRAG_AND_DROP) \
	$(if $(VRA_WITH_HARDENING),VRAR3_HARDENED_DLL) \
	$(if $(VRA_WITH_NETFLT)$(eq $(KBUILD_TARGET),freebsd),VRA_WITH_NETFLT) \
	$(if $(VRA_WITH_RAW_MODE),VRA_WITH_RAW_MODE) \
	$(if $(VRA_WITH_SCREENSAVER_CONTROL),VRA_WITH_SCREENSAVER_CONTROL) \
	$(if $(VRA_WITH_SDS),VRA_WITH_SDS,) \
	$(if $(VRA_WITH_UPDATE_AGENT),VRA_WITH_UPDATE_AGENT) \
	$(if $(VRA_WITH_UPDATE_REQUEST),VRA_WITH_UPDATE_REQUEST) \
	$(if $(VRA_WITH_VDE),VRA_WITH_VDE) \
	$(if $(VRA_WITH_VIRT_ARMV8),VRA_WITH_VIRT_ARMV8,)
ifdef VRA_WITH_DEBUGGER_GUI
 UICommon_DEFS        += VRA_WITH_DEBUGGER_GUI
 if "$(KBUILD_TYPE)" != "release"
  UICommon_DEFS       += VRA_WITH_DEBUGGER_GUI_MENU
 endif
endif
ifdef VRA_WITH_LIBCURL
 UICommon_DEFS        += VRA_GUI_WITH_NETWORK_MANAGER
 VRA_GUI_WITH_NETWORK_MANAGER := 1
endif
if "$(KBUILD_TYPE)" != "release" || defined(VRA_GUI_WITH_EXTRADATA_MANAGER_UI)
 UICommon_DEFS        += VRA_GUI_WITH_EXTRADATA_MANAGER_UI
endif
if "$(KBUILD_TYPE)" != "release" || defined(VRA_NOTIFICATION_CENTER_WITH_KEEP_BUTTON)
 UICommon_DEFS        += VRA_NOTIFICATION_CENTER_WITH_KEEP_BUTTON
endif
ifndef VRA_WITHOUT_LESS_VIRTUALBOX_INCLUDING
 UICommon_DEFS        += VRA_WITH_LESS_VIRTUALBOX_INCLUDING
endif


#
# Include folders.
#
VRA_GUI_INC_DIRS = \
	./src \
	./src/cloud \
	./src/cloud/consolemanager \
	./src/cloud/machinesettings \
	./src/cloud/profilemanager \
	./src/converter \
	./src/extensionpackmanager \
	./src/extensions \
	./src/extensions/graphics \
	./src/extradata \
	./src/globals \
	./src/helpbrowser \
	./src/logviewer \
	./src/medium \
	./src/medium/viso \
	./src/networkmanager \
	./src/notificationcenter \
	./src/objects \
	./src/platform \
	./src/platform/darwin \
	./src/platform/win \
	./src/platform/nix \
	./src/runtime \
	./src/runtime/fullscreen \
	./src/runtime/normal \
	./src/runtime/scale \
	./src/runtime/seamless \
	./src/runtime/information \
	./src/guestctrl \
	./src/settings \
	./src/settings/editors \
	./src/settings/global \
	./src/settings/machine \
	./src/softkeyboard \
	./src/snapshots \
	./src/usb \
	./src/widgets \
	./src/widgets/graphics \
	./src/wizards \
	./src/wizards/addcloudvm \
	./src/wizards/newcloudvm \
	./src/wizards/newvm \
	./src/wizards/newvd \
	./src/wizards/clonevm \
	./src/wizards/exportappliance \
	./src/wizards/importappliance \
	./src/wizards/editors

VRA_GUI_INC_DIRS += \
	./src/manager \
	./src/manager/chooser \
	./src/manager/details \
	./src/manager/tools \
	./src/activity \
	./src/activity/overview \
	./src/activity/vmactivity

ifdef VRA_GUI_WITH_NETWORK_MANAGER
 VRA_GUI_INC_DIRS += \
 	./src/networking
endif

#
# VirtualAgent Manager Application
# Include folders.
#
VirtualAgent_INCS = \
	$(VRA_GUI_INC_DIRS) \
	$(UICommon_0_OUTDIR)/include \
	$(VRA_GRAPHICS_INCS)

#
# VirtualAgent Virtual Machine Application
# Include folders.
#
VirtualAgentVM_INCS = \
	$(VRA_GUI_INC_DIRS) \
	$(UICommon_0_OUTDIR)/include \
	$(VRA_GRAPHICS_INCS)

#
# VirtualAgent - GUI Global Shared Library.
# Include folders.
#
UICommon_INCS = \
	$(VRA_GUI_INC_DIRS) \
	$(UICommon_0_OUTDIR)/include


#
# VirtualAgent Manager Application
# Compiling/linking flags.
#
ifneq ($(KBUILD_TARGET),win)
 VirtualAgent_CXXFLAGS += -Wno-switch
endif

VirtualAgent_CXXFLAGS.win += /permissive-
VirtualAgent_CXXFLAGS.linux += $(VRA_GCC_Wno-class-memaccess)

## @todo we're using a number of deprecated APIs, please fix and remove these!
VirtualAgent_CXXFLAGS.darwin    += -Wno-error=deprecated-declarations
VirtualAgent_OBJCFLAGS.darwin   += -Wno-error=deprecated-declarations
VirtualAgent_OBJCXXFLAGS.darwin += -Wno-error=deprecated-declarations

ifeq ($(KBUILD_TYPE),release)
 VirtualAgent_LDFLAGS.win   += /SUBSYSTEM:windows
else
 VirtualAgent_LDFLAGS.linux += -rdynamic # for backtrace_symbols()
 VirtualAgent_LDFLAGS.win   += /SUBSYSTEM:console
endif

#
# Parfait fails with an error that ../MacOS can't be accessed while standard clang has no problem with it.
# As we don't want to run the output just omit the -rpath arguments to make it build
#
VirtualAgent_LDFLAGS.darwin = \
	$(if-expr $(VRA_WITH_HARDENING) || $(VRA_WITH_PARFAIT),,-rpath @executable_path/../MacOS -rpath @executable_path/../Frameworks) \
	-framework AppKit -framework Carbon -framework IOKit


#
# VirtualAgent Virtual Machine Application
# Compiling/linking flags.
#
ifneq ($(KBUILD_TARGET),win)
 VirtualAgentVM_CXXFLAGS += -Wno-switch
endif

VirtualAgentVM_CXXFLAGS.win += /permissive-
VirtualAgentVM_CXXFLAGS.linux += $(VRA_GCC_Wno-class-memaccess)

## @todo we're using a number of deprecated APIs, please fix and remove these!
VirtualAgentVM_CXXFLAGS.darwin    += -Wno-error=deprecated-declarations
VirtualAgentVM_OBJCFLAGS.darwin   += -Wno-error=deprecated-declarations
VirtualAgentVM_OBJCXXFLAGS.darwin += -Wno-error=deprecated-declarations

ifeq ($(KBUILD_TYPE),release)
 VirtualAgentVM_LDFLAGS.win   += /SUBSYSTEM:windows
else
 VirtualAgentVM_LDFLAGS.linux += -rdynamic # for backtrace_symbols()
 VirtualAgentVM_LDFLAGS.win   += /SUBSYSTEM:console
endif

#
# Parfait fails with an error that ../MacOS can't be accessed while standard clang has no problem with it.
# As we don't want to run the output just omit the -rpath arguments to make it build
#
ifndef VRA_WITH_PARFAIT
 VirtualAgentVM_LDFLAGS.darwin = \
 	$(if $(VRA_WITH_HARDENING) \
 		,-install_name $(VRA_DYLD_EXECUTABLE_PATH)/VirtualAgentVM.dylib \
 		,-rpath @executable_path/../../../../MacOS \
 		-rpath @executable_path/../../../../Frameworks) \
 	-framework AppKit -framework Carbon -framework IOKit
else
 VirtualAgentVM_LDFLAGS.darwin = -framework AppKit -framework Carbon -framework IOKit
endif


#
# VirtualAgent - GUI Global Shared Library.
# Compiling/linking flags.
#

UICommon_CXXFLAGS.linux += $(VRA_GCC_Wno-class-memaccess)
UICommon_CXXFLAGS.win += -wd4868 # prevents std::stable_sort from using functor/function comparator
UICommon_CXXFLAGS.win += -bigobj # COMWrappers.cpp fails with too many sections on win64-dep otherwise.
UICommon_CXXFLAGS.win += /permissive-

## @todo we're using a number of deprecated APIs, please fix and remove these!
UICommon_CXXFLAGS.darwin    += -Wno-error=deprecated-declarations
UICommon_OBJCFLAGS.darwin   += -Wno-error=deprecated-declarations
UICommon_OBJCXXFLAGS.darwin += -Wno-error=deprecated-declarations

UICommon_LDFLAGS.darwin = \
	-install_name "$(VRA_DYLD_EXECUTABLE_PATH)/UICommon.dylib" \
	-framework AppKit \
	-framework Carbon \
	-framework IOKit

#
# VirtualAgent Manager Application
# Libraries.
#

# Library required for the hdd backend enumeration:
VirtualAgent_LIBS = $(LIB_DDU)

# Runtime library loader required on X11 hosts:
if1of ($(KBUILD_TARGET), linux netbsd openbsd)
 VirtualAgent_LIBS += dl
endif

# XCB library required for direct XCB native code support:
VirtualAgent_LIBS.linux   += xcb
VirtualAgent_LIBS.solaris += xcb
VirtualAgent_LIBS.freebsd += xcb

# Various Windows hosts libraries:
VirtualAgent_LIBS.win = \
	$(PATH_SDK_$(VRA_WINPSDK)_LIB)/Htmlhelp.Lib
VirtualAgent_LIBS.win += \
	$(PATH_SDK_$(VRA_WINPSDK)_LIB)/ddraw.lib \
	$(PATH_SDK_$(VRA_WINPSDK)_LIB)/dxguid.lib

# VBox keyboard shared library for X11 hosts:
if1of ($(KBUILD_TARGET), freebsd linux netbsd openbsd solaris)
 VirtualAgent_LIBS += $(PATH_STAGE_DLL)/VBoxKeyboard$(VRA_SUFF_DLL)
endif

# This one is global shared GUI library:
ifeq ($(KBUILD_TARGET),win)
 VirtualAgent_LIBS += $(PATH_STAGE_LIB)/UICommon$(VRA_SUFF_LIB)
else
 VirtualAgent_LIBS += $(PATH_STAGE_DLL)/UICommon$(VRA_SUFF_DLL)
endif


#
# VirtualAgent Virtual Machine Application
# Libraries.
#

# Library required for the hdd backend enumeration:
VirtualAgentVM_LIBS = $(LIB_DDU)

# Runtime library loader required on X11 hosts:
if1of ($(KBUILD_TARGET), linux netbsd openbsd)
 VirtualAgentVM_LIBS += dl
endif

# XCB library required for direct XCB native code support:
VirtualAgentVM_LIBS.linux   += xcb
VirtualAgentVM_LIBS.solaris += xcb
VirtualAgentVM_LIBS.freebsd += xcb

# Various Windows hosts libraries:
VirtualAgentVM_LIBS.win = \
	$(PATH_SDK_$(VRA_WINPSDK)_LIB)/Htmlhelp.Lib
VirtualAgentVM_LIBS.win += \
	$(PATH_SDK_$(VRA_WINPSDK)_LIB)/ddraw.lib \
	$(PATH_SDK_$(VRA_WINPSDK)_LIB)/dxguid.lib

# VBox keyboard shared library for X11 hosts:
if1of ($(KBUILD_TARGET), freebsd linux netbsd openbsd solaris)
 VirtualAgentVM_LIBS += $(PATH_STAGE_DLL)/VBoxKeyboard$(VRA_SUFF_DLL)
endif

ifeq ($(KBUILD_TARGET),win)
 VirtualAgentVM_LIBS += $(PATH_STAGE_LIB)/UICommon$(VRA_SUFF_LIB)
else
 VirtualAgentVM_LIBS += $(PATH_STAGE_DLL)/UICommon$(VRA_SUFF_DLL)
endif


#
# VirtualAgent - GUI Global Shared Library.
# Libraries.
#

# Various Windows hosts libraries:
UICommon_LIBS.win = \
	$(PATH_SDK_$(VRA_WINPSDK)_LIB)/Htmlhelp.Lib

# VBox keyboard shared library for X11 hosts:
if1of ($(KBUILD_TARGET), freebsd linux netbsd openbsd solaris)
 UICommon_LIBS += $(PATH_STAGE_DLL)/VBoxKeyboard$(VRA_SUFF_DLL)
endif


#
# VirtualAgent Manager Application
# Headers containing definitions of classes that use the Q_OBJECT macro.

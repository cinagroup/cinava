#
# VirtualAgent Manager Application
# Deployment.
#
if defined(VRA_WITH_ORACLE_QT) || defined(VRA_WITH_QT_PAYLOAD)
 INSTALLS.linux += VirtualAgent.qt.conf
 INSTALLS.solaris += VirtualAgent.qt.conf
 VirtualAgent.qt.conf_INST = $(INST_BIN)
 VirtualAgent.qt.conf_MODE = 644
 VirtualAgent.qt.conf_SOURCES = $(VirtualAgent_0_OUTDIR)/qt.conf=>qt.conf

 $$(VirtualAgent_0_OUTDIR)/qt.conf: $(PATH_SUB_CURRENT)/Makefile.kmk $(VRA_VERSION_MK) | $$(@D)/
	$(QUIET)$(RM) -f $@
	$(QUIET)$(APPEND) $@ "[Paths]"
	$(QUIET)$(APPEND) $@ "Plugins =" $(PATH_OUT)/$(INST_BIN)/plugins
endif


#
# VirtualAgent Manager Application
# The Qt modules we're using.
# (The include directory and lib/framework for each module will be added by the Qt unit.)
#
VirtualAgent_QT_MODULES = Core Gui Widgets PrintSupport 
VirtualAgent_QT_MODULES.win += EntryPoint


#
# VirtualAgent Virtual Machine Application
# The Qt modules we're using.
# (The include directory and lib/framework for each module will be added by the Qt unit.)
#
VirtualAgentVM_QT_MODULES = Core Gui Widgets PrintSupport 
VirtualAgentVM_QT_MODULES.win += EntryPoint


#
# VirtualAgent - GUI Global Shared Library.
# The Qt modules we're using.
# (The include directory and lib/framework for each module will be added by the Qt unit.)
#
UICommon_QT_MODULES = Core Gui Widgets Help 
ifdef VRA_WITH_SCREENSAVER_CONTROL
 UICommon_QT_MODULES.linux    += DBus
 UICommon_QT_MODULES.linux    += Xml
endif
ifdef VRA_WITH_SCREENSAVER_CONTROL
 UICommon_QT_MODULES.solaris  += DBus
 UICommon_QT_MODULES.solaris  += Xml
endif
ifdef VRA_WITH_SCREENSAVER_CONTROL
 UICommon_QT_MODULES.freebsd  += DBus
 UICommon_QT_MODULES.freebsd  += Xml
endif


# Pull in the ui files
$(eval VirtualAgent_SOURCES += $(FORMS))
$(eval VirtualAgentVM_SOURCES += $(FORMS))
$(eval UICommon_SOURCES += $(FORMS))


# Resource files with some OSE differences (VirtualAgentBrand.qrc is created further down).
UICommon_SOURCES          += VirtualAgent1.qrc
VirtualAgent1.qrc_RCCFLAGS     = -name BASIC1
UICommon_SOURCES          += VirtualAgent2.qrc
VirtualAgent2.qrc_RCCFLAGS     = -name BASIC2
UICommon_SOURCES          += VirtualAgent1_x2.qrc
VirtualAgent1_x2.qrc_RCCFLAGS  = -name BASIC1_X2
UICommon_SOURCES          += VirtualAgent2_x2.qrc
VirtualAgent2_x2.qrc_RCCFLAGS  = -name BASIC2_X2
UICommon_SOURCES          += VirtualAgent1_x3.qrc
VirtualAgent1_x3.qrc_RCCFLAGS  = -name BASIC1_X3
UICommon_SOURCES          += VirtualAgent2_x3.qrc
VirtualAgent2_x3.qrc_RCCFLAGS  = -name BASIC2_X3
UICommon_SOURCES          += VirtualAgent1_x4.qrc
VirtualAgent1_x4.qrc_RCCFLAGS  = -name BASIC1_X4
UICommon_SOURCES          += VirtualAgent2_x4.qrc
VirtualAgent2_x4.qrc_RCCFLAGS  = -name BASIC2_X4
UICommon_SOURCES          += VirtualAgent_xml.qrc
VirtualAgent_xml.qrc_RCCFLAGS  = -name BASIC_XML
UICommon_SOURCES += $(VRA_VIRTUALBOX_OUT_DIR)/VirtualAgentBrand.qrc
$(VRA_VIRTUALBOX_OUT_DIR)/VirtualAgentBrand.qrc_RCCFLAGS = -name BRAND


# Import the translation source from VBoxUI.pro and add the qt_xx_YY counterparts
VirtualAgent_QT_TRANSLATIONS := $(TRANSLATIONS) \
	$(patsubst nls/VirtualAgent_%.ts,nls/qt_%.ts, $(filter nls/VirtualAgent_%.ts,$(TRANSLATIONS)))
# Compress the translation units.
VirtualAgent_LRCFLAGS = -silent
# Where to install the translations (a separate install target, VirtualAgent-nls-inst is created).
VirtualAgent_QT_TRANSLATIONS_INST = $(INST_BIN)nls/
# All files which contain translatable strings.
VirtualAgent_VRA_ALL_NLS_SOURCES = $(VirtualAgent_SOURCES) $(VirtualAgentVM_SOURCES) $(UICommon_SOURCES)


## @todo how to detect what tool is used?
## @todo GCC3 seems to lack -Wno-missing-base-class-initializer, so we use
#  more generic -Wno-extra
# bird: What about $(if $(VRA_GCC_Wno-missing-base-class-initializer),$(VRA_GCC_Wno-missing-base-class-initializer),$(VRA_GCC_Wno-extra))?
ifdef VRA_WITH_XPCOM
 VirtualAgent_src/globals/COMDefs.cpp_CXXFLAGS  = $(VRA_GCC_Wno-extra)
endif


#
# Build generated COM wrappers as part of app.
# VirtualAgent - GUI Global Shared Library.
#
includedep $(PATH_TARGET)/UICommonComWrapperFiles.dep
UICommon_BLDDIRS       += $(UICommon_0_OUTDIR)/include
UICommon_INTERMEDIATES += $(UICommon_0_OUTDIR)/include/COMWrappers
UICommon_SOURCES       += $(UICommon_0_OUTDIR)/include/COMWrappers.cpp
UICommon_CLEAN         += $(wildcard $(UICommon_0_OUTDIR)/include/*) $(PATH_TARGET)/UICommonComWrapperFiles.dep

## @todo kmk doesn't remake optional outputs when they are missing...
$$(UICommon_0_OUTDIR)/include/COMWrappers \
+ $(PATH_TARGET)/UICommonComWrapperFiles.dep \
+| $(if-expr defined(UICommon_VRA_COMWRAPPERS) \
	, $(UICommon_VRA_COMWRAPPERS) \
	, $$(UICommon_0_OUTDIR)/include/COMEnums.h \
	$$(UICommon_0_OUTDIR)/include/COMWrappers.cpp \
	): \
		$(VRA_XIDL_FILE) \
		$(VRA_VIRTUALBOX_SRC)/src/globals/COMWrappers.xsl \
		$(VRA_FILESPLIT) \
		| $$(dir $$@)
	$(call MSG_GENERATE,UICommon,$<,$@)
	$(QUIET)$(RM) -f -- "$@" "$(PATH_TARGET)/UICommonComWrapperFiles.dep"
	$(QUIET)$(VRA_XSLTPROC) -o $@ \
		$(VRA_VIRTUALBOX_SRC)/src/globals/COMWrappers.xsl $<
	$(QUIET)$(VRA_FILESPLIT) $@ $(UICommon_0_OUTDIR)/include \
		$(PATH_TARGET)/UICommonComWrapperFiles.dep UICommon_VRA_COMWRAPPERS
	$(APPEND) "$@"

# alias for generating the COM Wrappers file.
testwrappers:: $$(UICommon_0_OUTDIR)/include/COMWrappers


#
# Generate qrc file with branded icons.
#
VirtualAgent_BLDDIRS       += $(VRA_VIRTUALBOX_OUT_DIR)
VirtualAgent_CLEAN         += $(VRA_VIRTUALBOX_OUT_DIR)/VirtualAgentBrand.qrc
$(VRA_VIRTUALBOX_OUT_DIR)/VirtualAgentBrand.qrc: \
		$(VRA_VIRTUALBOX_SRC)/VirtualAgentBrand.qrc \
		$(PATH_ROOT)/Config.kmk \
		| $$(dir $$@)
	$(call MSG_GENERATE,VirtualAgent,$<,$@)
	$(QUIET)$(SED) \
		-e 's;@VRA_ABOUT_PNG@;$(VRA_BRAND_GUI_ABOUT_PNG);g' \
		-e 's;@VRA_ABOUT_X2_PNG@;$(VRA_BRAND_GUI_ABOUT_X2_PNG);g' \
		-e 's;@VRA_ABOUT_X3_PNG@;$(VRA_BRAND_GUI_ABOUT_X3_PNG);g' \
		-e 's;@VRA_ABOUT_X4_PNG@;$(VRA_BRAND_GUI_ABOUT_X4_PNG);g' \
		-e 's;@VRA_ABOUT_16PX_PNG@;$(VRA_BRAND_GUI_ABOUT_16PX_PNG);g' \
		-e 's;@VRA_ABOUT_16PX_X2_PNG@;$(VRA_BRAND_GUI_ABOUT_16PX_X2_PNG);g' \
		-e 's;@VRA_ABOUT_16PX_X3_PNG@;$(VRA_BRAND_GUI_ABOUT_16PX_X3_PNG);g' \
		-e 's;@VRA_ABOUT_16PX_X4_PNG@;$(VRA_BRAND_GUI_ABOUT_16PX_X4_PNG);g' \
		-e 's;@VRA_VRA_16PX_PNG@;$(VRA_BRAND_GUI_VRA_16PX_PNG);g' \
		-e 's;@VRA_VRA_20PX_PNG@;$(VRA_BRAND_GUI_VRA_20PX_PNG);g' \
		-e 's;@VRA_VRA_32PX_PNG@;$(VRA_BRAND_GUI_VRA_32PX_PNG);g' \
		-e 's;@VRA_VRA_40PX_PNG@;$(VRA_BRAND_GUI_VRA_40PX_PNG);g' \
		-e 's;@VRA_VRA_48PX_PNG@;$(VRA_BRAND_GUI_VRA_48PX_PNG);g' \
		-e 's;@VRA_VRA_64PX_PNG@;$(VRA_BRAND_GUI_VRA_64PX_PNG);g' \
		-e 's;@VRA_CUBE_SVG@;$(VRA_BRAND_GUI_VRA_SVG);g' \
		--output $@ \
		$<


#
# Precompiled header
# 	win.amd64 without:  kmk_time: 3m51.962058s
# 	win.amd64 with:     kmk_time: 2m23.336252s
#      linux.amd64 without: time: real 1m03.719s   user 26m26.766s  sys 2m03.526s
#      linux.amd64 with:    time: real 0m42.650s   user 14m46.332s  sys 1m28.463s
#
if defined(VRA_WITH_PRECOMPILED_HEADERS) && !defined(VRA_WITHOUT_PRECOMPILED_HEADERS)
 if1of ($(KBUILD_TARGET), win)
  VirtualAgent_USES      += vccprecomp
  VirtualAgent_PCH_HDR   := $(PATH_SUB_CURRENT)/src/precomp_vcc.h

  VirtualAgentVM_USES    += vccprecomp
  VirtualAgentVM_PCH_HDR := $(PATH_SUB_CURRENT)/src/precomp_vcc.h

  UICommon_USES      += vccprecomp
  UICommon_PCH_HDR   := $(PATH_SUB_CURRENT)/src/precomp_vcc.h

 else if $(KBUILD_KMK_REVISION) >= 3256 && "$(KBUILD_TARGET)" != "darwin" && !defined(VRA_WITHOUT_PRECOMPILED_HEADERS)
  if $(VRA_GCC_VERSION_CXX) >= 50000 # GCC 4.x runs into trouble compiling the header.
   UICommon_USES      += gccprecomp
   UICommon_PCH_HDR   := $(PATH_SUB_CURRENT)/src/precomp_gcc.h
   #UICommon_CXXFLAGS.linux += -H

   VirtualAgent_USES      += gccprecomp
   VirtualAgent_PCH_HDR   := $(PATH_SUB_CURRENT)/src/precomp_gcc.h
   #VirtualAgent_CXXFLAGS.linux += -H

   VirtualAgentVM_USES    += gccprecomp
   VirtualAgentVM_PCH_HDR := $(PATH_SUB_CURRENT)/src/precomp_gcc.h
   #VirtualAgentVM_CXXFLAGS.linux += -H

   # GCC precompiled headers seems to work more efficiently when #pragma once is involved.
   # So, we've cooked our own camel cased qt wrapper headers with #pragma once inside.
   VRA_GUI_INC_DIRS <= precomptricks
  endif
 endif
endif

ifeq ($(KBUILD_TARGET),win)
 #
 # On Windows we'll have to generate/edit part of the resource file.
 # The IDI_ICON1 name is Qt specific.
 #
 src/platform/win/VirtualAgent.rc_INCS = $(VirtualAgent_0_OUTDIR)
 src/platform/win/VirtualAgent.rc_DEPS = $(VirtualAgent_0_OUTDIR)/VirtualAgent-icon.rc
 src/platform/win/VirtualAgent.rc_CLEAN = $(VirtualAgent_0_OUTDIR)/VirtualAgent-icon.rc
 src/platform/win/VirtualAgentVM.rc_INCS = $(VirtualAgent_0_OUTDIR)
 src/platform/win/VirtualAgentVM.rc_DEPS = $(VirtualAgent_0_OUTDIR)/VirtualAgent-icon.rc
 src/platform/win/VirtualAgentVM.rc_CLEAN = $(VirtualAgent_0_OUTDIR)/VirtualAgent-icon.rc

 $$(VirtualAgent_0_OUTDIR)/VirtualAgent-icon.rc: $(MAKEFILE_CURRENT) $(VRA_WINDOWS_ICON_FILE) | $$(dir $$@)
	$(APPEND) -t $@ 'IDI_ICON1 ICON "$(subst /,\\,$(VRA_WINDOWS_ICON_FILE))"'

endif # win


#
# Unset everything that was loaded from VBoxUI.pro.
#
FORMS :=
TRANSLATIONS :=



ifeq ($(KBUILD_TARGET),win)
 #
 # Install the visual manifest and associated PNGs.
 #
 INSTALLS.win += VirtualAgentManifest
 VirtualAgentManifest_INST = $(INST_VIRTUALBOX)
 VirtualAgentManifest_DEFPATH = $(PATH_ROOT)/src/VBox/Artwork/$(if-expr defined(VRA_OSE),OSE,NonOSE)/
 VirtualAgentManifest_SOURCES := \
 	virtualbox-70px.png=>VirtualAgent_70px.png \
 	virtualbox-150px.png=>VirtualAgent_150px.png \
 	$(PATH_SUB_CURRENT)/src/platform/win/VirtualAgent.VisualElementsManifest.xml

endif


ifeq ($(KBUILD_TARGET),darwin)
 #
 # Create directories for each approved language or the application
 # menu won't be translated.
 #
 INSTALLS += VirtualAgent.lproj
 VirtualAgent.lproj_INST = $(INST_VIRTUALBOX)Contents/Resources/
 VirtualAgent.lproj_MODE = 755
 VirtualAgent.lproj_DIRS := $(addsuffix .lproj,$(VRA_APPROVED_GUI_LANGUAGES))

 #
 # On OS X (darwin) we need to install icon resources and compulsory bundle contents.
 # The VirtualAgentVM.app helper is for launching VMs (fixes some issues with the dock).
 #
 INSTALLS += VirtualAgent.app
 VirtualAgent.app_INST = $(INST_VIRTUALBOX)Contents/
 VirtualAgent.app_MODE = 644
 VirtualAgent.app_SOURCES = \
 	src/platform/darwin/PkgInfo \
 	$(VirtualAgent.app_0_OUTDIR)/Info.plist \
 	$(VRA_MACOSX_ICON_FILE)=>Resources/virtualbox.icns \
 	$(VRA_BRAND_GUI_VRA_64PX_PNG)=>Resources/virtualbox.png \
 	$(PATH_ROOT)/src/VBox/Artwork/darwin/virtualbox-vbox.icns=>Resources/virtualbox-vbox.icns \
 	$(PATH_ROOT)/src/VBox/Artwork/darwin/virtualbox-vbox-extpack.icns=>Resources/virtualbox-vbox-extpack.icns \
 	$(PATH_ROOT)/src/VBox/Artwork/darwin/virtualbox-ovf.icns=>Resources/virtualbox-ovf.icns \
 	$(PATH_ROOT)/src/VBox/Artwork/darwin/virtualbox-ova.icns=>Resources/virtualbox-ova.icns \
 	$(PATH_ROOT)/src/VBox/Artwork/darwin/virtualbox-vdi.icns=>Resources/virtualbox-vdi.icns \
 	$(PATH_ROOT)/src/VBox/Artwork/darwin/virtualbox-vmdk.icns=>Resources/virtualbox-vmdk.icns \
 	$(PATH_ROOT)/src/VBox/Artwork/darwin/virtualbox-vhd.icns=>Resources/virtualbox-vhd.icns \
 	$(PATH_ROOT)/src/VBox/Artwork/darwin/virtualbox-hdd.icns=>Resources/virtualbox-hdd.icns

 # Qt5 requires qt.conf on Mac OS X:
 VirtualAgent.app_SOURCES += \
 	$(VirtualAgent.app_0_OUTDIR)/qt.conf=>Resources/qt.conf

 $$(VirtualAgent.app_0_OUTDIR)/Info.plist: $(PATH_SUB_CURRENT)/src/platform/darwin/Info.plist $(VRA_VERSION_MK) | $$(@D)/
	$(call MSG_GENERATE,VirtualAgent.app,$<,$@)
	$(QUIET)$(RM) -f $@
	$(QUIET)$(SED) \
		-e 's+@VRA_VERSION_STRING@+$(VRA_VERSION_STRING)+g' \
		-e 's+@VRA_VERSION_MAJOR@+$(VRA_VERSION_MAJOR)+g' \
		-e 's+@VRA_VERSION_MINOR@+$(VRA_VERSION_MINOR)+g' \
		-e 's+@VRA_VERSION_BUILD@+$(VRA_VERSION_BUILD)+g' \
		-e 's+@VRA_VENDOR@+$(VRA_VENDOR)+g' \
		-e 's+@VRA_PRODUCT@+$(VRA_PRODUCT)+g' \
		-e 's+@VRA_C_YEAR@+$(VRA_C_YEAR)+g' \
		$< > $@

 $$(VirtualAgent.app_0_OUTDIR)/qt.conf: $(PATH_SUB_CURRENT)/Makefile.kmk $(VRA_VERSION_MK) | $$(@D)/
	$(QUIET)$(RM) -f $@
	$(QUIET)$(APPEND) $@ "[Paths]"
 ifdef VRA_WITH_HARDENING # Not necessary and will screwup copying files elsewhere to test.
	$(QUIET)$(APPEND) $@ "Prefix =" $(PATH_OUT)/$(VirtualAgent.app_INST)
 endif

 INSTALLS += VirtualAgentVM.app
 VirtualAgentVM.app_INST = $(VirtualAgent.app_INST)Resources/VirtualAgentVM.app/Contents/
 VirtualAgentVM.app_MODE = 644
 VirtualAgentVM.app_SOURCES = \
 	src/platform/darwin/VM-PkgInfo=>PkgInfo \
 	$(VirtualAgentVM.app_0_OUTDIR)/VM-Info.plist=>Info.plist \
 	$(foreach mysrc,$(VirtualAgent.app_SOURCES),$(if-expr $(pos =>Resources/,$(mysrc)) > 0,$(mysrc),))
 ifdef VRA_WITH_INTNET_SERVICE_IN_R3
  VirtualAgentVM.app_SYMLINKS = \
  	XPCServices=>../../../XPCServices
 endif

 $$(VirtualAgentVM.app_0_OUTDIR)/VM-Info.plist: $(PATH_SUB_CURRENT)/src/platform/darwin/VM-Info.plist $(VRA_VERSION_MK) | $$(@D)/
	$(call MSG_GENERATE,VirtualAgentVM.app,$<,$@)
	$(QUIET)$(RM) -f $@
	$(QUIET)$(SED) \
		-e 's+@VRA_VERSION_STRING@+$(VRA_VERSION_STRING)+g' \
		-e 's+@VRA_VERSION_MAJOR@+$(VRA_VERSION_MAJOR)+g' \
		-e 's+@VRA_VERSION_MINOR@+$(VRA_VERSION_MINOR)+g' \
		-e 's+@VRA_VERSION_BUILD@+$(VRA_VERSION_BUILD)+g' \
		-e 's+@VRA_VENDOR@+$(VRA_VENDOR)+g' \
		-e 's+@VRA_PRODUCT@+$(VRA_PRODUCT)+g' \
		-e 's+@VRA_C_YEAR@+$(VRA_C_YEAR)+g' \
		--output $@ $<

 PROGRAMS += vmstarter
 vmstarter_TEMPLATE = VBoxR3Exe
 vmstarter_OBJCXXFLAGS += -Wno-error=deprecated-declarations ## @todo fix deprecate API use!
 vmstarter_LDFLAGS += -framework AppKit
 vmstarter_SOURCES = src/platform/darwin/vmstarter.mm
 vmstarter_INST = $(INST_BIN)vmstarter

 INSTALLS += vmstarter.app
 vmstarter.app_INST = $(VirtualAgent.app_INST)Resources/vmstarter.app/Contents/
 vmstarter.app_MODE = 644
 vmstarter.app_SOURCES = \
 	src/platform/darwin/vmstarter-PkgInfo=>PkgInfo \
 	$(vmstarter.app_0_OUTDIR)/vmstarter-Info.plist=>Info.plist \
 	$(foreach mysrc,$(VirtualAgent.app_SOURCES),$(if-expr $(pos =>Resources/,$(mysrc)) > 0,$(mysrc),))
 vmstarter.app_SYMLINKS = \
 	MacOS=>../../../MacOS

 $$(vmstarter.app_0_OUTDIR)/vmstarter-Info.plist: $(PATH_SUB_CURRENT)/src/platform/darwin/vmstarter-Info.plist $(VRA_VERSION_MK) | $$(@D)/
	$(call MSG_GENERATE,vmstarter.app,$<,$@)
	$(QUIET)$(RM) -f $@
	$(QUIET)$(SED) \
		-e 's+@VRA_VERSION_STRING@+$(VRA_VERSION_STRING)+g' \
		-e 's+@VRA_VERSION_MAJOR@+$(VRA_VERSION_MAJOR)+g' \
		-e 's+@VRA_VERSION_MINOR@+$(VRA_VERSION_MINOR)+g' \
		-e 's+@VRA_VERSION_BUILD@+$(VRA_VERSION_BUILD)+g' \
		-e 's+@VRA_VENDOR@+$(VRA_VENDOR)+g' \
		-e 's+@VRA_PRODUCT@+$(VRA_PRODUCT)+g' \
		-e 's+@VRA_C_YEAR@+$(VRA_C_YEAR)+g' \
		--output $@ $<
endif # darwin



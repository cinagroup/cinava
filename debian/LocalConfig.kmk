# don't build testcases to save time, they are not needed for the package
VRA_WITH_TESTCASES        :=
VRA_WITH_VALIDATIONKIT    :=

# required for VRA_WITH_RUNPATH
VRA_WITH_ORIGIN           :=

VRA_DOCBOOK_WITH_LATEX    := 1
KBUILD_MSG_STYLE           := brief
VRA_PATH_APP_PRIVATE_ARCH := /usr/lib/virtualbox
VRA_PATH_SHARED_LIBS      := $(VRA_PATH_APP_PRIVATE_ARCH)
VRA_WITH_RUNPATH          := $(VRA_PATH_APP_PRIVATE_ARCH)
VRA_PATH_APP_PRIVATE      := /usr/share/virtualbox
VRA_PATH_APP_DOCS          = $(VRA_PATH_PACKAGE_DOCS)
VRA_WITH_VRA_IMG         := 1

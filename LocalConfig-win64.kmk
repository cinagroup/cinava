# Windows x86_64 交叉编译配置 - CINA VirtualAgent v7.2.98

# 目标平台
KBUILD_TARGET := win
KBUILD_TARGET_ARCH := amd64

# 交叉编译工具链 (MinGW-w64)
TOOL_WIN64CC := x86_64-w64-mingw32-gcc
TOOL_WIN64CXX := x86_64-w64-mingw32-g++
TOOL_WIN64AS := x86_64-w64-mingw32-as
TOOL_WIN64LD := x86_64-w64-mingw32-ld
TOOL_WIN64AR := x86_64-w64-mingw32-ar
TOOL_WIN64DLLTOOL := x86_64-w64-mingw32-dlltool
TOOL_WIN64RC := x86_64-w64-mingw32-windres
TOOL_WIN64STRIP := x86_64-w64-mingw32-strip

# 品牌配置
VBOX_PRODUCT := CINA VirtualAgent
VBOX_VENDOR := CINASEEK
VBOX_VERSION_STRING := 7.2.98
VRA_PRODUCT := CINA VirtualAgent
VRA_VENDOR := CINASEEK
VRA_VERSION_STRING := 7.2.98

# VRA/VirtualBox 兼容性
VBOX := 1
DEFS += VBOX
DEFS += VBOX_VERSION_MAJOR=VRA_VERSION_MAJOR
DEFS += VBOX_VERSION_MINOR=VRA_VERSION_MINOR
DEFS += VBOX_VERSION_BUILD=VRA_VERSION_BUILD

# 版本配置
IPRT_BLDCFG_SCM_REV := 0
VBOX_SVN_REV := 0
VBOX_SVN_REV_FALLBACK := 0
VRA_SVN_REV := 0

# 禁用硬编码加固 (开发环境)
VBOX_WITHOUT_HARDENING := 1
VBOX_WITH_HARDENING :=
VRA_WITH_HARDENING :=
VRA_WITHOUT_HARDENING := 1

# 禁用 Werror (允许警告)
TOOL_GCC3_CFLAGS += -Wno-error
TOOL_GCC3_CXXFLAGS += -Wno-error

# 禁用 GUI (Windows 交叉编译先编译核心功能)
VRA_WITH_QTGUI :=
VBOX_WITH_QTGUI :=
VRA_WITH_QT :=
VBOX_WITH_QT :=
VBOX_WITH_QT6 :=

# 禁用 DTrace
VRA_WITH_DTRACE :=
VBOX_WITH_DTRACE :=

# 禁用测试用例
VRA_WITH_TESTCASES :=
VBOX_WITH_TESTCASES :=

# 禁用 libssh
VRA_WITH_LIBSSH :=
VBOX_WITH_LIBSSH :=

# 禁用 libtpms
VRA_WITH_LIBTPMS :=

# COM 配置 (Windows 使用 COM)
VBOX_WITH_COM := 1
VRA_WITH_COM := 1
VRA_WITH_XPCOM :=
VBOX_WITH_XPCOM :=

# 禁用 C API 绑定
VBOX_WITH_CAPI :=
VRA_WITH_CAPI :=

# 禁用 SharedClipboard Transfers
VRA_WITH_SHARED_CLIPBOARD_TRANSFERS :=
VBOX_WITH_SHARED_CLIPBOARD_TRANSFERS :=

# 禁用旧版 X11 视频驱动
VRA_WITH_X11_ADDITIONS :=
VBOX_WITH_X11_ADDITIONS :=

# 硬件虚拟化支持
VBOX_WITH_HWVIRT := 1
VRA_WITH_HWVIRT := 1

# Guest Control Toolbox
VBOX_WITH_GSTCTL_TOOLBOX_AS_CMDS := 1

# IEM 宏定义
IEM_MAX_MEM_MAPPINGS := 3
IEM_BOUNCE_BUFFER_SIZE := 4096
PGM_GUEST_MODE_DATA_ARRAY_SIZE := 7

# Windows SDK 路径 (使用 Wine 头文件)
VBOX_PATH_WIN_SDK ?= /usr/x86_64-w64-mingw32

# 禁用 Web Services
VRA_WITH_WEBSERVICES :=
VBOX_WITH_WEBSERVICES :=

# 禁用 Documentation
VRA_WITH_DOCS :=
VBOX_WITH_DOCS :=

# 禁用代码签名工具 (避免 OpenSSL 依赖)
IPRT_SIGNTOOL_NO_SIGNING := 1
VRA_WITH_BLD_RTSIGNTOOL_SIGNING :=

# 禁用 OpenSSL 依赖
VRA_WITH_OPENSSL :=
VBOX_WITH_OPENSSL :=
